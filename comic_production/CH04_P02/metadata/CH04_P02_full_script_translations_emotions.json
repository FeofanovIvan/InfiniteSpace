    {
      "line_id": "CH04_P02_L006",
      "frame_id": "CH04_P02_F01",
      "character_id": "CHR_001",
      "speaker_ru": "Мика",
      "kind": "inner_monologue",
      "emotion_ru": "уныло, тихая мысль",
      "tts_required": true,
      "tts_tag": "[quietly despondent]",
      "translations": {
        "ru": "Я никогда не попаду домой…",
        "en": "I'll never get home…",
        "pt_BR": "Nunca vou conseguir voltar para casa…",
        "es": "Nunca conseguiré volver a casa…",
        "fr": "Je ne rentrerai jamais chez moi…",
        "de": "Ich werde nie nach Hause kommen…"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Я никогда не попаду домой…"
      ]
    },
    {
      "line_id": "CH04_P02_L007",
      "frame_id": "CH04_P02_F02",
      "character_id": "CHR_004",
      "speaker_ru": "Автор",
      "kind": "narration",
      "emotion_ru": "сдержанный рассказ о заточении",
      "tts_required": true,
      "tts_tag": "[serious narration]",
      "translations": {
        "ru": "Всех перевезли на пиратскую станцию «Голова Титана» и оставили под охраной.",
        "en": "They took everyone to the pirate station Titan's Head and kept them under guard.",
        "pt_BR": "Todos foram levados à estação pirata Cabeça do Titã e ficaram sob vigilância.",
        "es": "Los llevaron a la estación pirata Cabeza del Titán y los dejaron vigilados.",
        "fr": "On les emmena sur la station pirate Tête du Titan, où ils furent placés sous garde.",
        "de": "Sie brachten alle zur Piratenstation Titanenkopf und hielten sie dort gefangen."
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Всех перевезли на пиратскую станцию «Голова Титана» и оставили под охраной."
      ]
    },
    {
      "line_id": "CH04_P02_L008",
      "frame_id": "CH04_P02_F02",
      "character_id": "CHR_001",
      "speaker_ru": "Мика",
      "kind": "dialogue",
      "emotion_ru": "тревога и надежда",
      "tts_required": true,
      "tts_tag": "[worried]",
      "translations": {
        "ru": "Что же будем делать?",
        "en": "What do we do now?",
        "pt_BR": "E agora? O que fazemos?",
        "es": "¿Y ahora qué hacemos?",
        "fr": "Qu'est-ce qu'on va faire ?",
        "de": "Was machen wir jetzt?"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Что же будем делать?"
      ]
    },
    {
      "line_id": "CH04_P02_L009",
      "frame_id": "CH04_P02_F02",
      "character_id": "CHR_015",
      "speaker_ru": "Профессор",
      "kind": "dialogue",
      "emotion_ru": "растерянно, обдумывая план",
      "tts_required": true,
      "tts_tag": "[thinking aloud]",
      "translations": {
        "ru": "Надо что-то придумать…",
        "en": "We need a plan…",
        "pt_BR": "Precisamos pensar em algo…",
        "es": "Tenemos que pensar algo…",
        "fr": "Il faut trouver une idée…",
        "de": "Uns muss etwas einfallen…"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Надо что-то придумать…"
      ]
    },
    {
      "line_id": "CH04_P02_L010",
      "frame_id": "CH04_P02_F03",
      "character_id": "CHR_031",
      "speaker_ru": "Ящер-пират",
      "kind": "dialogue",
      "emotion_ru": "насмешливо-вежливо, с улыбкой",
      "tts_required": true,
      "tts_tag": "[teasing]",
      "translations": {
        "ru": "Ну как, вам здесь удобно?",
        "en": "Well, is your room comfortable?",
        "pt_BR": "Então, estão bem acomodados?",
        "es": "Bueno, ¿estáis cómodos?",
        "fr": "Alors, vous êtes bien installés ?",
        "de": "Na, habt ihr es hier bequem?"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Ну как, вам здесь удобно?"
      ]
    },
    {
      "line_id": "CH04_P02_L011",
      "frame_id": "CH04_P02_F03",
      "character_id": "CHR_001",
      "speaker_ru": "Мика",
      "kind": "dialogue",
      "emotion_ru": "с вызовом, узнавание",
      "tts_required": true,
      "tts_tag": "[defiant]",
      "translations": {
        "ru": "Ты такой же, как тот из Малого Магелланова Облака!",
        "en": "You're just like that one from the Small Magellanic Cloud!",
        "pt_BR": "Você é igual àquele lá da Pequena Nuvem de Magalhães!",
        "es": "¡Eres igual que aquel de la Pequeña Nube de Magallanes!",
        "fr": "Tu es comme celui du Petit Nuage de Magellan !",
        "de": "Du bist genau wie der aus der Kleinen Magellanschen Wolke!"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Ты такой же, как тот из Малого Магелланова Облака!"
      ]
    },
    {
      "line_id": "CH04_P02_L012",
      "frame_id": "CH04_P02_F04",
      "character_id": "CHR_031",
      "speaker_ru": "Ящер-пират",
      "kind": "dialogue",
      "emotion_ru": "внезапное узнавание, затем тревожное любопытство",
      "tts_required": true,
      "tts_tag": "[suddenly alarmed]",
      "translations": {
        "ru": "Саргон?! Что с ним случилось? Он говорил, что у него есть план, как разбогатеть!",
        "en": "Sargon?! What happened to him? He said he had a plan to get rich!",
        "pt_BR": "Sargon?! O que aconteceu com ele? Ele disse que tinha um plano para ficar rico!",
        "es": "¿Sargon?! ¿Qué le ha pasado? ¡Decía que tenía un plan para hacerse rico!",
        "fr": "Sargon ?! Qu'est-ce qui lui est arrivé ? Il disait avoir un plan pour devenir riche !",
        "de": "Sargon?! Was ist mit ihm passiert? Er sagte, er hätte einen Plan, reich zu werden!"
      },
      "visual_parts": [
        "a",
        "b"
      ],
      "original_ru_visual_text": [
        "Саргон?! Что с ним случилось?",
        "Он говорил, что у него есть план, как разбогатеть!"
      ]
    },
    {
      "line_id": "CH04_P02_L013",
      "frame_id": "CH04_P02_F05",
      "character_id": "CHR_029",
      "speaker_ru": "Фазовый принц",
      "kind": "nonverbal_sfx",
      "emotion_ru": "непереводимое фазовое бульканье",
      "tts_required": false,
      "tts_tag": null,
      "translations": {
        "ru": "Шу-у… Буль…",
        "en": "Шу-у… Буль…",
        "pt_BR": "Шу-у… Буль…",
        "es": "Шу-у… Буль…",
        "fr": "Шу-у… Буль…",
        "de": "Шу-у… Буль…"
      },
      "visual_parts": [
