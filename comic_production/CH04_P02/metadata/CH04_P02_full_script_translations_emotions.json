      ]
    },
    {
      "line_id": "CH04_P02_L015",
      "frame_id": "CH04_P02_F05",
      "character_id": "CHR_001",
      "speaker_ru": "Мика (переводит)",
      "kind": "interpreted_dialogue",
      "emotion_ru": "уверенный перевод слов спутника",
      "tts_required": true,
      "tts_tag": "[clear, reassuring]",
      "translations": {
        "ru": "Наш друг говорит: Саргон сейчас под стражей. Если ты поможешь нам выбраться, он попробует договориться, чтобы Саргона отпустили.",
        "en": "Our friend says Sargon is being held prisoner. Help us escape, and he'll try to arrange Sargon's release.",
        "pt_BR": "Nosso amigo diz que Sargon está detido. Se você nos ajudar a fugir, ele vai tentar conseguir a libertação dele.",
        "es": "Nuestro amigo dice que Sargon está detenido. Si nos ayudas a escapar, intentará conseguir que lo liberen.",
        "fr": "Notre ami dit que Sargon est retenu prisonnier. Si tu nous aides à fuir, il tentera d'obtenir sa libération.",
        "de": "Unser Freund sagt, Sargon wird festgehalten. Hilfst du uns bei der Flucht, versucht er, Sargons Freilassung zu erreichen."
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Наш друг говорит: Саргон сейчас под стражей. Если ты поможешь нам выбраться, он попробует договориться, чтобы Саргона отпустили."
      ]
    },
    {
      "line_id": "CH04_P02_L014",
      "frame_id": "CH04_P02_F05",
      "character_id": "CHR_031",
      "speaker_ru": "Ящер-пират",
      "kind": "dialogue",
      "emotion_ru": "быстрое согласие, комедийный аппетит",
      "tts_required": true,
      "tts_tag": "[cheerful, hungry]",
      "translations": {
        "ru": "Я согласен. Но сначала надо перекусить!",
        "en": "Agreed! But first, I need a bite to eat!",
        "pt_BR": "Combinado! Mas primeiro preciso comer alguma coisa!",
        "es": "¡Trato hecho! ¡Pero antes necesito comer algo!",
        "fr": "D'accord ! Mais d'abord, il faut que je mange !",
        "de": "Einverstanden! Aber zuerst muss ich etwas essen!"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Я согласен. Но сначала надо перекусить!"
      ]
    },
    {
      "line_id": "CH04_P02_L016",
      "frame_id": "CH04_P02_F06",
      "character_id": "CHR_004",
      "speaker_ru": "Автор",
      "kind": "narration",
      "emotion_ru": "облегчение и приключенческий подъём",
      "tts_required": true,
      "tts_tag": "[relieved narration]",
      "translations": {
        "ru": "После небольшого перекуса ящер помог нашим друзьям сбежать из заточения. Вскоре вся компания добралась до звездолёта.",
        "en": "After a quick bite, the lizard helped our friends escape. Soon the whole group reached their starship.",
        "pt_BR": "Depois de um lanchinho, o lagarto ajudou nossos amigos a escapar. Logo, todos chegaram à nave.",
        "es": "Tras un pequeño tentempié, el lagarto ayudó a escapar a nuestros amigos. Pronto todos llegaron a su nave.",
        "fr": "Après une petite pause pour manger, le lézard aida nos amis à s'évader. Bientôt, ils rejoignirent leur vaisseau.",
        "de": "Nach einem kleinen Imbiss half die Echse unseren Freunden bei der Flucht. Bald erreichten alle ihr Raumschiff."
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "После небольшого перекуса ящер помог нашим друзьям сбежать из заточения. Вскоре вся компания добралась до звездолёта."
      ]
    }
  ],
