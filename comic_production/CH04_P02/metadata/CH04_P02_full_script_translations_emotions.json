  "lines": [
    {
      "line_id": "CH04_P02_L001",
      "frame_id": "CH04_P02_F01",
      "character_id": "CHR_004",
      "speaker_ru": "Автор",
      "kind": "narration",
      "emotion_ru": "деловито, с лёгкой иронией",
      "tts_required": true,
      "tts_tag": "[matter-of-fact, faintly amused]",
      "translations": {
        "ru": "В корабль ворвались рослые ящеры. Настойчиво, но весьма вежливо они предложили всей компании пройти в клетку.",
        "en": "Tall, lizard-like strangers burst onto the ship. Firm but surprisingly polite, they ushered everyone into a cage.",
        "pt_BR": "Grandes criaturas parecidas com lagartos invadiram a nave. Com firmeza, mas até com educação, levaram todos até uma cela.",
        "es": "Unos enormes seres parecidos a lagartos irrumpieron en la nave. Con firmeza, pero bastante educación, llevaron a todos hasta una celda.",
        "fr": "De grands lézards ont fait irruption dans le vaisseau. Avec insistance, mais plutôt poliment, ils ont conduit tout le monde dans une cage.",
        "de": "Große echsenartige Wesen stürmten das Schiff. Bestimmt, aber erstaunlich höflich, führten sie alle in einen Käfig."
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "В корабль ворвались рослые ящеры. Настойчиво, но весьма вежливо они предложили всей компании пройти в клетку."
      ]
    },
    {
      "line_id": "CH04_P02_L002",
      "frame_id": "CH04_P02_F01",
      "character_id": "CHR_031",
      "speaker_ru": "Ящер-пират",
      "kind": "dialogue",
      "emotion_ru": "подчёркнутая вежливость, настойчиво",
      "tts_required": true,
      "tts_tag": "[polite but firm]",
      "translations": {
        "ru": "Прошу.",
        "en": "After you.",
        "pt_BR": "Por favor, entrem.",
        "es": "Adelante.",
        "fr": "Je vous en prie.",
        "de": "Bitte sehr."
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Прошу."
      ]
    },
    {
      "line_id": "CH04_P02_L003",
      "frame_id": "CH04_P02_F01",
      "character_id": "CHR_015",
      "speaker_ru": "Профессор",
      "kind": "dialogue",
      "emotion_ru": "испуг и растерянность",
      "tts_required": true,
      "tts_tag": "[frightened]",
      "translations": {
        "ru": "Что с нами будет?!",
        "en": "What will happen to us?!",
        "pt_BR": "O que vai acontecer com a gente?!",
        "es": "¿Qué va a ser de nosotros?!",
        "fr": "Que va-t-il nous arriver ?!",
        "de": "Was wird jetzt aus uns?!"
      },
      "visual_parts": [
        "whole"
      ],
      "original_ru_visual_text": [
        "Что с нами будет?!"
      ]
    },
