  "clips": [
    {
      "file": "ru/CH04_P02_L001_ru.mp3",
      "line_id": "CH04_P02_L001",
      "language": "ru",
      "frame_id": "CH04_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "В корабль ворвались рослые ящеры. Настойчиво, но весьма вежливо они предложили всей компании пройти в клетку.",
      "emotion_tag": "[dryly]",
      "duration_ms": 7840,
      "sha256": "8c58204fb8de76850843eea8f746186d261198a856f443bbf92e69be98eb07be"
    },
    {
      "file": "ru/CH04_P02_L002_ru.mp3",
      "line_id": "CH04_P02_L002",
      "language": "ru",
      "frame_id": "CH04_P02_F01",
      "reading_order": 2,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Прошу.",
      "emotion_tag": "[politely]",
      "duration_ms": 960,
      "sha256": "ab6417caadc0b136f025e04105bec706288bd5c34c78e189c8dc0f64a36ebaaa"
    },
    {
      "file": "ru/CH04_P02_L003_ru.mp3",
      "line_id": "CH04_P02_L003",
      "language": "ru",
      "frame_id": "CH04_P02_F01",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Что с нами будет?!",
      "emotion_tag": "[frightened]",
      "duration_ms": 1760,
      "sha256": "b91d15a739ba35ba44bf8d2a00fff6c15123ace82402eea3489cefc972953331"
    },
    {
      "file": "ru/CH04_P02_L006_ru.mp3",
      "line_id": "CH04_P02_L006",
      "language": "ru",
      "frame_id": "CH04_P02_F01",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "inner_monologue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Я никогда не попаду домой…",
      "emotion_tag": "[sadly]",
      "duration_ms": 2400,
      "sha256": "55cca2643d53978cde0f1fa328000d389d73bfd563bbf53009ab3b741ddd0e81"
    },
    {
      "file": "ru/CH04_P02_L007_ru.mp3",
      "line_id": "CH04_P02_L007",
      "language": "ru",
      "frame_id": "CH04_P02_F02",
      "reading_order": 7,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Всех перевезли на пиратскую станцию «Голова Титана» и оставили под охраной.",
      "emotion_tag": "[seriously]",
      "duration_ms": 4880,
      "sha256": "da33ea8be3cccfa79c83a305e4059446b48098c4885932aefa11ba73034e2533"
    },
    {
      "file": "ru/CH04_P02_L008_ru.mp3",
      "line_id": "CH04_P02_L008",
      "language": "ru",
      "frame_id": "CH04_P02_F02",
      "reading_order": 8,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Что же будем делать?",
      "emotion_tag": "[anxiously]",
      "duration_ms": 1920,
      "sha256": "2999d58915c066a6ff3299a655597fcd9944f18c1b6d305a95f546f0932c778c"
    },
    {
      "file": "ru/CH04_P02_L009_ru.mp3",
      "line_id": "CH04_P02_L009",
      "language": "ru",
      "frame_id": "CH04_P02_F02",
      "reading_order": 9,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Надо что-то придумать…",
      "emotion_tag": "[thinking aloud]",
      "duration_ms": 2080,
      "sha256": "49a440cfe44f7b7b121380a779eb53adaf5f5a3888027fd4bee65b0f469bbd4f"
    },
    {
      "file": "ru/CH04_P02_L010_ru.mp3",
      "line_id": "CH04_P02_L010",
      "language": "ru",
      "frame_id": "CH04_P02_F03",
      "reading_order": 10,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Ну как, вам здесь удобно?",
      "emotion_tag": "[teasing]",
      "duration_ms": 2160,
      "sha256": "a5d03cbdbbed5989ec3078003fa65a224b27424cb1b442b8e3404e98d6a67f63"
    },
    {
      "file": "ru/CH04_P02_L011_ru.mp3",
      "line_id": "CH04_P02_L011",
      "language": "ru",
      "frame_id": "CH04_P02_F03",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Ты такой же, как тот из Малого Магелланова Облака!",
      "emotion_tag": "[surprised]",
      "duration_ms": 3280,
      "sha256": "5b64c58912769b9a235081303f5deeeb528a191b9a45dada33204d9f17c4fb23"
    },
    {
      "file": "ru/CH04_P02_L012_ru.mp3",
      "line_id": "CH04_P02_L012",
      "language": "ru",
      "frame_id": "CH04_P02_F04",
      "reading_order": 12,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Саргон?! Что с ним случилось? Он говорил, что у него есть план, как разбогатеть!",
      "emotion_tag": "[shocked]",
      "duration_ms": 5280,
      "sha256": "2206fa089d9be2a0657a9bca8335df7348a6fc03e00058ae3a7c0c4c67c672eb"
    },
    {
      "file": "ru/CH04_P02_L015_ru.mp3",
      "line_id": "CH04_P02_L015",
      "language": "ru",
      "frame_id": "CH04_P02_F05",
      "reading_order": 14,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "interpreted_dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Наш друг говорит: Саргон сейчас под стражей. Если ты поможешь нам выбраться, он попробует договориться, чтобы Саргона отпустили.",
      "emotion_tag": "[confidently]",
      "duration_ms": 8320,
      "sha256": "fbb8330e0f1934f456dc675d12422adf281ca2763d646e4d15693f6482c3b711"
    },
    {
      "file": "ru/CH04_P02_L014_ru.mp3",
      "line_id": "CH04_P02_L014",
      "language": "ru",
      "frame_id": "CH04_P02_F05",
      "reading_order": 15,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Я согласен. Но сначала надо перекусить!",
      "emotion_tag": "[cheerfully]",
      "duration_ms": 3520,
      "sha256": "8e1b6300836319af7bfad0fec8d0185ec71397d15cb26189f985bc8249b7b30f"
    },
    {
      "file": "ru/CH04_P02_L016_ru.mp3",
      "line_id": "CH04_P02_L016",
      "language": "ru",
      "frame_id": "CH04_P02_F06",
      "reading_order": 16,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "После небольшого перекуса ящер помог нашим друзьям сбежать из заточения. Вскоре вся компания добралась до звездолёта.",
      "emotion_tag": "[with relief]",
      "duration_ms": 7760,
      "sha256": "ec5d02801dec17dc2593931550e032b391f31982797f221d3f90e4742f6d34db"
    },
    {
      "file": "en/CH04_P02_L001_en.mp3",
      "line_id": "CH04_P02_L001",
      "language": "en",
      "frame_id": "CH04_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Tall, lizard-like strangers burst onto the ship. Firm but surprisingly polite, they ushered everyone into a cage.",
      "emotion_tag": "[dryly]",
      "duration_ms": 8240,
      "sha256": "1cdc4aa5089fe93a342350f6ee83e1625c6158a8456aa32f5c43b97d95bcb0b4"
    },
    {
      "file": "en/CH04_P02_L002_en.mp3",
      "line_id": "CH04_P02_L002",
      "language": "en",
      "frame_id": "CH04_P02_F01",
      "reading_order": 2,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "After you.",
      "emotion_tag": "[politely]",
      "duration_ms": 1200,
      "sha256": "3e8d85114ea5a90b8fc58b8492533837929ae7f7c8ffde6f817a6b7c65df391e"
    },
    {
      "file": "en/CH04_P02_L003_en.mp3",
      "line_id": "CH04_P02_L003",
      "language": "en",
      "frame_id": "CH04_P02_F01",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "What will happen to us?!",
      "emotion_tag": "[frightened]",
      "duration_ms": 1840,
      "sha256": "64c453c2a7301d6fe2eeb9be088532f90e87c2d3871d2f38c4b1a874d57f6362"
    },
    {
      "file": "en/CH04_P02_L006_en.mp3",
      "line_id": "CH04_P02_L006",
      "language": "en",
      "frame_id": "CH04_P02_F01",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "inner_monologue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "I'll never get home…",
      "emotion_tag": "[sadly]",
      "duration_ms": 1920,
      "sha256": "5878404d54b30eec25c29ada67f713001953fcbfe73ded663fca79fcc91369d8"
    },
    {
      "file": "en/CH04_P02_L007_en.mp3",
      "line_id": "CH04_P02_L007",
      "language": "en",
      "frame_id": "CH04_P02_F02",
      "reading_order": 7,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "They took everyone to the pirate station Titan's Head and kept them under guard.",
      "emotion_tag": "[seriously]",
      "duration_ms": 4800,
      "sha256": "9db7f6d5c8a2ea30cf9635ac4b1502630414367115a39f29a859926c8fc89037"
    },
    {
      "file": "en/CH04_P02_L008_en.mp3",
      "line_id": "CH04_P02_L008",
      "language": "en",
      "frame_id": "CH04_P02_F02",
      "reading_order": 8,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "What do we do now?",
      "emotion_tag": "[anxiously]",
      "duration_ms": 1760,
      "sha256": "afea559b0013acee6f60c22ef890c61c0bef29ce4a4c344716bf13347c0444c2"
    },
    {
      "file": "en/CH04_P02_L009_en.mp3",
      "line_id": "CH04_P02_L009",
      "language": "en",
      "frame_id": "CH04_P02_F02",
      "reading_order": 9,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "We need a plan…",
      "emotion_tag": "[thinking aloud]",
      "duration_ms": 1760,
      "sha256": "c3164cd01250faf8308d6d29cfc6ebee17a77ae1256a63d5d797fb61482183e2"
    },
    {
      "file": "en/CH04_P02_L010_en.mp3",
      "line_id": "CH04_P02_L010",
      "language": "en",
      "frame_id": "CH04_P02_F03",
      "reading_order": 10,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Well, is your room comfortable?",
      "emotion_tag": "[teasing]",
      "duration_ms": 2320,
      "sha256": "c2e74b5cf8e8a9463231adcd931cb458eab20e3916b50639da43a100062b2e8e"
    },
    {
      "file": "en/CH04_P02_L011_en.mp3",
      "line_id": "CH04_P02_L011",
      "language": "en",
      "frame_id": "CH04_P02_F03",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "You're just like that one from the Small Magellanic Cloud!",
      "emotion_tag": "[surprised]",
      "duration_ms": 3280,
      "sha256": "88f225b8889d9478f6383f87291fb458066839cee8e67d5ebe2081ea436bcdb0"
    },
    {
      "file": "en/CH04_P02_L012_en.mp3",
      "line_id": "CH04_P02_L012",
      "language": "en",
      "frame_id": "CH04_P02_F04",
      "reading_order": 12,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Sargon?! What happened to him? He said he had a plan to get rich!",
      "emotion_tag": "[shocked]",
      "duration_ms": 4560,
      "sha256": "14f12712661e676eae14f9eb45473fb85e22efd64364c1c0ace1e22a9c9c84b5"
    },
    {
      "file": "en/CH04_P02_L015_en.mp3",
      "line_id": "CH04_P02_L015",
      "language": "en",
      "frame_id": "CH04_P02_F05",
      "reading_order": 14,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "interpreted_dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Our friend says Sargon is being held prisoner. Help us escape, and he'll try to arrange Sargon's release.",
      "emotion_tag": "[confidently]",
      "duration_ms": 6240,
      "sha256": "d06e7a92ef5a5fe11582a4c78adfe529fc9f0faf830b39bb7774d79518d634fa"
    },
    {
      "file": "en/CH04_P02_L014_en.mp3",
      "line_id": "CH04_P02_L014",
      "language": "en",
      "frame_id": "CH04_P02_F05",
      "reading_order": 15,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Agreed! But first, I need a bite to eat!",
      "emotion_tag": "[cheerfully]",
      "duration_ms": 3440,
      "sha256": "b9b1d6df0cdbf61ae8ad9d28f9052433b9b821bafc3b3e30128fc6024d44b199"
    },
    {
      "file": "en/CH04_P02_L016_en.mp3",
      "line_id": "CH04_P02_L016",
      "language": "en",
      "frame_id": "CH04_P02_F06",
      "reading_order": 16,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "After a quick bite, the lizard helped our friends escape. Soon the whole group reached their starship.",
      "emotion_tag": "[with relief]",
      "duration_ms": 6400,
      "sha256": "f0336415cfea1b87fbf98558e825316487957fad9caa126bb3a51734ee8f61c7"
    },
    {
      "file": "pt_BR/CH04_P02_L001_pt_BR.mp3",
      "line_id": "CH04_P02_L001",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Grandes criaturas parecidas com lagartos invadiram a nave. Com firmeza, mas até com educação, levaram todos até uma cela.",
      "emotion_tag": "[dryly]",
      "duration_ms": 8800,
      "sha256": "055b717d0a5b63963f210abf0c1d66e532d959578457da2e2f37132518e844bd"
    },
    {
      "file": "pt_BR/CH04_P02_L002_pt_BR.mp3",
      "line_id": "CH04_P02_L002",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F01",
      "reading_order": 2,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Por favor, entrem.",
      "emotion_tag": "[politely]",
      "duration_ms": 1760,
      "sha256": "687f60abd2761ef4698bbfd203be46e9f61d167f03e007a694d87d6f614df08b"
    },
    {
      "file": "pt_BR/CH04_P02_L003_pt_BR.mp3",
      "line_id": "CH04_P02_L003",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F01",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "O que vai acontecer com a gente?!",
      "emotion_tag": "[frightened]",
      "duration_ms": 2160,
      "sha256": "5745e42d484b8a839d4dc32b430bea57987a2fcec0a5b79d1732058e6d3a1ba5"
    },
    {
      "file": "pt_BR/CH04_P02_L006_pt_BR.mp3",
      "line_id": "CH04_P02_L006",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F01",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "inner_monologue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Nunca vou conseguir voltar para casa…",
      "emotion_tag": "[sadly]",
      "duration_ms": 2720,
      "sha256": "1252486b86c7374c340c947d68b012ca9d9e865b7432f86e2de43bfa405cb815"
    },
    {
      "file": "pt_BR/CH04_P02_L007_pt_BR.mp3",
      "line_id": "CH04_P02_L007",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F02",
      "reading_order": 7,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Todos foram levados à estação pirata Cabeça do Titã e ficaram sob vigilância.",
      "emotion_tag": "[seriously]",
      "duration_ms": 5360,
      "sha256": "86fef3a56871b82184c7fab73c7f150a4d0d7024e42ad9398bdafa1494730eb0"
    },
    {
      "file": "pt_BR/CH04_P02_L008_pt_BR.mp3",
      "line_id": "CH04_P02_L008",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F02",
      "reading_order": 8,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "E agora? O que fazemos?",
      "emotion_tag": "[anxiously]",
      "duration_ms": 2560,
      "sha256": "8c931e68f953d15e7e7279b51c6bf73b731d8768a17f854fdebb2efbc7cadbc0"
    },
    {
      "file": "pt_BR/CH04_P02_L009_pt_BR.mp3",
      "line_id": "CH04_P02_L009",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F02",
      "reading_order": 9,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Precisamos pensar em algo…",
      "emotion_tag": "[thinking aloud]",
      "duration_ms": 2400,
      "sha256": "04d5b31ed64d17ca9ce175eed50c83a60062eaf89f99ef20a930aa103a684532"
    },
    {
      "file": "pt_BR/CH04_P02_L010_pt_BR.mp3",
      "line_id": "CH04_P02_L010",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F03",
      "reading_order": 10,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Então, estão bem acomodados?",
      "emotion_tag": "[teasing]",
      "duration_ms": 2320,
      "sha256": "4c29217cf14c2199cd03a3cf5baa601145594b7df6e9f3bed1e74099a1428268"
    },
    {
      "file": "pt_BR/CH04_P02_L011_pt_BR.mp3",
      "line_id": "CH04_P02_L011",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F03",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Você é igual àquele lá da Pequena Nuvem de Magalhães!",
      "emotion_tag": "[surprised]",
      "duration_ms": 3440,
      "sha256": "98f9ec1a2c5613ea2d1d5e43d464bc410e7582699b53093c090d38e9308acdc1"
    },
    {
      "file": "pt_BR/CH04_P02_L012_pt_BR.mp3",
      "line_id": "CH04_P02_L012",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F04",
      "reading_order": 12,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Sargon?! O que aconteceu com ele? Ele disse que tinha um plano para ficar rico!",
      "emotion_tag": "[shocked]",
      "duration_ms": 5120,
      "sha256": "158e2ea8105f90d7863cbd609fac828c26c8a01d71b3300fc1fef330c57c82bc"
    },
    {
      "file": "pt_BR/CH04_P02_L015_pt_BR.mp3",
      "line_id": "CH04_P02_L015",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F05",
      "reading_order": 14,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "interpreted_dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Nosso amigo diz que Sargon está detido. Se você nos ajudar a fugir, ele vai tentar conseguir a libertação dele.",
      "emotion_tag": "[confidently]",
      "duration_ms": 6960,
      "sha256": "897c3718257ccd088954d3f98b711a6de447a5eb5ae367db87491ba1742428ff"
    },
    {
      "file": "pt_BR/CH04_P02_L014_pt_BR.mp3",
      "line_id": "CH04_P02_L014",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F05",
      "reading_order": 15,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Combinado! Mas primeiro preciso comer alguma coisa!",
      "emotion_tag": "[cheerfully]",
      "duration_ms": 3520,
      "sha256": "072a0aedbc69b8355615996c75a63eff5bd01c53a124e0db453fbb917ceb105b"
    },
    {
      "file": "pt_BR/CH04_P02_L016_pt_BR.mp3",
      "line_id": "CH04_P02_L016",
      "language": "pt_BR",
      "frame_id": "CH04_P02_F06",
      "reading_order": 16,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Depois de um lanchinho, o lagarto ajudou nossos amigos a escapar. Logo, todos chegaram à nave.",
      "emotion_tag": "[with relief]",
      "duration_ms": 6720,
      "sha256": "6849c39020cd03669b98681ec374f361575bd4cfe65be0bd6b1404a6540a7763"
    },
    {
      "file": "es/CH04_P02_L001_es.mp3",
      "line_id": "CH04_P02_L001",
      "language": "es",
      "frame_id": "CH04_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Unos enormes seres parecidos a lagartos irrumpieron en la nave. Con firmeza, pero bastante educación, llevaron a todos hasta una celda.",
      "emotion_tag": "[dryly]",
      "duration_ms": 9200,
      "sha256": "5b8e1e38c129be1e636f2e78f432b447b08fd144da69b72bace3e873bcc271d5"
    },
    {
      "file": "es/CH04_P02_L002_es.mp3",
      "line_id": "CH04_P02_L002",
      "language": "es",
      "frame_id": "CH04_P02_F01",
      "reading_order": 2,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Adelante.",
      "emotion_tag": "[politely]",
      "duration_ms": 1120,
      "sha256": "94a5bfe60e9678f1888c1557b72e37f351dfdc58744dd261ecc2fc3ad2b73f13"
    },
    {
      "file": "es/CH04_P02_L003_es.mp3",
      "line_id": "CH04_P02_L003",
      "language": "es",
      "frame_id": "CH04_P02_F01",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "¿Qué va a ser de nosotros?!",
      "emotion_tag": "[frightened]",
      "duration_ms": 2000,
      "sha256": "0523124cc9d31d9eb924f687530fcfc13c19c6e91f01488ee59753e65a9e8915"
    },
    {
      "file": "es/CH04_P02_L006_es.mp3",
      "line_id": "CH04_P02_L006",
      "language": "es",
      "frame_id": "CH04_P02_F01",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "inner_monologue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Nunca conseguiré volver a casa…",
      "emotion_tag": "[sadly]",
      "duration_ms": 2400,
      "sha256": "7ada6992aef33fd5a37d813bbe7cc6d6d6c88d7ee04cdf568b2f5c44a1d33ccd"
    },
    {
      "file": "es/CH04_P02_L007_es.mp3",
      "line_id": "CH04_P02_L007",
      "language": "es",
      "frame_id": "CH04_P02_F02",
      "reading_order": 7,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Los llevaron a la estación pirata Cabeza del Titán y los dejaron vigilados.",
      "emotion_tag": "[seriously]",
      "duration_ms": 4720,
      "sha256": "52ca61d71d73d2abcdd5857b9134f4ef42fe3e1d475ad56045316a8a4bf95797"
    },
    {
      "file": "es/CH04_P02_L008_es.mp3",
      "line_id": "CH04_P02_L008",
      "language": "es",
      "frame_id": "CH04_P02_F02",
      "reading_order": 8,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¿Y ahora qué hacemos?",
      "emotion_tag": "[anxiously]",
      "duration_ms": 1760,
      "sha256": "31ce492badce21d9a458d399873416e9736624b2f90a76b12dae60d79c412a1f"
    },
    {
      "file": "es/CH04_P02_L009_es.mp3",
      "line_id": "CH04_P02_L009",
      "language": "es",
      "frame_id": "CH04_P02_F02",
      "reading_order": 9,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Tenemos que pensar algo…",
      "emotion_tag": "[thinking aloud]",
      "duration_ms": 2160,
      "sha256": "4b569f7c3cac28c85359a95e5b16b38ef560137412b9e6f8689ca74f2624b42a"
    },
    {
      "file": "es/CH04_P02_L010_es.mp3",
      "line_id": "CH04_P02_L010",
      "language": "es",
      "frame_id": "CH04_P02_F03",
      "reading_order": 10,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Bueno, ¿estáis cómodos?",
      "emotion_tag": "[teasing]",
      "duration_ms": 2240,
      "sha256": "28412880e2c273640afa3beba3b064b97ce8c96804fc26ad0f58807225b5deae"
    },
    {
      "file": "es/CH04_P02_L011_es.mp3",
      "line_id": "CH04_P02_L011",
      "language": "es",
      "frame_id": "CH04_P02_F03",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¡Eres igual que aquel de la Pequeña Nube de Magallanes!",
      "emotion_tag": "[surprised]",
      "duration_ms": 3040,
      "sha256": "ecf8ad415598b207ef01f6889d92d81cb00af62e1f70add82bffb82d1441f5c7"
    },
    {
      "file": "es/CH04_P02_L012_es.mp3",
      "line_id": "CH04_P02_L012",
      "language": "es",
      "frame_id": "CH04_P02_F04",
      "reading_order": 12,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "¿Sargon?! ¿Qué le ha pasado? ¡Decía que tenía un plan para hacerse rico!",
      "emotion_tag": "[shocked]",
      "duration_ms": 4800,
      "sha256": "ba18f1954e529762541c00b6c4289bbd088ddbe68d56d0a7cc2c02738ac164f0"
    },
    {
      "file": "es/CH04_P02_L015_es.mp3",
      "line_id": "CH04_P02_L015",
      "language": "es",
      "frame_id": "CH04_P02_F05",
      "reading_order": 14,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "interpreted_dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Nuestro amigo dice que Sargon está detenido. Si nos ayudas a escapar, intentará conseguir que lo liberen.",
      "emotion_tag": "[confidently]",
      "duration_ms": 6240,
      "sha256": "9a401b9bbc0b40310d51ef384f4a5f3bf9c65aa3f3097db0d70bbb3b966c0d57"
    },
    {
      "file": "es/CH04_P02_L014_es.mp3",
      "line_id": "CH04_P02_L014",
      "language": "es",
      "frame_id": "CH04_P02_F05",
      "reading_order": 15,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "¡Trato hecho! ¡Pero antes necesito comer algo!",
      "emotion_tag": "[cheerfully]",
      "duration_ms": 3120,
      "sha256": "1912de8b8f27c4c76c042450b5b12a355a10a00241c3b5140a698749725020f7"
    },
    {
      "file": "es/CH04_P02_L016_es.mp3",
      "line_id": "CH04_P02_L016",
      "language": "es",
      "frame_id": "CH04_P02_F06",
      "reading_order": 16,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Tras un pequeño tentempié, el lagarto ayudó a escapar a nuestros amigos. Pronto todos llegaron a su nave.",
      "emotion_tag": "[with relief]",
      "duration_ms": 6960,
      "sha256": "be33cd09411eaadb927744f28cdc17ec7cb7841191292751c216bd59fede86cc"
    },
    {
      "file": "fr/CH04_P02_L001_fr.mp3",
      "line_id": "CH04_P02_L001",
      "language": "fr",
      "frame_id": "CH04_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "De grands lézards ont fait irruption dans le vaisseau. Avec insistance, mais plutôt poliment, ils ont conduit tout le monde dans une cage.",
      "emotion_tag": "[dryly]",
      "duration_ms": 7920,
      "sha256": "03f0bb1100c60c3c0fcb0d5a9f5b16ff869267d6b5fff91d2b09735e463e83dd"
    },
    {
      "file": "fr/CH04_P02_L002_fr.mp3",
      "line_id": "CH04_P02_L002",
      "language": "fr",
      "frame_id": "CH04_P02_F01",
      "reading_order": 2,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Je vous en prie.",
      "emotion_tag": "[politely]",
      "duration_ms": 1280,
      "sha256": "da3662c3e569bf28f2adc73edb39eb085ce17c161e524ff1aeb9ed467816256c"
    },
    {
      "file": "fr/CH04_P02_L003_fr.mp3",
      "line_id": "CH04_P02_L003",
      "language": "fr",
      "frame_id": "CH04_P02_F01",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Que va-t-il nous arriver ?!",
      "emotion_tag": "[frightened]",
      "duration_ms": 1840,
      "sha256": "8b29e9c403d7a2bb10e8a012f255f5d7505ceea2d27103eceb5bc962aa782d1a"
    },
    {
      "file": "fr/CH04_P02_L006_fr.mp3",
      "line_id": "CH04_P02_L006",
      "language": "fr",
      "frame_id": "CH04_P02_F01",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "inner_monologue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Je ne rentrerai jamais chez moi…",
      "emotion_tag": "[sadly]",
      "duration_ms": 2640,
      "sha256": "8f452bea4e420973060400b95c9e5237f4f05c1509d819b28c3509254b8cc55e"
    },
    {
      "file": "fr/CH04_P02_L007_fr.mp3",
      "line_id": "CH04_P02_L007",
      "language": "fr",
      "frame_id": "CH04_P02_F02",
      "reading_order": 7,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "On les emmena sur la station pirate Tête du Titan, où ils furent placés sous garde.",
      "emotion_tag": "[seriously]",
      "duration_ms": 4640,
      "sha256": "503553cb07c8435cb7ccf0f91a9513d84c13074135bf4cc71720864b16ac808d"
    },
    {
      "file": "fr/CH04_P02_L008_fr.mp3",
      "line_id": "CH04_P02_L008",
      "language": "fr",
      "frame_id": "CH04_P02_F02",
      "reading_order": 8,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Qu'est-ce qu'on va faire ?",
      "emotion_tag": "[anxiously]",
      "duration_ms": 1520,
      "sha256": "d01d8e2f4fa54e7b4d1c66724bcd2b6c6ee50c47efdde46f0f8e5bb30f93a09e"
    },
    {
      "file": "fr/CH04_P02_L009_fr.mp3",
      "line_id": "CH04_P02_L009",
      "language": "fr",
      "frame_id": "CH04_P02_F02",
      "reading_order": 9,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Il faut trouver une idée…",
      "emotion_tag": "[thinking aloud]",
      "duration_ms": 2160,
      "sha256": "a2c7c9931c53af8ff0c6f6700d23e6a230ba20b58be09261e14be8c48f33d530"
    },
    {
      "file": "fr/CH04_P02_L010_fr.mp3",
      "line_id": "CH04_P02_L010",
      "language": "fr",
      "frame_id": "CH04_P02_F03",
      "reading_order": 10,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Alors, vous êtes bien installés ?",
      "emotion_tag": "[teasing]",
      "duration_ms": 2080,
      "sha256": "3963c52ffb5b03a07e14d50dc28af7e1a25247ef31e7c3d328a719d183c37bdf"
    },
    {
      "file": "fr/CH04_P02_L011_fr.mp3",
      "line_id": "CH04_P02_L011",
      "language": "fr",
      "frame_id": "CH04_P02_F03",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Tu es comme celui du Petit Nuage de Magellan !",
      "emotion_tag": "[surprised]",
      "duration_ms": 2640,
      "sha256": "3ba57dac182c139555095299a3133f3e52f635ac2cb360c892369bc1e5ebcb33"
    },
    {
      "file": "fr/CH04_P02_L012_fr.mp3",
      "line_id": "CH04_P02_L012",
      "language": "fr",
      "frame_id": "CH04_P02_F04",
      "reading_order": 12,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Sargon ?! Qu'est-ce qui lui est arrivé ? Il disait avoir un plan pour devenir riche !",
      "emotion_tag": "[shocked]",
      "duration_ms": 4880,
      "sha256": "07a9167ec47aa829df295a9da674c663c97b534eca8a705aa9a063350025f93a"
    },
    {
      "file": "fr/CH04_P02_L015_fr.mp3",
      "line_id": "CH04_P02_L015",
      "language": "fr",
      "frame_id": "CH04_P02_F05",
      "reading_order": 14,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "interpreted_dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Notre ami dit que Sargon est retenu prisonnier. Si tu nous aides à fuir, il tentera d'obtenir sa libération.",
      "emotion_tag": "[confidently]",
      "duration_ms": 6400,
      "sha256": "22444fb341a9cde4ebaa6bf5e40ba9debce0ca3d85c123fef52397b98e094645"
    },
    {
      "file": "fr/CH04_P02_L014_fr.mp3",
      "line_id": "CH04_P02_L014",
      "language": "fr",
      "frame_id": "CH04_P02_F05",
      "reading_order": 15,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "D'accord ! Mais d'abord, il faut que je mange !",
      "emotion_tag": "[cheerfully]",
      "duration_ms": 3360,
      "sha256": "a50ea7471602257d819e7b86c7b9c8500eb5ffcab7c53d954336bdba4080939d"
    },
    {
      "file": "fr/CH04_P02_L016_fr.mp3",
      "line_id": "CH04_P02_L016",
      "language": "fr",
      "frame_id": "CH04_P02_F06",
      "reading_order": 16,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Après une petite pause pour manger, le lézard aida nos amis à s'évader. Bientôt, ils rejoignirent leur vaisseau.",
      "emotion_tag": "[with relief]",
      "duration_ms": 6640,
      "sha256": "193486b1ebfe1cabb24b5f30ebcb53b97ad7c2b284380aafcc8b4adc2a4cc531"
    },
    {
      "file": "de/CH04_P02_L001_de.mp3",
      "line_id": "CH04_P02_L001",
      "language": "de",
      "frame_id": "CH04_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Große echsenartige Wesen stürmten das Schiff. Bestimmt, aber erstaunlich höflich, führten sie alle in einen Käfig.",
      "emotion_tag": "[dryly]",
      "duration_ms": 8080,
      "sha256": "5240f80c57e059d7c29f7808dde095900d9c4d8bc8205a7838831bd35a49edd4"
    },
    {
      "file": "de/CH04_P02_L002_de.mp3",
      "line_id": "CH04_P02_L002",
      "language": "de",
      "frame_id": "CH04_P02_F01",
      "reading_order": 2,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Bitte sehr.",
      "emotion_tag": "[politely]",
      "duration_ms": 1120,
      "sha256": "3924fc558c76203c9fb4c64deef1584ce5f727647f71aaf871467f2efa01a34e"
    },
    {
      "file": "de/CH04_P02_L003_de.mp3",
      "line_id": "CH04_P02_L003",
      "language": "de",
      "frame_id": "CH04_P02_F01",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Was wird jetzt aus uns?!",
      "emotion_tag": "[frightened]",
      "duration_ms": 2000,
      "sha256": "2347a44850bd02aaad6e2322fc91738ccba36a2032db51241abf1c9c19ba5ba6"
    },
    {
      "file": "de/CH04_P02_L006_de.mp3",
      "line_id": "CH04_P02_L006",
      "language": "de",
      "frame_id": "CH04_P02_F01",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "inner_monologue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Ich werde nie nach Hause kommen…",
      "emotion_tag": "[sadly]",
      "duration_ms": 2240,
      "sha256": "cf48ca417d1747aa19d1e6b4190051d89cf61bc4ac4d74093e355f210df547fa"
    },
    {
      "file": "de/CH04_P02_L007_de.mp3",
      "line_id": "CH04_P02_L007",
      "language": "de",
      "frame_id": "CH04_P02_F02",
      "reading_order": 7,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Sie brachten alle zur Piratenstation Titanenkopf und hielten sie dort gefangen.",
      "emotion_tag": "[seriously]",
      "duration_ms": 4960,
      "sha256": "de2023d369367f78974c51daac2526506f07ea48cde79c417cfff48764609792"
    },
    {
      "file": "de/CH04_P02_L008_de.mp3",
      "line_id": "CH04_P02_L008",
      "language": "de",
      "frame_id": "CH04_P02_F02",
      "reading_order": 8,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Was machen wir jetzt?",
      "emotion_tag": "[anxiously]",
      "duration_ms": 1760,
      "sha256": "93884e575284d2801a528df5ad946ac5b79784f6afdceadd0c44967215762210"
    },
    {
      "file": "de/CH04_P02_L009_de.mp3",
      "line_id": "CH04_P02_L009",
      "language": "de",
      "frame_id": "CH04_P02_F02",
      "reading_order": 9,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Uns muss etwas einfallen…",
      "emotion_tag": "[thinking aloud]",
      "duration_ms": 2400,
      "sha256": "982d24ee24913b94751a07a55c5372fc751d200a660e4fda14518dcb582dca8e"
    },
    {
      "file": "de/CH04_P02_L010_de.mp3",
      "line_id": "CH04_P02_L010",
      "language": "de",
      "frame_id": "CH04_P02_F03",
      "reading_order": 10,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Na, habt ihr es hier bequem?",
      "emotion_tag": "[teasing]",
      "duration_ms": 2320,
      "sha256": "6c5a66be857e730ff9fa6cd5c7748b159b93465e03a339d01ae96eb01c8af27e"
    },
    {
      "file": "de/CH04_P02_L011_de.mp3",
      "line_id": "CH04_P02_L011",
      "language": "de",
      "frame_id": "CH04_P02_F03",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Du bist genau wie der aus der Kleinen Magellanschen Wolke!",
      "emotion_tag": "[surprised]",
      "duration_ms": 3360,
      "sha256": "cf546d2fdb959001273fcc27eae897da8fba8c7c9f587fd9be985c6a9ac89a4a"
    },
    {
      "file": "de/CH04_P02_L012_de.mp3",
      "line_id": "CH04_P02_L012",
      "language": "de",
      "frame_id": "CH04_P02_F04",
      "reading_order": 12,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Sargon?! Was ist mit ihm passiert? Er sagte, er hätte einen Plan, reich zu werden!",
      "emotion_tag": "[shocked]",
      "duration_ms": 5440,
      "sha256": "2ba9153a9381401b44668a5ccfb82010eb7fd62a0c4332caa6663818f19c481a"
    },
    {
      "file": "de/CH04_P02_L015_de.mp3",
      "line_id": "CH04_P02_L015",
      "language": "de",
      "frame_id": "CH04_P02_F05",
      "reading_order": 14,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "interpreted_dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Unser Freund sagt, Sargon wird festgehalten. Hilfst du uns bei der Flucht, versucht er, Sargons Freilassung zu erreichen.",
      "emotion_tag": "[confidently]",
      "duration_ms": 6960,
      "sha256": "6e6306245902c7857d661640000f3c081cab71cc04182053bcba05319d09037f"
    },
    {
      "file": "de/CH04_P02_L014_de.mp3",
      "line_id": "CH04_P02_L014",
      "language": "de",
      "frame_id": "CH04_P02_F05",
      "reading_order": 15,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Einverstanden! Aber zuerst muss ich etwas essen!",
      "emotion_tag": "[cheerfully]",
      "duration_ms": 3440,
      "sha256": "5c572f6a98028f6ff0fc7a4803d59bd18d7aba0d3dd748ab6344ae0a37b4fd21"
    },
    {
      "file": "de/CH04_P02_L016_de.mp3",
      "line_id": "CH04_P02_L016",
      "language": "de",
      "frame_id": "CH04_P02_F06",
      "reading_order": 16,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Nach einem kleinen Imbiss half die Echse unseren Freunden bei der Flucht. Bald erreichten alle ihr Raumschiff.",
      "emotion_tag": "[with relief]",
      "duration_ms": 6320,
      "sha256": "d7fd4b0330155b0d6559daecd5a375d0550b329b0460a885ef8048095adf4173"
    }
  ],
