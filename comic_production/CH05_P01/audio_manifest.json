      "reading_order": 4,
      "language": "en",
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "What are we going to do?!",
      "emotion_tag": "[worried]",
      "duration_ms": 1840,
      "sha256": "c8dc3ea130c0ad0818deeaaa03c8d8ba936d75a5c3e9079fae9b3a74e4347abe"
