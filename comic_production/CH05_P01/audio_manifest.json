      "frame_id": "CH05_P01_F05",
      "reading_order": 10,
      "language": "pt_BR",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "As portas se abriram. Mika entrou na escuridão, onde criaturas estranhas e sons assustadores o aguardavam...",
