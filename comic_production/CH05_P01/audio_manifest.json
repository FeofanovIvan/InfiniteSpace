      "language": "pt_BR",
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Bubble! Para onde vamos? Mostre a rota!",
