      "frame_id": "CH05_P01_F02",
      "reading_order": 6,
      "language": "ru",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Неожиданная сила потянула корабль к незнакомым звёздам. Впереди показалась яркая красная планета.",
      "emotion_tag": "[tense]",
      "duration_ms": 7280,
      "sha256": "aa4fe4aaea5036c3e44a78c8bc3fc9266a79c598b1fc8970fba2ae80aa9a5ae8"
    },
    {
      "file": "ru/CH05_P01_L007_ru.mp3",
