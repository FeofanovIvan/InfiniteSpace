      "language": "pt_BR",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "A nave pousou suavemente numa pirâmide negra flutuante.",
