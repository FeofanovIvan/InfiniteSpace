      "reading_order": 3,
      "language": "en",
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "These stars are completely unfamiliar...",
      "emotion_tag": "[uncertain]",
      "duration_ms": 2960,
      "sha256": "90c131a7beee23e95a1a5f2af7aa675bbb7695a781cba13efea6680ca91fd13d"
    },
    {
