      "reading_order": 6,
      "language": "en",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "A sudden force pulled the ship toward unknown stars. Ahead, a bright red planet appeared.",
