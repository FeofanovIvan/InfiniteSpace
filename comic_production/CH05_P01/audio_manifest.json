      "frame_id": "CH05_P01_F03",
      "reading_order": 8,
      "language": "ru",
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Куда нас затягивает?!",
      "emotion_tag": "[panicked]",
      "duration_ms": 1600,
      "sha256": "681b5a1de7fd092aa38f846b786b41122ec09b67df7147dffb630fabf00cadfb"
    },
    {
