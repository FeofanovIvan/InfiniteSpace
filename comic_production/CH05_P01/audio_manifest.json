      "language": "ru",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "В глубоком космосе друзья поняли: никто не знает, куда лететь дальше.",
      "emotion_tag": "[uneasy]",
      "duration_ms": 5360,
      "sha256": "480bd93a6395968bf7816de70c312deca290f9d6de16c2ace8e955fad135ffa6"
    },
    {
      "file": "ru/CH05_P01_L002_ru.mp3",
