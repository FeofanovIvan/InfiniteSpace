      "reading_order": 4,
      "language": "pt_BR",
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "O que vamos fazer?!",
