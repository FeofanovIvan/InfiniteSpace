      "language": "pt_BR",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "No espaço profundo, os amigos perceberam: ninguém sabia para onde voar agora.",
      "emotion_tag": "[uneasy]",
      "duration_ms": 6240,
      "sha256": "461c8c589ed69e34f18272be9cfcf846d12fc51e89e132167ac4131789a8f759"
