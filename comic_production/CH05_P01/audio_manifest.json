      "language": "en",
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "What is pulling us in?!",
      "emotion_tag": "[panicked]",
