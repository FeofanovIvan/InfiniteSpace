      "frame_id": "CH05_P01_F04",
      "reading_order": 9,
      "language": "ru",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Корабль плавно сел на чёрную парящую пирамиду.",
