      "reading_order": 9,
      "language": "en",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "The ship gently landed on a black floating pyramid.",
      "emotion_tag": "[relieved]",
      "duration_ms": 3920,
