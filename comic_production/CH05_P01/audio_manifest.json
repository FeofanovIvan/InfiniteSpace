      "language": "pt_BR",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Uma força inesperada puxou a nave para estrelas desconhecidas. À frente surgiu um planeta vermelho e brilhante.",
