      "frame_id": "CH05_P01_F03",
      "reading_order": 7,
      "language": "en",
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "What is happening?!",
      "emotion_tag": "[alarmed]",
      "duration_ms": 1600,
