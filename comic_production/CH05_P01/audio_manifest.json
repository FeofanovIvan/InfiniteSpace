      "frame_id": "CH05_P01_F03",
      "reading_order": 7,
      "language": "ru",
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Что происходит?!",
      "emotion_tag": "[alarmed]",
      "duration_ms": 1600,
      "sha256": "32f70f07fa3913c8a0d18102ffcbab02df446f293ebf460af2c2dd6886bc7179"
    },
