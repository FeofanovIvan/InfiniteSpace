      "frame_id": "CH05_P01_F01",
      "reading_order": 2,
      "language": "ru",
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Бабл! Куда нам лететь? Покажи маршрут!",
      "emotion_tag": "[urgently]",
      "duration_ms": 2880,
      "sha256": "a5ddfb9b5f85dd2322cd5b80663a7074d14a807c9d2b66e9c491805c0c7d1edd"
    },
    {
