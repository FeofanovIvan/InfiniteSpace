      "frame_id": "CH05_P01_F01",
      "reading_order": 2,
      "language": "en",
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Bubble! Where should we go? Show us the route!",
