      "reading_order": 10,
      "language": "en",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "The doors opened. Mika stepped into the dark, where strange creatures and frightening sounds awaited him...",
