      "duration_ms": 3680,
      "sha256": "d254dfe5e25db4425a62fb745cee85519558c2f319053f30555411ee112e8d9a"
    },
    {
      "file": "ru/CH05_P01_L010_ru.mp3",
      "line_id": "CH05_P01_L010",
      "frame_id": "CH05_P01_F05",
      "reading_order": 10,
      "language": "ru",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Двери раскрылись. Мика шагнул в темноту, где его встретили странные существа и пугающие звуки…",
      "emotion_tag": "[ominously]",
      "duration_ms": 7680,
      "sha256": "4643a54811a26332ca8a36c9caeacb719f734cee55042e85d5b80621c783ba0a"
    },
    {
      "file": "en/CH05_P01_L001_en.mp3",
      "line_id": "CH05_P01_L001",
      "frame_id": "CH05_P01_F01",
      "reading_order": 1,
      "language": "en",
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "In deep space, the friends realized that no one knew where to fly next.",
      "emotion_tag": "[uneasy]",
      "duration_ms": 5280,
      "sha256": "6f242e5ef15866f9fa6f661c1a6e23a0f63f6465d8d05ca17faf5baeb93dde8a"
    },
