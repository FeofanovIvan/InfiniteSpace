      "frame_id": "CH05_P01_F01",
      "reading_order": 4,
      "language": "ru",
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Что же нам делать?!",
      "emotion_tag": "[worried]",
      "duration_ms": 1840,
      "sha256": "42c451317670c2463937e0e782d1de0b81c6ecd3dae6726fe6f2e3504849b774"
