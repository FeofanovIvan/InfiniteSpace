      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "En el espacio profundo, los amigos comprendieron: nadie sabía adónde debían volar.",
