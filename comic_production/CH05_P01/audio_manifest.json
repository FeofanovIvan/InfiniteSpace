      "frame_id": "CH05_P01_F01",
      "reading_order": 3,
      "language": "ru",
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Звёзды совсем незнакомые…",
      "emotion_tag": "[uncertain]",
      "duration_ms": 3040,
      "sha256": "2961a14ff3cfd338e6335fc128e4b759edc38d95a39063c72db20163286f9e52"
    },
    {
      "file": "ru/CH05_P01_L004_ru.mp3",
