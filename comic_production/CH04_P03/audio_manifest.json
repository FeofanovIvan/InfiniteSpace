      "frame_id": "CH04_P03_F03",
      "reading_order": 5,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "Tenho certeza de que você pode nos ajudar!",
      "emotion_tag": "[encouragingly]",
      "duration_ms": 2960,
