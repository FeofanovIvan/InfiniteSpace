      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "O lagarto levou Mika para conhecer um velho amigo: um professor de arqueologia.",
