      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika contou ao lagarto, em poucas palavras, o que aconteceu com seu planeta natal e o conselho da IA de Marte: procurar respostas no passado.",
      "emotion_tag": "[with curiosity]",
      "duration_ms": 9360,
      "sha256": "e2c1a02216489f2a51b5eeccf2c6fc48765304ff73641b7362b04c4e383a1143"
