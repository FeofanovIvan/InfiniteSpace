      "frame_id": "CH04_P03_F03",
      "reading_order": 6,
      "speaker_id": "CHR_032",
      "role": "archeon_archaeologist",
      "kind": "dialogue",
      "voice_id": "IKne3meq5aSn9XLyUdCD",
      "text": "Bem… nem sei como posso ajudar vocês.",
      "emotion_tag": "[hesitantly]",
