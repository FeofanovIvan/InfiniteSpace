      "line_id": "CH04_P03_L004",
      "language": "en",
      "frame_id": "CH04_P03_F02",
      "reading_order": 4,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika’s ship landed on Archeon, not far from an archaeological camp.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 4640,
      "sha256": "0313389cfbecd1bfaef395860f3bd710f6156fc90dae2a52658cc83771db9ceb"
    },
    {
      "file": "en/CH04_P03_L005_en.mp3",
      "line_id": "CH04_P03_L005",
      "language": "en",
      "frame_id": "CH04_P03_F03",
      "reading_order": 5,
      "speaker_id": "CHR_031",
      "role": "pirate_lizard",
      "kind": "dialogue",
      "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
      "text": "I’m sure you can help us!",
      "emotion_tag": "[encouragingly]",
      "duration_ms": 1840,
      "sha256": "e72d570e9c13d4e8bbf03dedfb64d5445de6cffc7352e4fc9c01b08993ecd2cc"
    },
    {
