      "frame_id": "CH04_P03_F06",
      "reading_order": 10,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "The destination was set, and the friends were off on the next leg of their journey!",
      "emotion_tag": "[excitedly]",
      "duration_ms": 4640,
      "sha256": "b0387e77f2544b293c388cfe4cc5ebd6caa59ed84f76436c27b63e612793cbcf"
    },
    {
