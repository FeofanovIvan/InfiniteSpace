      "frame_id": "CH04_P03_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "O arqueólogo entregou algumas amostras aos amigos e sugeriu que procurassem um colega no museu de Runa. Talvez ele soubesse mais e pudesse ajudá-los a continuar a busca.",
      "emotion_tag": "[hopefully]",
      "duration_ms": 10080,
      "sha256": "7667b6505d7ecd28c58f6a3a660aa35275c8d4d0dd3bf4da1109b4a418bd9858"
    },
    {
      "file": "pt_BR/CH04_P03_L009_pt_BR.mp3",
