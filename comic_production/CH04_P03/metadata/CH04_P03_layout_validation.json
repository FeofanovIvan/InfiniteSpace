  "ru": [
    {
      "id": "CH04_P03_L001",
      "speaker": "Рассказчик",
      "font_px": 32,
      "lines": [
        "Мика вкратце рассказал ящеру,",
        "что случилось с его родной",
        "планетой, и о совете марсианского",
        "ИИ: искать ответы в прошлом."
      ],
      "widest_line_px": 655,
      "available_width_px": 658,
      "block_h_px": 242,
      "text_total_h_px": 156
    },
    {
      "id": "CH04_P03_L002",
      "speaker": "Мика",
      "font_px": 43,
      "lines": [
        "И вот мы тут!"
      ],
      "widest_line_px": 334,
      "available_width_px": 334,
      "block_h_px": 124,
      "text_total_h_px": 53
    },
    {
      "id": "CH04_P03_L003",
      "speaker": "Ящер-пират",
      "font_px": 39,
      "lines": [
        "Думаю, вам стоит отправиться на",
        "Археон. Там ты узнаешь немного",
        "больше о нашем прошлом."
      ],
      "widest_line_px": 762,
      "available_width_px": 786,
      "block_h_px": 187,
      "text_total_h_px": 144
    },
    {
      "id": "CH04_P03_L004",
      "speaker": "Рассказчик",
      "font_px": 37,
      "lines": [
        "Корабль Мики приземлился на Археоне,",
        "неподалёку от археологического лагеря."
      ],
      "widest_line_px": 895,
      "available_width_px": 1024,
      "block_h_px": 141,
      "text_total_h_px": 92
    },
    {
      "id": "CH04_P03_L005",
      "speaker": "Ящер-пират",
      "font_px": 34,
      "lines": [
        "Уверен, ты",
        "сможешь нам",
        "помочь!"
      ],
      "widest_line_px": 272,
      "available_width_px": 374,
      "block_h_px": 164,
      "text_total_h_px": 126
    },
    {
      "id": "CH04_P03_L006",
      "speaker": "Профессор-археолог",
      "font_px": 34,
      "lines": [
        "Даже не знаю…",
        "чем я могу вам",
        "помочь."
      ],
      "widest_line_px": 314,
      "available_width_px": 379,
      "block_h_px": 166,
      "text_total_h_px": 126
    },
    {
      "id": "CH04_P03_L007",
      "speaker": "Рассказчик",
      "font_px": 33,
      "lines": [
        "Ящер отвёл Мику к своему знакомому —",
        "профессору археологии."
      ],
      "widest_line_px": 783,
      "available_width_px": 984,
      "block_h_px": 120,
      "text_total_h_px": 82
    },
    {
      "id": "CH04_P03_L008",
      "speaker": "Рассказчик",
      "font_px": 39,
      "lines": [
        "Археолог предоставил друзьям образцы и",
        "посоветовал найти своего коллегу в музее на",
        "Руне. Возможно, тот знает больше и поможет",
        "продолжить поиски."
      ],
      "widest_line_px": 1049,
      "available_width_px": 1099,
      "block_h_px": 231,
      "text_total_h_px": 192
    },
    {
      "id": "CH04_P03_L009",
      "speaker": "Бортовая навигация",
      "font_px": 34,
      "lines": [
        "НОВАЯ ЦЕЛЬ: РУНА — АРХЕОЛОГИЧЕСКИЙ МУЗЕЙ"
      ],
      "widest_line_px": 990,
      "available_width_px": 995,
      "block_h_px": 113,
      "text_total_h_px": 42
    },
    {
      "id": "CH04_P03_L010",
      "speaker": "Рассказчик",
      "font_px": 37,
      "lines": [
        "Цель была выбрана — и дружная",
        "компания снова отправилась в",
        "путь!"
      ],
      "widest_line_px": 725,
      "available_width_px": 756,
      "block_h_px": 178,
      "text_total_h_px": 138
    }
  ]
}