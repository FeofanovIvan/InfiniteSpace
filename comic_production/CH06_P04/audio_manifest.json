      "kind": "offscreen_neuron_speech",
      "voice_id": "FGY2WhTYpPnrIDTdsKH5",
      "text": "Pedimos a nuestros amigos magnéticos que abrieran un portal entre nuestro mundo y aquel del que llegó el eco.",
      "emotion": "объяснение, искренняя серьёзность",
      "emotion_tag": "[thoughtful]",
      "duration_ms": 6320,
      "sha256": "a72947b14be72f908df8ec10566a2542ee6e33e1944e1ac646730d12bed73415"
    },
    {
      "file": "es/CH06_P04_L002_es.mp3",
