      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¿Entonces ustedes me salvaron?",
      "emotion": "потрясение, надежда",
      "emotion_tag": "[hopeful]",
      "duration_ms": 2160,
      "sha256": "1f9f84f7a2231396c1a5fa74d02cbee3cd9bd2e1c5edf34dd4661098c94a055d"
    },
    {
