      "speaker_id": "CHR_038",
      "role": "neuron_telepathic_voice",
      "kind": "telepathic_narration",
      "voice_id": "FGY2WhTYpPnrIDTdsKH5",
      "text": "Aprendimos a prever el nacimiento y la muerte de las galaxias.",
      "emotion_tag": "[awe]",
      "duration_ms": 4400,
      "sha256": "b2569af85b763662da684e15a62338c47e1d848bf7d5a2a95aa23319b566b1ea"
    },
    {
