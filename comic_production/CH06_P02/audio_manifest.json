      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¿O sea que pueden predecir el futuro?",
      "emotion_tag": "[excited]",
      "duration_ms": 2320,
      "sha256": "d5313246532ef7b4b60e31877ccf122ba4d2f9f94688b1f83adf85818f59f1a7"
