  "clips": [
    {
      "file": "ru/CH05_P02_L001_ru.mp3",
      "line_id": "CH05_P02_L001",
      "language": "ru",
      "frame_id": "CH05_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "thought",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Нужно настроить симулятор.",
      "emotion_tag": "[focused]",
      "duration_ms": 2000,
      "sha256": "02abee4ba361ba6f508fee820e2a6efca88dcc1ddf66995bdf5efa12dd836e8a"
    },
    {
      "file": "ru/CH05_P02_L002_ru.mp3",
      "line_id": "CH05_P02_L002",
      "language": "ru",
      "frame_id": "CH05_P02_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Мика понял: незнакомое не обязательно опасно. Иногда достаточно научиться понимать друг друга.",
      "emotion_tag": "[warmly]",
      "duration_ms": 7040,
      "sha256": "56f471e4381668912c9a58dc74dec9d8f806b26d5f884c4efb64388ef0c46fdc"
    },
    {
      "file": "ru/CH05_P02_L003_ru.mp3",
      "line_id": "CH05_P02_L003",
      "language": "ru",
      "frame_id": "CH05_P02_F02",
      "reading_order": 3,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Привет!",
      "emotion_tag": "[friendly]",
      "duration_ms": 960,
      "sha256": "6f73f78834012792f6270bce46f842860a7b2cd427c2242ee8ac63ac1f01cc73"
    },
    {
      "file": "ru/CH05_P02_L004_ru.mp3",
      "line_id": "CH05_P02_L004",
      "language": "ru",
      "frame_id": "CH05_P02_F02",
      "reading_order": 4,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Мы рады, что ты добрался до нас.",
      "emotion_tag": "[joyfully]",
      "duration_ms": 2320,
      "sha256": "59b1847f4b06efa02a9f172bc9c24c9c76b29b45a74408cbf4e7a235f2af276d"
    },
    {
      "file": "ru/CH05_P02_L005_ru.mp3",
      "line_id": "CH05_P02_L005",
      "language": "ru",
      "frame_id": "CH05_P02_F02",
      "reading_order": 5,
      "speaker_id": "CHR_036",
      "role": "magnetic_engineer_host",
      "kind": "dialogue",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "text": "Нам есть что тебе рассказать.",
      "emotion_tag": "[warmly]",
      "duration_ms": 2320,
      "sha256": "c91d970993462c4fa0adeee583b94831960ac8d4c9600802106ed47d0dfe6ca8"
    },
    {
      "file": "ru/CH05_P02_L006_ru.mp3",
      "line_id": "CH05_P02_L006",
      "language": "ru",
      "frame_id": "CH05_P02_F03",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Здравствуйте! Я так рад, что вы оказались друзьями!",
      "emotion_tag": "[relieved]",
      "duration_ms": 4000,
      "sha256": "b346e892a3290e325c6e6591b54d0d132f16e6313a42d136f185f1a65550ae39"
    },
    {
      "file": "ru/CH05_P02_L007_ru.mp3",
      "line_id": "CH05_P02_L007",
      "language": "ru",
      "frame_id": "CH05_P02_F03",
      "reading_order": 7,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Не переживай. Пойдём, я тебе кое-что покажу.",
      "emotion_tag": "[reassuringly]",
      "duration_ms": 3280,
      "sha256": "387de79fa3f7b030f30b8771d090394b92dceb640fa27af6417f5c6e2ac67c07"
    },
    {
      "file": "ru/CH05_P02_L008_ru.mp3",
      "line_id": "CH05_P02_L008",
      "language": "ru",
      "frame_id": "CH05_P02_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Жители Геоны показали Мике своё любимое занятие — эксперименты с гравитацией.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 5760,
      "sha256": "0424cd56b4ee6adeb79b90c8f1ca4a3d546078d2c2bcfc8b1207539b4242b350"
    },
    {
      "file": "ru/CH05_P02_L009_ru.mp3",
      "line_id": "CH05_P02_L009",
      "language": "ru",
      "frame_id": "CH05_P02_F04",
      "reading_order": 9,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Вау!",
      "emotion_tag": "[amazed]",
      "duration_ms": 1360,
      "sha256": "d969cb3a3024c109a4fcbd216b6b39feea5bb629ded6cd560b71607c86ea04d9"
    },
    {
      "file": "ru/CH05_P02_L010_ru.mp3",
      "line_id": "CH05_P02_L010",
      "language": "ru",
      "frame_id": "CH05_P02_F04",
      "reading_order": 10,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Мы можем немного управлять гравитацией и пространством. Ты тоже можешь попробовать!",
      "emotion_tag": "[enthusiastically]",
      "duration_ms": 5520,
      "sha256": "5621b185e4da014d3486c1dab04104fcdb8aa1a61147310d832566b1ca5d6d9b"
    },
    {
      "file": "ru/CH05_P02_L011_ru.mp3",
      "line_id": "CH05_P02_L011",
      "language": "ru",
      "frame_id": "CH05_P02_F05",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Вы ждали меня? Значит, вы знаете, откуда я?",
      "emotion_tag": "[hopefully]",
      "duration_ms": 3760,
      "sha256": "23cf124c97c457e9f142a0101a62fca878a23a327c49ad2d0b193580f3ac7219"
    },
    {
      "file": "ru/CH05_P02_L012_ru.mp3",
      "line_id": "CH05_P02_L012",
      "language": "ru",
      "frame_id": "CH05_P02_F05",
      "reading_order": 12,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Не спеши. Мы всё объясним. Отправляйся на нашу станцию — «Перевёрнутая пирамида». Там хранятся знания, которые помогут тебе понять, что происходит.",
      "emotion_tag": "[calmly]",
      "duration_ms": 11120,
      "sha256": "471ac32b26da9fa77232b545d97a8cc0ba6151e8a9576540ecde56c0029a82c5"
    },
    {
      "file": "ru/CH05_P02_L013_ru.mp3",
      "line_id": "CH05_P02_L013",
      "language": "ru",
      "frame_id": "CH05_P02_F06",
      "reading_order": 13,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "caption",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "«Перевёрнутая пирамида» — архивная станция магнитной цивилизации.",
      "emotion_tag": "[warmly]",
      "duration_ms": 4880,
      "sha256": "309a208aa28b2d0ba21282a578c312386525cc09856b59e5b2d4b3e2e12b6847"
    },
    {
      "file": "en/CH05_P02_L001_en.mp3",
      "line_id": "CH05_P02_L001",
      "language": "en",
      "frame_id": "CH05_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "thought",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "I need to set up the simulator.",
      "emotion_tag": "[focused]",
      "duration_ms": 2080,
      "sha256": "8a7001c5d7b2578650f9584c9e75046caac061b62ff371696f5ba97dc186fb4a"
    },
    {
      "file": "en/CH05_P02_L002_en.mp3",
      "line_id": "CH05_P02_L002",
      "language": "en",
      "frame_id": "CH05_P02_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika realized: the unfamiliar is not always dangerous. Sometimes we just need to understand each other.",
      "emotion_tag": "[warmly]",
      "duration_ms": 7440,
      "sha256": "7a46dcf9e7f5616391c7ee87b726e3b1a701d3c309effce2188e23fb5693a754"
    },
    {
      "file": "en/CH05_P02_L003_en.mp3",
      "line_id": "CH05_P02_L003",
      "language": "en",
      "frame_id": "CH05_P02_F02",
      "reading_order": 3,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Hello!",
      "emotion_tag": "[friendly]",
      "duration_ms": 960,
      "sha256": "902fb756e96513d3f040d5d92bb4b6a1ce242aa12f700a22f61dcede600a6fe6"
    },
    {
      "file": "en/CH05_P02_L004_en.mp3",
      "line_id": "CH05_P02_L004",
      "language": "en",
      "frame_id": "CH05_P02_F02",
      "reading_order": 4,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "We’re so glad you made it here.",
      "emotion_tag": "[joyfully]",
      "duration_ms": 2400,
      "sha256": "77f1d7c8b5f087e03eda76a8f952d86c51c477aa4a2794267cd05a968070d47d"
    },
    {
      "file": "en/CH05_P02_L005_en.mp3",
      "line_id": "CH05_P02_L005",
      "language": "en",
      "frame_id": "CH05_P02_F02",
      "reading_order": 5,
      "speaker_id": "CHR_036",
      "role": "magnetic_engineer_host",
      "kind": "dialogue",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "text": "We have something to tell you.",
      "emotion_tag": "[warmly]",
      "duration_ms": 2000,
      "sha256": "1e1f07865cccaef6714aba620ed4c2e2e3ef065fd79ade4ebed4f58324995f1f"
    },
    {
      "file": "en/CH05_P02_L006_en.mp3",
      "line_id": "CH05_P02_L006",
      "language": "en",
      "frame_id": "CH05_P02_F03",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Hello! I’m so glad you turned out to be friends!",
      "emotion_tag": "[relieved]",
      "duration_ms": 3760,
      "sha256": "017e3e9df0b3e1e8bdecf8067bb0aa9c9009b24a370d75df01bcdc4dfda043dc"
    },
    {
      "file": "en/CH05_P02_L007_en.mp3",
      "line_id": "CH05_P02_L007",
      "language": "en",
      "frame_id": "CH05_P02_F03",
      "reading_order": 7,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Don’t worry. Come along, I want to show you something.",
      "emotion_tag": "[reassuringly]",
      "duration_ms": 3440,
      "sha256": "ec8dc6641857cd5ee329246d78d52dc59bea07c074b8d1b51b12d95f41611f71"
    },
    {
      "file": "en/CH05_P02_L008_en.mp3",
      "line_id": "CH05_P02_L008",
      "language": "en",
      "frame_id": "CH05_P02_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "The people of Geona showed Mika their favorite pastime — experimenting with gravity.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 5760,
      "sha256": "20eff0a16d8c9caa41128708f3d77efec968800378a30f4e92ecc00001a68d9d"
    },
    {
      "file": "en/CH05_P02_L009_en.mp3",
      "line_id": "CH05_P02_L009",
      "language": "en",
      "frame_id": "CH05_P02_F04",
      "reading_order": 9,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Wow!",
      "emotion_tag": "[amazed]",
      "duration_ms": 1360,
      "sha256": "8f7444db1541c8f9bab6706d47d5fba0ba2a16a82aca0e043bc9f8c15cee194f"
    },
    {
      "file": "en/CH05_P02_L010_en.mp3",
      "line_id": "CH05_P02_L010",
      "language": "en",
      "frame_id": "CH05_P02_F04",
      "reading_order": 10,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "We can bend gravity and space a little. You can give it a try, too!",
      "emotion_tag": "[enthusiastically]",
      "duration_ms": 4160,
      "sha256": "a14b42feac066810ed49db625aff2525d562a8c4e9df412c72faab218b47b588"
    },
    {
      "file": "en/CH05_P02_L011_en.mp3",
      "line_id": "CH05_P02_L011",
      "language": "en",
      "frame_id": "CH05_P02_F05",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "You were expecting me? Does that mean you know where I come from?",
      "emotion_tag": "[hopefully]",
      "duration_ms": 3760,
      "sha256": "5bbdf4fe5e052d9279ce399b1317078aaad917259e4e070bf551481471640b34"
    },
    {
      "file": "en/CH05_P02_L012_en.mp3",
      "line_id": "CH05_P02_L012",
      "language": "en",
      "frame_id": "CH05_P02_F05",
      "reading_order": 12,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Not so fast. We’ll explain everything. Head to our station, the Inverted Pyramid. It holds the knowledge that will help you understand what’s going on.",
      "emotion_tag": "[calmly]",
      "duration_ms": 9600,
      "sha256": "855cc3f2dd77f4a326f40522be838f300d0e82c88d06550fdb942e4d22a6fd1a"
    },
    {
      "file": "en/CH05_P02_L013_en.mp3",
      "line_id": "CH05_P02_L013",
      "language": "en",
      "frame_id": "CH05_P02_F06",
      "reading_order": 13,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "caption",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "The Inverted Pyramid — an archive station of the magnetic civilization.",
      "emotion_tag": "[warmly]",
      "duration_ms": 5200,
      "sha256": "19d10b9a5d8997abd28a7bded9fa06f9e5a1dda52d1e0c5e546584e1db19f46c"
    },
    {
      "file": "pt_BR/CH05_P02_L001_pt_BR.mp3",
      "line_id": "CH05_P02_L001",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "thought",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Preciso ajustar o simulador.",
      "emotion_tag": "[focused]",
      "duration_ms": 2160,
      "sha256": "87e49853dfee37bf71c07a78b915c8e52b409716be213090a4dedc6215be65d6"
    },
    {
      "file": "pt_BR/CH05_P02_L002_pt_BR.mp3",
      "line_id": "CH05_P02_L002",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika percebeu que o desconhecido nem sempre é perigoso. Às vezes, basta aprender a entender o outro.",
      "emotion_tag": "[warmly]",
      "duration_ms": 6960,
      "sha256": "9ac9192f9703b120a51a1045dca434004116c2a5978f72d773febe3befb2cfcc"
    },
    {
      "file": "pt_BR/CH05_P02_L003_pt_BR.mp3",
      "line_id": "CH05_P02_L003",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F02",
      "reading_order": 3,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Olá!",
      "emotion_tag": "[friendly]",
      "duration_ms": 960,
      "sha256": "039b72b5ba839d2bf0676c8723762d541cbc598a542c1c07afeca7cd1cc62064"
    },
    {
      "file": "pt_BR/CH05_P02_L004_pt_BR.mp3",
      "line_id": "CH05_P02_L004",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F02",
      "reading_order": 4,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Que bom que você conseguiu chegar até nós!",
      "emotion_tag": "[joyfully]",
      "duration_ms": 2640,
      "sha256": "3af4875ddf4b4dab7b1b3273df5eb8d22d2a44fe01d4a5d087ffb34f0b7363d3"
    },
    {
      "file": "pt_BR/CH05_P02_L005_pt_BR.mp3",
      "line_id": "CH05_P02_L005",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F02",
      "reading_order": 5,
      "speaker_id": "CHR_036",
      "role": "magnetic_engineer_host",
      "kind": "dialogue",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "text": "Temos muita coisa para contar a você.",
      "emotion_tag": "[warmly]",
      "duration_ms": 2880,
      "sha256": "f3203cb463f13bcd3573658f47d132acc546667b6292352364e853b56b2ee96c"
    },
    {
      "file": "pt_BR/CH05_P02_L006_pt_BR.mp3",
      "line_id": "CH05_P02_L006",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F03",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Olá! Estou tão feliz por vocês serem amigos!",
      "emotion_tag": "[relieved]",
      "duration_ms": 3840,
      "sha256": "e8420834e6fc9d04a37d0e9fc960a21e8ecaa48233dd750e9eddff04e609ad6f"
    },
    {
      "file": "pt_BR/CH05_P02_L007_pt_BR.mp3",
      "line_id": "CH05_P02_L007",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F03",
      "reading_order": 7,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Não se preocupe. Venha, quero mostrar uma coisa!",
      "emotion_tag": "[reassuringly]",
      "duration_ms": 3280,
      "sha256": "b1a6cbcb564d0abe046c449c4fc23faeae48cbecff3113b5501ea3928ab11337"
    },
    {
      "file": "pt_BR/CH05_P02_L008_pt_BR.mp3",
      "line_id": "CH05_P02_L008",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Os habitantes de Geona mostraram a Mika sua atividade favorita: fazer experiências com a gravidade.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 6960,
      "sha256": "620aff464f3e3f48b02bc24ba220073ddcafa4bd1d911243ef616c3781365e9d"
    },
    {
      "file": "pt_BR/CH05_P02_L009_pt_BR.mp3",
      "line_id": "CH05_P02_L009",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F04",
      "reading_order": 9,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Uau!",
      "emotion_tag": "[amazed]",
      "duration_ms": 1440,
      "sha256": "be7486c989c40c75d005150e2daa9307bc49e71320b058b657263cd0235152f5"
    },
    {
      "file": "pt_BR/CH05_P02_L010_pt_BR.mp3",
      "line_id": "CH05_P02_L010",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F04",
      "reading_order": 10,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Podemos manipular um pouquinho a gravidade e o espaço. Você também pode experimentar!",
      "emotion_tag": "[enthusiastically]",
      "duration_ms": 5440,
      "sha256": "520f339c544e5db9c4f91d651abe5b4b2f68135ab6440ba6538526acb601213d"
    },
    {
      "file": "pt_BR/CH05_P02_L011_pt_BR.mp3",
      "line_id": "CH05_P02_L011",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F05",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Vocês estavam me esperando? Então sabem de onde eu vim?",
      "emotion_tag": "[hopefully]",
      "duration_ms": 3920,
      "sha256": "c8dd7ae25fb7f785deab6de031d7c66fac327a7efc7198013279ec49e373bd45"
    },
    {
      "file": "pt_BR/CH05_P02_L012_pt_BR.mp3",
      "line_id": "CH05_P02_L012",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F05",
      "reading_order": 12,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Calma, vamos explicar tudo. Primeiro, vá até nossa estação, a Pirâmide Invertida. Lá estão guardados conhecimentos que vão ajudar você a entender o que está acontecendo.",
      "emotion_tag": "[calmly]",
      "duration_ms": 12080,
      "sha256": "8f3a37acb125610e6acbf69d10d8a1639738b989ab023310d07c3db659ff2aea"
    },
    {
      "file": "pt_BR/CH05_P02_L013_pt_BR.mp3",
      "line_id": "CH05_P02_L013",
      "language": "pt_BR",
      "frame_id": "CH05_P02_F06",
      "reading_order": 13,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "caption",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Pirâmide Invertida — estação-arquivo da civilização magnética.",
      "emotion_tag": "[warmly]",
      "duration_ms": 4960,
      "sha256": "7326ca0244b0c82fb0d1f764c1484156f105c5488b17223880b31cdeaa532a9c"
    },
    {
      "file": "es/CH05_P02_L001_es.mp3",
      "line_id": "CH05_P02_L001",
      "language": "es",
      "frame_id": "CH05_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "thought",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Tengo que ajustar el simulador.",
      "emotion_tag": "[focused]",
      "duration_ms": 2000,
      "sha256": "d8c74097e64789a09f5bb8a4eea46b7345b0a230fea40cd7abe21ff9b3c05a4a"
    },
    {
      "file": "es/CH05_P02_L002_es.mp3",
      "line_id": "CH05_P02_L002",
      "language": "es",
      "frame_id": "CH05_P02_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika comprendió que lo desconocido no siempre es peligroso. A veces, basta con aprender a entendernos.",
      "emotion_tag": "[warmly]",
      "duration_ms": 6960,
      "sha256": "0d91abbada29bd4453216a3da3dd4028788b074108f3486ade4d07d643d990db"
    },
    {
      "file": "es/CH05_P02_L003_es.mp3",
      "line_id": "CH05_P02_L003",
      "language": "es",
      "frame_id": "CH05_P02_F02",
      "reading_order": 3,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "¡Hola!",
      "emotion_tag": "[friendly]",
      "duration_ms": 880,
      "sha256": "edfae092bdab0e030ab703cabd679ee7fc8a3acd473445f7a3d9182bc83ce819"
    },
    {
      "file": "es/CH05_P02_L004_es.mp3",
      "line_id": "CH05_P02_L004",
      "language": "es",
      "frame_id": "CH05_P02_F02",
      "reading_order": 4,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "¡Nos alegra mucho que hayas llegado hasta aquí!",
      "emotion_tag": "[joyfully]",
      "duration_ms": 2880,
      "sha256": "610e6ea2ce3b8ac5cb4a983d6fb59bcd2afb13f2caa9d15d8c2e0188c840b453"
    },
    {
      "file": "es/CH05_P02_L005_es.mp3",
      "line_id": "CH05_P02_L005",
      "language": "es",
      "frame_id": "CH05_P02_F02",
      "reading_order": 5,
      "speaker_id": "CHR_036",
      "role": "magnetic_engineer_host",
      "kind": "dialogue",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "text": "Tenemos mucho que contarte.",
      "emotion_tag": "[warmly]",
      "duration_ms": 2320,
      "sha256": "5b45a0f0939f7ac3811a16eb7c9ce4c1621f73a26955f2f66dac0cd9ef6c6196"
    },
    {
      "file": "es/CH05_P02_L006_es.mp3",
      "line_id": "CH05_P02_L006",
      "language": "es",
      "frame_id": "CH05_P02_F03",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¡Hola! ¡Qué alegría saber que son amigos!",
      "emotion_tag": "[relieved]",
      "duration_ms": 2960,
      "sha256": "59bac571eb3a4e646aaea163199ea8e440ba1f209b00abe82725e6593f4cc6c4"
    },
    {
      "file": "es/CH05_P02_L007_es.mp3",
      "line_id": "CH05_P02_L007",
      "language": "es",
      "frame_id": "CH05_P02_F03",
      "reading_order": 7,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "No te preocupes. Ven, quiero enseñarte algo.",
      "emotion_tag": "[reassuringly]",
      "duration_ms": 3280,
      "sha256": "590b8249da366bb6f1e404268b3799f869449f6a37806264f9ec02a78f47d3b8"
    },
    {
      "file": "es/CH05_P02_L008_es.mp3",
      "line_id": "CH05_P02_L008",
      "language": "es",
      "frame_id": "CH05_P02_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Los habitantes de Geona le mostraron a Mika su pasatiempo favorito: experimentar con la gravedad.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 6480,
      "sha256": "a709fd530c937af44822f3c416ecd417ae0e48153d54bbc40c5aa5fbdfb82231"
    },
    {
      "file": "es/CH05_P02_L009_es.mp3",
      "line_id": "CH05_P02_L009",
      "language": "es",
      "frame_id": "CH05_P02_F04",
      "reading_order": 9,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¡Guau!",
      "emotion_tag": "[amazed]",
      "duration_ms": 1280,
      "sha256": "cb63ba32f78b107dea36e6a65cb43b46f4dc02f67ada93b4126faaab272c4177"
    },
    {
      "file": "es/CH05_P02_L010_es.mp3",
      "line_id": "CH05_P02_L010",
      "language": "es",
      "frame_id": "CH05_P02_F04",
      "reading_order": 10,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Podemos manipular un poco la gravedad y el espacio. ¡Tú también puedes probar!",
      "emotion_tag": "[enthusiastically]",
      "duration_ms": 5040,
      "sha256": "298b27fb5af94721d87444ddf2ed64269ca14471af284aea5f6ceeba28915a2c"
    },
    {
      "file": "es/CH05_P02_L011_es.mp3",
      "line_id": "CH05_P02_L011",
      "language": "es",
      "frame_id": "CH05_P02_F05",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "¿Me estaban esperando? Entonces, ¿saben de dónde vengo?",
      "emotion_tag": "[hopefully]",
      "duration_ms": 4000,
      "sha256": "32a7f4b9236cb0882863751823a321038cd1b574095d49cd82c914e54a94c764"
    },
    {
      "file": "es/CH05_P02_L012_es.mp3",
      "line_id": "CH05_P02_L012",
      "language": "es",
      "frame_id": "CH05_P02_F05",
      "reading_order": 12,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Espera, te lo explicaremos todo. Primero ve a nuestra estación, la Pirámide Invertida. Allí guardamos conocimientos que te ayudarán a comprender qué está pasando.",
      "emotion_tag": "[calmly]",
      "duration_ms": 11040,
      "sha256": "4dc85a4dfd022b3fe59c658358a7204434c6561d7561e5d29c4653c71708c950"
    },
    {
      "file": "es/CH05_P02_L013_es.mp3",
      "line_id": "CH05_P02_L013",
      "language": "es",
      "frame_id": "CH05_P02_F06",
      "reading_order": 13,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "caption",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Pirámide Invertida — estación-archivo de la civilización magnética.",
      "emotion_tag": "[warmly]",
      "duration_ms": 4720,
      "sha256": "7f13c104f6c5aff2da9755d8146d013fcabefca503a022fa7fa1936bdc0b3798"
    },
    {
      "file": "fr/CH05_P02_L001_fr.mp3",
      "line_id": "CH05_P02_L001",
      "language": "fr",
      "frame_id": "CH05_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "thought",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Il faut régler le simulateur.",
      "emotion_tag": "[focused]",
      "duration_ms": 1920,
      "sha256": "37f21948ffc60e24b8a71eae30fa80ceaa90ba815033e455bc2932a397741ddc"
    },
    {
      "file": "fr/CH05_P02_L002_fr.mp3",
      "line_id": "CH05_P02_L002",
      "language": "fr",
      "frame_id": "CH05_P02_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika comprit que l’inconnu n’est pas forcément dangereux. Parfois, il suffit d’apprendre à se comprendre.",
      "emotion_tag": "[warmly]",
      "duration_ms": 6080,
      "sha256": "c20c6bf99c51d7661eba459547050b638376abeaf8dbce9404ec669320b2e535"
    },
    {
      "file": "fr/CH05_P02_L003_fr.mp3",
      "line_id": "CH05_P02_L003",
      "language": "fr",
      "frame_id": "CH05_P02_F02",
      "reading_order": 3,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Bonjour !",
      "emotion_tag": "[friendly]",
      "duration_ms": 1120,
      "sha256": "1dd7d0175a956d4d251f27433a3e695d9945579879ad16d3d403ebf1fa391481"
    },
    {
      "file": "fr/CH05_P02_L004_fr.mp3",
      "line_id": "CH05_P02_L004",
      "language": "fr",
      "frame_id": "CH05_P02_F02",
      "reading_order": 4,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Nous sommes ravis que tu aies réussi à venir jusqu’à nous !",
      "emotion_tag": "[joyfully]",
      "duration_ms": 3200,
      "sha256": "84afeb58d82775a2f9e0ac3d7a7c41cb32655f9980d98b6539827b15553c1deb"
    },
    {
      "file": "fr/CH05_P02_L005_fr.mp3",
      "line_id": "CH05_P02_L005",
      "language": "fr",
      "frame_id": "CH05_P02_F02",
      "reading_order": 5,
      "speaker_id": "CHR_036",
      "role": "magnetic_engineer_host",
      "kind": "dialogue",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "text": "Nous avons tant de choses à te raconter.",
      "emotion_tag": "[warmly]",
      "duration_ms": 2560,
      "sha256": "b08547579575f2be5f302e7557a9cbbdaef4fb1ab707e02cc1d1df78ae11b5af"
    },
    {
      "file": "fr/CH05_P02_L006_fr.mp3",
      "line_id": "CH05_P02_L006",
      "language": "fr",
      "frame_id": "CH05_P02_F03",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Bonjour ! Je suis si heureux de découvrir que vous êtes des amis !",
      "emotion_tag": "[relieved]",
      "duration_ms": 4320,
      "sha256": "434dd9e9333b942a4ed5cff7a6fcd433b18a486cd7910b42ec7af54b9d2e4dd9"
    },
    {
      "file": "fr/CH05_P02_L007_fr.mp3",
      "line_id": "CH05_P02_L007",
      "language": "fr",
      "frame_id": "CH05_P02_F03",
      "reading_order": 7,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Ne t’inquiète pas. Viens, je vais te montrer quelque chose.",
      "emotion_tag": "[reassuringly]",
      "duration_ms": 3120,
      "sha256": "4d4445a3e2b761d48292280e37d08f3708bce666be4a74a3e917d9e50dafd6e0"
    },
    {
      "file": "fr/CH05_P02_L008_fr.mp3",
      "line_id": "CH05_P02_L008",
      "language": "fr",
      "frame_id": "CH05_P02_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Les habitants de Géona montrèrent à Mika leur passe-temps favori : expérimenter avec la gravité.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 6320,
      "sha256": "948489c23e6fa10d009f0f47f738f07689b1ead7c64663d269fdad2586b6cdf4"
    },
    {
      "file": "fr/CH05_P02_L009_fr.mp3",
      "line_id": "CH05_P02_L009",
      "language": "fr",
      "frame_id": "CH05_P02_F04",
      "reading_order": 9,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Waouh !",
      "emotion_tag": "[amazed]",
      "duration_ms": 1520,
      "sha256": "a0f128e8336708ce8892e2560eb557bd89d1e151ef02156682b6b05c29bc9fb2"
    },
    {
      "file": "fr/CH05_P02_L010_fr.mp3",
      "line_id": "CH05_P02_L010",
      "language": "fr",
      "frame_id": "CH05_P02_F04",
      "reading_order": 10,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Nous pouvons jouer un peu avec la gravité et l’espace. Tu peux essayer, toi aussi !",
      "emotion_tag": "[enthusiastically]",
      "duration_ms": 4640,
      "sha256": "6894428dc2671230b8454d1c5f3f6b72e15530d9fbfeb22a3a2e6f22e3110d9f"
    },
    {
      "file": "fr/CH05_P02_L011_fr.mp3",
      "line_id": "CH05_P02_L011",
      "language": "fr",
      "frame_id": "CH05_P02_F05",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Vous m’attendiez ? Alors, vous savez d’où je viens ?",
      "emotion_tag": "[hopefully]",
      "duration_ms": 3280,
      "sha256": "66638c9a43c7b15094553b019847ef9d18f5c9388d8d1659783a96cf5223b074"
    },
    {
      "file": "fr/CH05_P02_L012_fr.mp3",
      "line_id": "CH05_P02_L012",
      "language": "fr",
      "frame_id": "CH05_P02_F05",
      "reading_order": 12,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Pas si vite, nous allons tout t’expliquer. Rends-toi d’abord à notre station, la Pyramide inversée. Elle conserve des connaissances qui t’aideront à comprendre ce qui se passe.",
      "emotion_tag": "[calmly]",
      "duration_ms": 9920,
      "sha256": "9140f99cc4dd1294cf9bc2505eb283a1e97f01cb8f170058d527490123186c7f"
    },
    {
      "file": "fr/CH05_P02_L013_fr.mp3",
      "line_id": "CH05_P02_L013",
      "language": "fr",
      "frame_id": "CH05_P02_F06",
      "reading_order": 13,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "caption",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "La Pyramide inversée — station d’archives de la civilisation magnétique.",
      "emotion_tag": "[warmly]",
      "duration_ms": 5120,
      "sha256": "c74721b1e3cbe9a77b14b81ceee0b6e3aec70521287e64619f00ed9e594bec2e"
    },
    {
      "file": "de/CH05_P02_L001_de.mp3",
      "line_id": "CH05_P02_L001",
      "language": "de",
      "frame_id": "CH05_P02_F01",
      "reading_order": 1,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "thought",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Ich muss den Simulator einstellen.",
      "emotion_tag": "[focused]",
      "duration_ms": 2240,
      "sha256": "686722ecffd33f61fcab2115314eeb1341f8ad14f574d56d220a18f353b61f47"
    },
    {
      "file": "de/CH05_P02_L002_de.mp3",
      "line_id": "CH05_P02_L002",
      "language": "de",
      "frame_id": "CH05_P02_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Mika verstand: Nicht alles Unbekannte ist gefährlich. Manchmal muss man einander nur verstehen lernen.",
      "emotion_tag": "[warmly]",
      "duration_ms": 6880,
      "sha256": "b3f597afc44c870cd29d97ab9b75c6493f08b561b9bc3085e18bc4038fb98cc9"
    },
    {
      "file": "de/CH05_P02_L003_de.mp3",
      "line_id": "CH05_P02_L003",
      "language": "de",
      "frame_id": "CH05_P02_F02",
      "reading_order": 3,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Hallo!",
      "emotion_tag": "[friendly]",
      "duration_ms": 960,
      "sha256": "f3dfc8052d95d77fa0cf5aa2488c6080c0085a02459df9659f2401009ea7ad80"
    },
    {
      "file": "de/CH05_P02_L004_de.mp3",
      "line_id": "CH05_P02_L004",
      "language": "de",
      "frame_id": "CH05_P02_F02",
      "reading_order": 4,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Wir freuen uns, dass du es bis zu uns geschafft hast!",
      "emotion_tag": "[joyfully]",
      "duration_ms": 3040,
      "sha256": "6b3646c867cf6638213d16419f6beefa1c63f895ebe32aabe0724acf01927b20"
    },
    {
      "file": "de/CH05_P02_L005_de.mp3",
      "line_id": "CH05_P02_L005",
      "language": "de",
      "frame_id": "CH05_P02_F02",
      "reading_order": 5,
      "speaker_id": "CHR_036",
      "role": "magnetic_engineer_host",
      "kind": "dialogue",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "text": "Wir haben dir einiges zu erzählen.",
      "emotion_tag": "[warmly]",
      "duration_ms": 2480,
      "sha256": "dd9bdb53e2dc9300ffb6e0541666b77351ca42e378beb81cc838b0171be20266"
    },
    {
      "file": "de/CH05_P02_L006_de.mp3",
      "line_id": "CH05_P02_L006",
      "language": "de",
      "frame_id": "CH05_P02_F03",
      "reading_order": 6,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Hallo! Ich bin so froh, dass ihr Freunde seid!",
      "emotion_tag": "[relieved]",
      "duration_ms": 3680,
      "sha256": "9400939e25f7446feda01fe02dcb5590b665578336a9f5244b64c716c4a04017"
    },
    {
      "file": "de/CH05_P02_L007_de.mp3",
      "line_id": "CH05_P02_L007",
      "language": "de",
      "frame_id": "CH05_P02_F03",
      "reading_order": 7,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Keine Sorge. Komm mit, ich zeige dir etwas!",
      "emotion_tag": "[reassuringly]",
      "duration_ms": 3280,
      "sha256": "01c61917665309fc8f6bed7567173db5b92f97a7991490653eb8f073db5c1916"
    },
    {
      "file": "de/CH05_P02_L008_de.mp3",
      "line_id": "CH05_P02_L008",
      "language": "de",
      "frame_id": "CH05_P02_F04",
      "reading_order": 8,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Die Bewohner von Geona zeigten Mika ihre Lieblingsbeschäftigung: Experimente mit der Schwerkraft.",
      "emotion_tag": "[with wonder]",
      "duration_ms": 6480,
      "sha256": "1b97f9f984c500f9b1c9aa07d74ddda9318d20f3906c81f40ce3ec8809bd0da7"
    },
    {
      "file": "de/CH05_P02_L009_de.mp3",
      "line_id": "CH05_P02_L009",
      "language": "de",
      "frame_id": "CH05_P02_F04",
      "reading_order": 9,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Wow!",
      "emotion_tag": "[amazed]",
      "duration_ms": 1360,
      "sha256": "c875b2f5bd71a841372b8a5aea253a4797a6ad86894bb32502451ff5f59dec47"
    },
    {
      "file": "de/CH05_P02_L010_de.mp3",
      "line_id": "CH05_P02_L010",
      "language": "de",
      "frame_id": "CH05_P02_F04",
      "reading_order": 10,
      "speaker_id": "CHR_035",
      "role": "magnetic_companion_host",
      "kind": "dialogue",
      "voice_id": "EST9Ui6982FZPSi7gCHi",
      "text": "Wir können Schwerkraft und Raum ein wenig beeinflussen. Probier es doch selbst aus!",
      "emotion_tag": "[enthusiastically]",
      "duration_ms": 4960,
      "sha256": "02211c2908c2fdf482a4b72e7d50e824dbacbaad81072157611d56f679568ba5"
    },
    {
      "file": "de/CH05_P02_L011_de.mp3",
      "line_id": "CH05_P02_L011",
      "language": "de",
      "frame_id": "CH05_P02_F05",
      "reading_order": 11,
      "speaker_id": "CHR_001",
      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Ihr habt auf mich gewartet? Dann wisst ihr, woher ich komme?",
      "emotion_tag": "[hopefully]",
      "duration_ms": 3600,
      "sha256": "8e32534ce7d6821e3b95ad6e21d5ad8deee28daada4f0411d2777abb6689975c"
    },
    {
      "file": "de/CH05_P02_L012_de.mp3",
      "line_id": "CH05_P02_L012",
      "language": "de",
      "frame_id": "CH05_P02_F05",
      "reading_order": 12,
      "speaker_id": "CHR_034",
      "role": "magnetic_ring_host",
      "kind": "dialogue",
      "voice_id": "iwP1PxYYSTdHA1qXlwFe",
      "text": "Nur Geduld, wir erklären dir alles. Flieg zuerst zu unserer Station, der Umgekehrten Pyramide. Dort bewahren wir Wissen auf, das dir helfen wird zu verstehen, was hier geschieht.",
      "emotion_tag": "[calmly]",
      "duration_ms": 12080,
      "sha256": "bd227bfd2c17d2cff4d935d139c10dea8b5eaaa1610c6bfc4dfcb1911d096015"
    },
    {
