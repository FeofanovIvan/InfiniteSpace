      "frame_id": "CH04_P05_F02",
      "reading_order": 3,
      "speaker_id": "CHR_015",
      "role": "professor",
      "kind": "dialogue",
      "voice_id": "pqHfZKP75CvOlQylNhV4",
      "text": "Mika, olha só! Parece o crânio de um pequeno dinossauro carnívoro!",
      "emotion_tag": "[fascinated]",
      "duration_ms": 5040,
      "sha256": "683d6c3fa05e3d8ec05648fb67409205cd89d7a00823eb74f1070ec5a545d787"
    },
    {
