      "language": "pt_BR",
      "frame_id": "CH04_P05_F01",
      "reading_order": 1,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Finalmente, nossos amigos chegaram ao museu arqueológico de Runa.",
      "emotion_tag": "[warmly]",
      "duration_ms": 4640,
      "sha256": "a8557e3b122de20d74cf26628305d90ff9d1e1df98d2a398d064db4129e81541"
    },
    {
      "file": "pt_BR/CH04_P05_L002_pt_BR.mp3",
      "line_id": "CH04_P05_L002",
      "language": "pt_BR",
      "frame_id": "CH04_P05_F02",
      "reading_order": 2,
      "speaker_id": "CHR_004",
      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "O professor decidiu acompanhar Mika na visita.",
      "emotion_tag": "[lightly]",
      "duration_ms": 3200,
      "sha256": "ce3ad1446a78c8a35121ecbf0e694066882bccfbcd5c355e283cf161b2887211"
    },
    {
