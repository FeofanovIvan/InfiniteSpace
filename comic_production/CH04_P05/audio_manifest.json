      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "…a conversa quase sempre vira uma discussão!",
      "emotion_tag": "[wryly]",
      "duration_ms": 3600,
      "sha256": "88c38a9f819e4e8e6f0c0d5fd5a145c5b69d2c98d2fa77cccd76452602e6f781"
    },
    {
