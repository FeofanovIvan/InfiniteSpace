      "language": "en",
      "frame_id": "CH04_P05_F07",
      "reading_order": 12,
      "speaker_id": "CHR_008",
      "role": "ship_navigation",
      "kind": "system",
      "voice_id": "SAz9YHcvj6GT2YYXdXww",
      "text": "NEW COURSE: ANDROMEDA",
      "emotion_tag": "[clear and informative]",
      "duration_ms": 2320,
      "sha256": "d5f6a0724e1eb5ad5439460af472b1dd119fbeb072c9e7fa1b7a31dcd95ac168"
    },
    {
