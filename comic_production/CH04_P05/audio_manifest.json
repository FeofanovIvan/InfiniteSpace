      "role": "narrator",
      "kind": "narration",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "text": "Quando dois professores se encontram…",
      "emotion_tag": "[playfully]",
      "duration_ms": 2800,
      "sha256": "b7d09c46533f82559d23718e233a9a2f56770db49802fca6978d4c11d71fa3b2"
