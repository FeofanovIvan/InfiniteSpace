      "role": "mika",
      "kind": "dialogue",
      "voice_id": "XjcBo3s44Dqh64FhOpGk",
      "text": "Uau!",
      "emotion_tag": "[surprised]",
      "duration_ms": 1120,
      "sha256": "771e83d074b34c9b9d9c5ddaf0de825c80c9b2c3170cfefadd70c8f66280df90"
    },
    {
      "file": "pt_BR/CH04_P05_L005_pt_BR.mp3",
