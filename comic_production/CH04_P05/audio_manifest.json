      "kind": "dialogue",
      "voice_id": "VQUUw0Trz8Naf1fKmQ3W",
      "text": "Prazer em conhecê-lo, colega!",
      "emotion_tag": "[friendly]",
      "duration_ms": 2160,
      "sha256": "60c278dc23766eda28a9d128b0a24fecd6ecda7e15cf97543518beea74a1c0d0"
    },
    {
