      "line_id": "CH01_P06_L001",
      "speaker_id": "CHR_013",
      "role": "mars_ai_core",
      "language": "ru",
      "text": "Похоже, шторм вызвали гравитационные, магнитные и пространственные аномалии.",
      "emotion_tag": "[thoughtfully]",
      "gap_after_ms": 330,
      "duration_ms": 6000,
