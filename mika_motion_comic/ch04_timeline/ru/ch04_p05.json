      "audio_kind": "voice",
      "sha256": "2078fd817354803d9c6a61aaf6406f7e4560fb4673c946f09b75a3ea7ac63830"
    },
    {
      "line_id": "CH04_P05_L010",
      "frame_id": "CH04_P05_F07",
      "panel_id": "p45_shadow_of_origin",
      "speaker_id": "CHR_033",
      "kind": "dialogue",
      "spoken_text": "На раскопках мы обнаружили следы древней расы. Похоже, она умела управлять гравитацией!",
