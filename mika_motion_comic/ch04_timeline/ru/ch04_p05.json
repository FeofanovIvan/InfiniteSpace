      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "9708b940fc2f284cc67c2adb6505ab2f64404910a11cde9b1742739b6ae5a497"
    },
    {
      "line_id": "CH04_P05_L009",
      "frame_id": "CH04_P05_F06",
      "panel_id": "p45_scientists_farewell",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Редкий случай: учёные всё-таки нашли компромисс!",
      "audio_path": "res://mika_motion_comic/ch04_clips/ru/CH04_P05_L009_ru.mp3",
      "audio_duration_s": 4.127,
      "camera_target": [
        0.28,
        0.841,
        0.208
      ],
