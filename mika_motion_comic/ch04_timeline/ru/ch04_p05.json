    {
      "line_id": "CH04_P05_L008",
      "frame_id": "CH04_P05_F05",
      "panel_id": "p45_white_evolution",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Учёные предположили: удар астероида не оборвал древнюю ветвь эволюции. Следы земной жизни могли попасть в другую галактику, смешаться с местными видами и дать начало необычному гибриду — предку ящеров.",
      "audio_path": "res://mika_motion_comic/ch04_clips/ru/CH04_P05_L008_ru.mp3",
      "audio_duration_s": 14.289,
      "camera_target": [
        0.5,
        0.655,
        0.126
      ],
