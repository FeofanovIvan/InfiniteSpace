      "panel_id": "p45_shadow_of_origin",
      "speaker_id": "CHR_033",
      "kind": "dialogue",
      "spoken_text": "Nas escavações, encontramos vestígios de um povo antigo. Parece que ele sabia controlar a gravidade!",
