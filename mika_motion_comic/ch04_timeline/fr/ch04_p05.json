      "panel_id": "p45_scientists_farewell",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Pour une fois, les chercheurs parvinrent à se mettre d’accord !",
      "audio_path": "res://mika_motion_comic/ch04_clips/fr/CH04_P05_L009_fr.mp3",
      "audio_duration_s": 4.127,
