      "frame_id": "CH04_P03_F01",
      "panel_id": "p43_cockpit_decision",
      "speaker_id": "CHR_031",
      "kind": "dialogue",
      "spoken_text": "Creo que deberían visitar Archeon. Allí podrás descubrir algo más sobre nuestro pasado.",
