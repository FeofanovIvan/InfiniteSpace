      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "6ea65b0fd6934c4aca1903530d111ff36b932748f634e88883ec25ef09f4b95b"
    },
    {
      "line_id": "CH04_P05_L009",
