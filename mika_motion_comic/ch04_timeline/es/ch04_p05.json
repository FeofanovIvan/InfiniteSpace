      "panel_id": "p45_shadow_of_origin",
      "speaker_id": "CHR_033",
      "kind": "dialogue",
      "spoken_text": "En nuestras excavaciones hallamos huellas de un pueblo antiguo. ¡Parece que podía controlar la gravedad!",
