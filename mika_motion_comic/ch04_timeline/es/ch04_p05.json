      "panel_id": "p45_scientists_farewell",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "¡Por una vez, los científicos lograron ponerse de acuerdo!",
      "audio_path": "res://mika_motion_comic/ch04_clips/es/CH04_P05_L009_es.mp3",
      "audio_duration_s": 4.049,
