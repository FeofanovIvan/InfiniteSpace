    },
    {
      "line_id": "CH05_P02_L007",
      "frame_id": "CH05_P02_F03",
      "panel_id": "p52_mika_meets_magnetic",
      "speaker_id": "CHR_035",
      "kind": "dialogue",
      "spoken_text": "Don’t worry. Come along, I want to show you something.",
