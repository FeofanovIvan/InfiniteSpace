      "frame_id": "CH05_P04_F02",
      "panel_id": "p54_species_meet",
      "speaker_id": "CHR_037",
      "kind": "archive_narration",
      "spoken_text": "Long ago, when we arrived in this world, its inhabitants helped us settle in. We still keep in touch with them.",
