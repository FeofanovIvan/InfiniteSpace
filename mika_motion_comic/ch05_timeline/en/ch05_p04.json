      "sha256": "ab4b021958a7e97683906da380bf8511333f2879c67b09567060333d0b8906dc"
    },
    {
      "line_id": "CH05_P04_L003",
      "frame_id": "CH05_P04_F03",
      "panel_id": "p54_pulse_signal",
      "speaker_id": "CHR_037",
      "kind": "archive_narration",
      "spoken_text": "Recently, they sent us a signal asking us to open a tunnel from your world to ours.",
      "audio_path": "res://mika_motion_comic/ch05_clips/en/CH05_P04_L003_en.mp3",
      "audio_duration_s": 5.251,
