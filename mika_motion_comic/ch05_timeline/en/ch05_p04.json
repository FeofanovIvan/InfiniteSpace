      "frame_id": "CH05_P04_F05",
      "panel_id": "p54_mika_farewell",
      "speaker_id": "CHR_035",
      "kind": "dialogue",
      "spoken_text": "We decided: I will travel with you and help you reach these beings. They can tell us why they saved you.",
