      "panel_id": "p54_pulse_signal",
      "speaker_id": "CHR_037",
      "kind": "archive_narration",
      "spoken_text": "Hace poco nos enviaron una señal: nos pidieron abrir un túnel desde tu mundo hasta el nuestro.",
