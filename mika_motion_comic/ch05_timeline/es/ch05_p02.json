      "frame_id": "CH05_P02_F04",
      "panel_id": "p52_portal_discovery",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Los habitantes de Geona le mostraron a Mika su pasatiempo favorito: experimentar con la gravedad.",
