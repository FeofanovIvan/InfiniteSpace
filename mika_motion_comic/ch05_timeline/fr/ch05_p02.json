    {
      "line_id": "CH05_P02_L004",
      "frame_id": "CH05_P02_F02",
      "panel_id": "p52_magnetic_hall",
      "speaker_id": "CHR_035",
      "kind": "dialogue",
      "spoken_text": "Nous sommes ravis que tu aies réussi à venir jusqu’à nous !",
