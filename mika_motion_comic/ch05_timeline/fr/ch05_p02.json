      "line_id": "CH05_P02_L006",
      "frame_id": "CH05_P02_F03",
      "panel_id": "p52_mika_meets_magnetic",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Bonjour ! Je suis si heureux de découvrir que vous êtes des amis !",
      "audio_path": "res://mika_motion_comic/ch05_clips/fr/CH05_P02_L006_fr.mp3",
