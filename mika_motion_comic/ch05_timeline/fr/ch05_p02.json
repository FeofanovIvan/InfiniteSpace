      "frame_id": "CH05_P02_F04",
      "panel_id": "p52_portal_discovery",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Les habitants de Géona montrèrent à Mika leur passe-temps favori : expérimenter avec la gravité.",
