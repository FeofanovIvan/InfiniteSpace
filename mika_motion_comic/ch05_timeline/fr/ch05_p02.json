      "frame_id": "CH05_P02_F04",
      "panel_id": "p52_portal_discovery",
      "speaker_id": "CHR_035",
      "kind": "dialogue",
      "spoken_text": "Nous pouvons jouer un peu avec la gravité et l’espace. Tu peux essayer, toi aussi !",
