      "frame_id": "CH05_P02_F03",
      "panel_id": "p52_mika_meets_magnetic",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Hallo! Ich bin so froh, dass ihr Freunde seid!",
