      "frame_id": "CH05_P02_F04",
      "panel_id": "p52_portal_discovery",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Die Bewohner von Geona zeigten Mika ihre Lieblingsbeschäftigung: Experimente mit der Schwerkraft.",
