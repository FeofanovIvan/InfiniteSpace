    },
    {
      "line_id": "CH05_P04_L003",
      "frame_id": "CH05_P04_F03",
      "panel_id": "p54_pulse_signal",
      "speaker_id": "CHR_037",
      "kind": "archive_narration",
      "spoken_text": "Vor Kurzem erhielten wir ihr Signal: Sie baten uns, einen Tunnel von deiner Welt in unsere zu öffnen.",
      "audio_path": "res://mika_motion_comic/ch05_clips/de/CH05_P04_L003_de.mp3",
      "audio_duration_s": 6.426,
      "camera_target": [
        0.755,
