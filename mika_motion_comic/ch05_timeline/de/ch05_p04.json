      "audio_kind": "voice",
      "sha256": "f894089fabf4dc12d4a1b6099b62b8b94dd115eb04d4feb49f2abf83aee41998"
    },
    {
      "line_id": "CH05_P04_L004",
      "frame_id": "CH05_P04_F04",
      "panel_id": "p54_black_hole",
      "speaker_id": "CHR_037",
      "kind": "archive_narration",
      "spoken_text": "Wir öffneten den Durchgang und warteten ab, was geschehen würde. Dann bist du aufgetaucht.",
