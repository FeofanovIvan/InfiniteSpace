      "panel_id": "p54_species_meet",
      "speaker_id": "CHR_037",
      "kind": "archive_narration",
      "spoken_text": "Als wir vor langer Zeit in diese Welt kamen, halfen uns ihre Bewohner, uns hier zurechtzufinden. Bis heute stehen wir mit ihnen in Kontakt.",
      "audio_path": "res://mika_motion_comic/ch05_clips/de/CH05_P04_L002_de.mp3",
