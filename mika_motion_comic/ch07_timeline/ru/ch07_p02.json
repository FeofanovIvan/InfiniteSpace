      "line_id": "CH07_P02_L005",
      "frame_id": "2",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Из метеоритов появилась жизнь фазовых существ. Новая атмосфера благодаря астероиду повлияла на ящеров — они стали симбиотами.",
      "audio_path": "res://mika_motion_comic/ch07_clips/ru/CH07_P02_L005_ru.mp3",
      "audio_duration_s": 8.672653,
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
