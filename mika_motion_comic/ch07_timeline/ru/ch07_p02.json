      "frame_id": "3",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Магнитные существа умеют управлять астероидами.",
      "audio_path": "res://mika_motion_comic/ch07_clips/ru/CH07_P02_L006_ru.mp3",
