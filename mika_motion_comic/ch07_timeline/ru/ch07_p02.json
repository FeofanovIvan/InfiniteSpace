      "transition_sfx_path": "",
      "line_id": "CH07_P02_L002",
      "frame_id": "1",
      "speaker_id": "CHR_040",
      "kind": "dialogue",
      "spoken_text": "Расскажи мне, как ты собрал ребус и попал ко мне.",
      "audio_path": "res://mika_motion_comic/ch07_clips/ru/CH07_P02_L002_ru.mp3",
