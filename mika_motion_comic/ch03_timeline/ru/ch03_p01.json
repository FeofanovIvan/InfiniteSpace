      "audio_kind": "voice",
      "sha256": "2bc8fb9d00824ec3d56471130ef31d47bac22bc12afb8a869f6aba3ace13dad2"
    },
    {
      "line_id": "CH03_P01_L014",
      "frame_id": "CH03_P01_F07",
      "panel_id": "p31_okea_lizard_talks",
      "speaker_id": "CHR_025",
      "kind": "dialogue",
      "spoken_text": "На Целе хранят древние знания. Возможно, они помогут!",
      "audio_path": "res://mika_motion_comic/ch03_clips/ru/CH03_P01_L014_ru.mp3",
