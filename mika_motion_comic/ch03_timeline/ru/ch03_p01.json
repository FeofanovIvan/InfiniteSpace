      "panel_id": "p31_professor_sandwich",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Где-то между Большим и Малым Магеллановыми Облаками…",
      "audio_path": "res://mika_motion_comic/ch03_clips/ru/CH03_P01_L001_ru.mp3",
