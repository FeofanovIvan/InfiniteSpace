      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "c0d09a080ccdfe3388511c1ca2f481a4f934b5d79fa2a839275d62ba7affbd10"
    },
    {
      "line_id": "CH03_P01_L003",
      "frame_id": "CH03_P01_F02",
      "panel_id": "p31_fungus_and_professor",
      "speaker_id": "CHR_023",
      "kind": "dialogue",
      "spoken_text": "Это не я!",
      "audio_path": "res://mika_motion_comic/ch03_clips/ru/CH03_P01_L003_ru.mp3",
      "audio_duration_s": 1.306,
      "camera_target": [
