      "sha256": "839dd3f9529f929fc91b1689ab69eb4c0300adbefc5151a46a8aaac2cc8bc404"
    },
    {
      "line_id": "CH03_P01_L015",
      "frame_id": "CH03_P01_F08",
      "panel_id": "p31_okea_to_cela",
      "speaker_id": "CHR_004",
      "kind": "destination_narration",
      "spoken_text": "Друзья взяли курс на Целу — за следующей подсказкой о прошлом.",
