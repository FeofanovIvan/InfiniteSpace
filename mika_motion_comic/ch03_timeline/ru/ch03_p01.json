    },
    {
      "line_id": "CH03_P01_L002",
      "frame_id": "CH03_P01_F02",
      "panel_id": "p31_fungus_and_professor",
      "speaker_id": "CHR_015",
      "kind": "dialogue",
      "spoken_text": "Я знаю! Это ты съел мой бургер!",
      "audio_path": "res://mika_motion_comic/ch03_clips/ru/CH03_P01_L002_ru.mp3",
      "audio_duration_s": 3.318,
      "camera_target": [
        0.845,
