    },
    {
      "line_id": "CH02_P04_L010",
      "frame_id": "CH02_P04_F09",
      "panel_id": "p24_professor_and_fungus",
      "speaker_id": "CHR_004",
      "kind": "destination_narration",
      "spoken_text": "Tarántula les mostró el camino hacia la Pequeña Nube de Magallanes. Con un nuevo amigo a bordo, ¡el equipo estaba listo para otra aventura!",
