      "audio_kind": "voice",
      "sha256": "f55997b5ba6f6d30ff87cfdd0e1e115443f84034c5d352ac96d73eb99db2df0a"
    },
    {
      "line_id": "CH02_P04_L009",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "mika_thanks",
      "spoken_text": "¡Gracias! ¿Adónde vamos ahora?",
