  "lines": [
    {
      "line_id": "CH02_P04_L001",
      "frame_id": "CH02_P04_F01",
      "panel_id": "p24_station_exterior",
      "speaker_id": "CHR_004",
      "kind": "intro",
      "spoken_text": "La estación Tarántula es una nave-laboratorio viva de la civilización de los hongos.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L001_es.mp3",
      "audio_duration_s": 5.486,
      "camera_target": [
        0.5,
        0.074,
        0.123
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "0bb9aff85796f0400111be6e74f7a66f171c15563b7bf1808444a03c523fde8a"
    },
    {
      "line_id": "CH02_P04_L002",
      "frame_id": "CH02_P04_F02",
      "panel_id": "p24_fungal_garden",
      "speaker_id": "CHR_023",
      "kind": "station_greeting",
      "spoken_text": "¡Hola, Mika! Mis amigos me han contado mucho sobre ti. Quizá nuestra historia te ayude a encontrar respuestas.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L002_es.mp3",
      "audio_duration_s": 7.236,
      "camera_target": [
        0.3,
        0.28,
        0.218
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "29b1e167e9870a4d4d76437137f2fb4cc34c3fd68c1e22f4a4b17e38363eb633"
    },
    {
      "line_id": "CH02_P04_L003",
      "frame_id": "CH02_P04_F03",
      "panel_id": "p24_factory",
      "speaker_id": "CHR_023",
      "kind": "old_civilization",
      "spoken_text": "Hace mucho tiempo, una gran civilización floreció en Molia.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L003_es.mp3",
      "audio_duration_s": 4.833,
      "camera_target": [
        0.792,
        0.211,
        0.1
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "ade8593ef21bcc5bc490e0f7c2d9bad63fb6ca29d5f0d9ce0e041cc58e3f4ffc"
    },
    {
      "line_id": "CH02_P04_L004",
      "frame_id": "CH02_P04_F04",
      "panel_id": "p24_reclaimed_city",
      "speaker_id": "CHR_023",
      "kind": "ecological_collapse",
      "spoken_text": "Pero su afán de consumir recursos y sus montañas de basura acabaron con aquel mundo.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L004_es.mp3",
      "audio_duration_s": 5.642,
      "camera_target": [
        0.791,
        0.332,
        0.118
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "4359edc5cf77ed9b7d0a3a9b73a746f3e2b3327eb812c2b1e21ed303c22d4240"
    },
    {
      "line_id": "CH02_P04_L005",
      "frame_id": "CH02_P04_F05",
      "panel_id": "p24_fungus_portrait",
      "speaker_id": "CHR_023",
      "kind": "silence",
      "spoken_text": "El planeta quedó desierto. Parecía que la vida había desaparecido para siempre…",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L005_es.mp3",
      "audio_duration_s": 6.269,
      "camera_target": [
        0.17,
        0.488,
        0.117
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "8cf49d17c3fa73fdc9b182d9cf90436ad9bb83d9874f3732cd1efe904c142f7c"
    },
    {
      "line_id": "CH02_P04_L006",
      "frame_id": "CH02_P04_F06",
      "panel_id": "p24_meteor",
      "speaker_id": "CHR_023",
      "kind": "meteor_ancestors",
      "spoken_text": "Más tarde, un meteorito trajo aquí a nuestros lejanos antepasados.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L006_es.mp3",
      "audio_duration_s": 5.068,
      "camera_target": [
        0.505,
        0.46,
        0.11
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "3f75caf80824ed1d1aa088c380976e7101ae366f3dcd17fa7fae1ae5dd58a90a"
    },
    {
      "line_id": "CH02_P04_L007",
      "frame_id": "CH02_P04_F07",
      "panel_id": "p24_mycelium_net",
      "speaker_id": "CHR_023",
      "kind": "network_origin",
      "spoken_text": "Se unieron en una gran red inteligente. Así nació nuestro pueblo.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L007_es.mp3",
      "audio_duration_s": 5.251,
      "camera_target": [
        0.501,
        0.612,
        0.14
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "8eb025516306f6299b428cb2f876ae644cf184b1d52ed029f42be679dbb7940a"
    },
    {
      "line_id": "CH02_P04_L008",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_023",
      "kind": "new_companion",
      "spoken_text": "Enviaré contigo una parte de mí. Juntos intentaremos desvelar el misterio de la tormenta.",
      "audio_path": "res://mika_motion_comic/ch02_clips/es/CH02_P04_L008_es.mp3",
      "audio_duration_s": 6.348,
      "camera_target": [
        0.817,
