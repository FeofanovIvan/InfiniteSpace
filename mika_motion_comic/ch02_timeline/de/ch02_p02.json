      "panel_id": "p22_fungal_conversation",
      "speaker_id": "CHR_001",
      "kind": "speech_earnest_request",
      "spoken_text": "Ich suche den Weg nach Hause. Und will verstehen, wo ich gelandet bin. Könnt ihr mir helfen?",
