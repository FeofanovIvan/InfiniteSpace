      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "91e43a5a5dd381d749cc46c9ea34d7acc33357308a4bb9b5f46053a12501cfb0"
    },
    {
      "line_id": "CH02_P04_L006",
      "frame_id": "CH02_P04_F06",
      "panel_id": "p24_meteor",
      "speaker_id": "CHR_023",
      "kind": "meteor_ancestors",
      "spoken_text": "Später brachte ein Meteorit unsere fernen Vorfahren hierher.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L006_de.mp3",
      "audio_duration_s": 4.519,
      "camera_target": [
        0.505,
