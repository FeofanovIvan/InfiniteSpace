      "audio_kind": "voice",
      "sha256": "28773252f5de55dc4227d2f375f7bff305beda0b18488dea9ba96843cdca04c2"
    },
    {
      "line_id": "CH02_P04_L007",
      "frame_id": "CH02_P04_F07",
      "panel_id": "p24_mycelium_net",
      "speaker_id": "CHR_023",
      "kind": "network_origin",
      "spoken_text": "Sie schlossen sich zu einem riesigen intelligenten Netz zusammen. So entstand unser Volk.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L007_de.mp3",
      "audio_duration_s": 6.191,
      "camera_target": [
        0.501,
