    },
    {
      "line_id": "CH02_P04_L002",
      "frame_id": "CH02_P04_F02",
      "panel_id": "p24_fungal_garden",
      "speaker_id": "CHR_023",
      "kind": "station_greeting",
      "spoken_text": "Hallo, Mika! Meine Freunde haben mir viel von dir erzählt. Vielleicht hilft dir unsere Geschichte, Antworten zu finden.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L002_de.mp3",
      "audio_duration_s": 7.811,
      "camera_target": [
        0.3,
        0.28,
        0.218
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "aba8b49cd93148ba18baed2794eb8f136d71eb5b1a28208a8eba388d55dd0df7"
    },
    {
      "line_id": "CH02_P04_L003",
      "frame_id": "CH02_P04_F03",
      "panel_id": "p24_factory",
      "speaker_id": "CHR_023",
      "kind": "old_civilization",
      "spoken_text": "Vor langer Zeit blühte auf Molia eine große Zivilisation.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L003_de.mp3",
      "audio_duration_s": 4.833,
      "camera_target": [
        0.792,
        0.211,
        0.1
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "b7506855f2acabd2b70c79e3620e400af2ea8cd89e0b4f2f325bd81c43531cfd"
    },
    {
      "line_id": "CH02_P04_L004",
      "frame_id": "CH02_P04_F04",
      "panel_id": "p24_reclaimed_city",
      "speaker_id": "CHR_023",
      "kind": "ecological_collapse",
      "spoken_text": "Doch ihr maßloser Hunger nach Rohstoffen und Berge von Abfällen zerstörten ihre Welt.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L004_de.mp3",
      "audio_duration_s": 5.486,
      "camera_target": [
        0.791,
        0.332,
        0.118
      ],
      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "66065a762332936d9dd30c18bd16dd452667c212a96e1ee7265c40a0ae082aec"
    },
    {
      "line_id": "CH02_P04_L005",
      "frame_id": "CH02_P04_F05",
      "panel_id": "p24_fungus_portrait",
      "speaker_id": "CHR_023",
      "kind": "silence",
      "spoken_text": "Der Planet wurde still. Es schien, als wäre alles Leben für immer verschwunden…",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L005_de.mp3",
      "audio_duration_s": 6.113,
      "camera_target": [
        0.17,
