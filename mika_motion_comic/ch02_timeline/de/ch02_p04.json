      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "93440fdb497ef0f844dc5b9d989e89c3db13ec7378c22c932096a74095877a9e"
    },
    {
      "line_id": "CH02_P04_L008",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_023",
      "kind": "new_companion",
      "spoken_text": "Ich schicke einen Teil von mir mit dir. Gemeinsam können wir das Geheimnis des Sturms lüften.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L008_de.mp3",
      "audio_duration_s": 5.564,
      "camera_target": [
