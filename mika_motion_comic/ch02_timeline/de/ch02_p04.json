    {
      "line_id": "CH02_P04_L001",
      "frame_id": "CH02_P04_F01",
      "panel_id": "p24_station_exterior",
      "speaker_id": "CHR_004",
      "kind": "intro",
      "spoken_text": "Die Station Tarantel ist ein lebendes Forschungsschiff der Pilzzivilisation.",
      "audio_path": "res://mika_motion_comic/ch02_clips/de/CH02_P04_L001_de.mp3",
      "audio_duration_s": 4.911,
      "camera_target": [
        0.5,
