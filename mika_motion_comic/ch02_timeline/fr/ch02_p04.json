      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "9766328c27454f34b275ed4db94fa8872c37a6b162e8cca8ad64ff9c0ae5c1cd"
    },
    {
      "line_id": "CH02_P04_L004",
      "frame_id": "CH02_P04_F04",
      "panel_id": "p24_reclaimed_city",
      "speaker_id": "CHR_023",
      "kind": "ecological_collapse",
      "spoken_text": "Mais sa soif de ressources et ses montagnes de déchets ont détruit son monde.",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L004_fr.mp3",
      "audio_duration_s": 4.598,
      "camera_target": [
