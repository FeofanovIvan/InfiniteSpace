    },
    {
      "line_id": "CH02_P04_L007",
      "frame_id": "CH02_P04_F07",
      "panel_id": "p24_mycelium_net",
      "speaker_id": "CHR_023",
      "kind": "network_origin",
      "spoken_text": "Ils se sont unis en un immense réseau intelligent. C’est ainsi qu’est né notre peuple.",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L007_fr.mp3",
