    {
      "line_id": "CH02_P04_L002",
      "frame_id": "CH02_P04_F02",
      "panel_id": "p24_fungal_garden",
      "speaker_id": "CHR_023",
      "kind": "station_greeting",
      "spoken_text": "Bonjour, Mika ! Mes amis m’ont beaucoup parlé de toi. Notre histoire pourra peut-être t’aider à trouver des réponses.",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L002_fr.mp3",
