      "sha256": "fdd505ed5cfea7550547e2e8ad79527e7647e2fc5bc4d97db282eee5a89a1e75"
    },
    {
      "line_id": "CH02_P04_L003",
      "frame_id": "CH02_P04_F03",
      "panel_id": "p24_factory",
      "speaker_id": "CHR_023",
      "kind": "old_civilization",
      "spoken_text": "Autrefois, une grande civilisation prospérait sur Molia.",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L003_fr.mp3",
      "audio_duration_s": 4.362,
      "camera_target": [
        0.792,
