      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "54363ea4ea32d06e358737ef7d634230a1428f92eba3b301359ecaacd77997c6"
    },
    {
      "line_id": "CH02_P04_L005",
      "frame_id": "CH02_P04_F05",
      "panel_id": "p24_fungus_portrait",
      "speaker_id": "CHR_023",
      "kind": "silence",
      "spoken_text": "La planète est devenue déserte. La vie semblait avoir disparu pour toujours…",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L005_fr.mp3",
      "audio_duration_s": 5.564,
      "camera_target": [
