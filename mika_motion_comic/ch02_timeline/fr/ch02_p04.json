      "sha256": "8ab996859982d3bce545fd65ddd8315c2fb9e3ef9d4cbed6eb3dc9d48e975197"
    },
    {
      "line_id": "CH02_P04_L009",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "mika_thanks",
      "spoken_text": "Merci ! Où allons-nous maintenant ?",
