      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "72bdc1675d4afa25205063b4ec4074b0787eb65d4e692480229fe99cbaa9752b"
    },
    {
      "line_id": "CH02_P04_L008",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_023",
      "kind": "new_companion",
      "spoken_text": "Je vais envoyer une partie de moi avec toi. Ensemble, nous chercherons le secret de la tempête.",
