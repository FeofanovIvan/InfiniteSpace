      "panel_id": "p24_station_exterior",
      "speaker_id": "CHR_004",
      "kind": "intro",
      "spoken_text": "La station Tarentule est un vaisseau-laboratoire vivant de la civilisation des champignons.",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L001_fr.mp3",
