      "audio_kind": "voice",
      "sha256": "bf71be03d31b629b5d3425f17eb6da4501269e92c3c703421cd271beae917bbe"
    },
    {
      "line_id": "CH02_P04_L006",
      "frame_id": "CH02_P04_F06",
      "panel_id": "p24_meteor",
      "speaker_id": "CHR_023",
      "kind": "meteor_ancestors",
      "spoken_text": "Plus tard, une météorite a amené ici nos lointains ancêtres.",
      "audio_path": "res://mika_motion_comic/ch02_clips/fr/CH02_P04_L006_fr.mp3",
      "audio_duration_s": 4.519,
      "camera_target": [
