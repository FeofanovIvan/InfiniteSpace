      "audio_kind": "voice",
      "sha256": "0f7b89a5ef0714aa59daa19afd5307d5f7086af0997a12c3d4839889e9d2f089"
    },
    {
      "line_id": "CH02_P04_L008",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_023",
      "kind": "new_companion",
      "spoken_text": "Vou mandar uma parte de mim com você. Juntos, vamos desvendar o mistério da tempestade.",
