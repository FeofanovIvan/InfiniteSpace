    {
      "line_id": "CH02_P04_L007",
      "frame_id": "CH02_P04_F07",
      "panel_id": "p24_mycelium_net",
      "speaker_id": "CHR_023",
      "kind": "network_origin",
      "spoken_text": "Eles se uniram numa grande rede inteligente. Foi assim que o nosso povo nasceu.",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L007_pt_BR.mp3",
