      "transition_before_s": 0.4,
      "transition_style": "cut",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "595c0cbf250bdc63a1236c607cdff2381cdf82bd784ff5936f68805c0ced2b0a"
    },
    {
      "line_id": "CH02_P04_L003",
      "frame_id": "CH02_P04_F03",
      "panel_id": "p24_factory",
      "speaker_id": "CHR_023",
      "kind": "old_civilization",
      "spoken_text": "Há muito tempo, uma grande civilização floresceu em Molia.",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L003_pt_BR.mp3",
      "audio_duration_s": 5.068,
      "camera_target": [
