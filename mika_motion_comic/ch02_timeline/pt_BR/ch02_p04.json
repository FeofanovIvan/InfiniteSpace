      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "b94d76576033c2ee7ec41cc8f982f8182676525547aebdbefa11bdf568aef7da"
    },
    {
      "line_id": "CH02_P04_L004",
      "frame_id": "CH02_P04_F04",
      "panel_id": "p24_reclaimed_city",
      "speaker_id": "CHR_023",
      "kind": "ecological_collapse",
      "spoken_text": "Mas a busca sem limites por recursos e as montanhas de lixo destruíram aquele mundo.",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L004_pt_BR.mp3",
      "audio_duration_s": 6.113,
      "camera_target": [
