    },
    {
      "line_id": "CH02_P04_L002",
      "frame_id": "CH02_P04_F02",
      "panel_id": "p24_fungal_garden",
      "speaker_id": "CHR_023",
      "kind": "station_greeting",
      "spoken_text": "Olá, Mika! Meus amigos me contaram muito sobre você. Quem sabe nossa história ajude você a encontrar respostas?",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L002_pt_BR.mp3",
      "audio_duration_s": 8.046,
      "camera_target": [
