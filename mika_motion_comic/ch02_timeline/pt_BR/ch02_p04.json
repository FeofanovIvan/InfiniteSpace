      "panel_id": "p24_station_exterior",
      "speaker_id": "CHR_004",
      "kind": "intro",
      "spoken_text": "A Estação Tarântula é uma nave-laboratório viva da civilização dos fungos.",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L001_pt_BR.mp3",
