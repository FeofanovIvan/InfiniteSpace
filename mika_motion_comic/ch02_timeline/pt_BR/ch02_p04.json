      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "d3b469fcb360bf3b585a4f4d52a76f8bb08906e3056ac9d28e2d54d339a1337f"
    },
    {
      "line_id": "CH02_P04_L005",
      "frame_id": "CH02_P04_F05",
      "panel_id": "p24_fungus_portrait",
      "speaker_id": "CHR_023",
      "kind": "silence",
      "spoken_text": "O planeta ficou deserto. Parecia que a vida tinha desaparecido para sempre…",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L005_pt_BR.mp3",
      "audio_duration_s": 6.113,
      "camera_target": [
