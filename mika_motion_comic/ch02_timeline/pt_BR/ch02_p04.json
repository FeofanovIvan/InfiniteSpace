      "sha256": "a2fb585b6d9dca6bc5b603d1f9e14e1bf33ebda9456d75b0e0a4b8ae439a6007"
    },
    {
      "line_id": "CH02_P04_L006",
      "frame_id": "CH02_P04_F06",
      "panel_id": "p24_meteor",
      "speaker_id": "CHR_023",
      "kind": "meteor_ancestors",
      "spoken_text": "Mais tarde, um meteorito trouxe nossos ancestrais distantes até aqui.",
      "audio_path": "res://mika_motion_comic/ch02_clips/pt_BR/CH02_P04_L006_pt_BR.mp3",
      "audio_duration_s": 5.486,
      "camera_target": [
