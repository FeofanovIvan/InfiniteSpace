      "audio_kind": "voice",
      "sha256": "f55ff13e0c2f8c7a6e66c401b20299915840cf5b68bab529d9c100a2b7d38756"
    },
    {
      "line_id": "CH02_P04_L009",
      "frame_id": "CH02_P04_F08",
      "panel_id": "p24_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "mika_thanks",
      "spoken_text": "Спасибо! Куда теперь?",
