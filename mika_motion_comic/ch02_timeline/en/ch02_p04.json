      "frame_id": "CH02_P04_F04",
      "panel_id": "p24_reclaimed_city",
      "speaker_id": "CHR_023",
      "kind": "ecological_collapse",
      "spoken_text": "But its hunger for resources and mountains of waste destroyed its world.",
