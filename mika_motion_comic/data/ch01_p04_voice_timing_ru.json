    {
      "line_id": "CH01_P04_L001",
      "speaker_id": "CHR_004",
      "panel_id": "p04_mars_landing",
      "start_s": 0.0,
      "end_s": 6.69,
      "text": "Марс. Корабль Мики приземлился у космопорта Центрального дата-центра искусственного интеллекта."
    },
    {
      "line_id": "CH01_P04_L002",
      "speaker_id": "CHR_004",
      "panel_id": "p04_mika_walk",
      "start_s": 7.15,
      "end_s": 10.04,
      "text": "Красная планета встретила Мику песчаной бурей!"
    },
    {
      "line_id": "CH01_P04_L003",
      "speaker_id": "CHR_001",
      "panel_id": "p04_reception",
      "start_s": 10.55,
      "end_s": 13.06,
      "text": "Простите… Можно к ИИ?"
    },
    {
      "line_id": "CH01_P04_L004",
      "speaker_id": "CHR_012",
      "panel_id": "p04_reception",
      "start_s": 13.56,
      "end_s": 16.55,
      "text": "Конечно! Но сначала… пара анкет."
    },
    {
      "line_id": "CH01_P04_L005",
      "speaker_id": "CHR_004",
      "panel_id": "p04_elevator",
      "start_s": 16.93,
      "end_s": 23.67,
      "text": "Даже в будущем от бумажек никуда не деться! Заполнив анкеты, Мика долго ехал на лифте вниз."
    },
    {
      "line_id": "CH01_P04_L006",
      "speaker_id": "CHR_004",
      "panel_id": "p04_ai_core",
      "start_s": 24.16,
      "end_s": 29.45,
      "text": "В сердце Марса открылся огромный зал. Мост вёл к сияющей сфере…"
    },
    {
      "line_id": "CH01_P04_L007",
      "speaker_id": "CHR_013",
      "panel_id": "p04_mika_orb_close",
      "start_s": 30.06,
      "end_s": 30.66,
      "text": "Мика…"
    },
    {
      "line_id": "CH01_P04_L008",
      "speaker_id": "CHR_001",
      "panel_id": "p04_mika_orb_close",
      "start_s": 31.25,
      "end_s": 33.24,
      "text": "Ты… знаешь моё имя?!"
    }
  ]
}
