  "lines": [
    {
      "line_id": "CH01_P02_L001",
      "speaker_id": "CHR_004",
      "panel_id": "wormhole",
      "start_s": 0.0,
      "end_s": 8.02,
      "text": "Mitten im tosenden Sturm entdeckte Mika einen Lichttunnel. Ohne zu wissen, wohin er führte, steuerte Mika auf das Licht zu."
    },
    {
      "line_id": "CH01_P02_L002",
      "speaker_id": "CHR_004",
      "panel_id": "earth_view",
      "start_s": 8.02,
      "end_s": 12.06,
      "text": "Hinter dem Sichtfenster tauchte ein kleiner blauer Planet auf."
    },
    {
      "line_id": "CH01_P02_L003",
      "speaker_id": "CHR_001",
      "panel_id": "earth_view",
      "start_s": 12.06,
      "end_s": 13.44,
      "text": "Ein Planet!"
    },
    {
      "line_id": "CH01_P02_L004",
      "speaker_id": "CHR_004",
      "panel_id": "simulator",
      "start_s": 13.44,
      "end_s": 20.98,
      "text": "Mika stellte den Simulator ein. Nun suchte er Infos über die Bewohner, ihre Sprachen und das Leben auf dem Planeten."
    },
    {
      "line_id": "CH01_P02_L005",
      "speaker_id": "CHR_004",
      "panel_id": "earth_approach",
      "start_s": 20.98,
      "end_s": 28.1,
      "text": "Der Simulator fand den nächsten Raumhafen. Mika nahm Kurs auf die Landung: Dort hoffte er zu erfahren, wo er war."
    },
    {
      "line_id": "CH01_P02_L006",
      "speaker_id": "CHR_001",
      "panel_id": "earth_spaceport",
      "start_s": 28.1,
      "end_s": 31.2,
      "text": "Hm… Wohin soll ich jetzt gehen?"
    }
  ],
