    {
      "line_id": "CH01_P04_L001",
      "speaker_id": "CHR_004",
      "panel_id": "p04_mars_landing",
      "start_s": 0.0,
      "end_s": 6.29,
      "text": "Marte. La nave de Mika aterrizó en el puerto espacial del Centro de Datos de Inteligencia Artificial."
    },
    {
      "line_id": "CH01_P04_L002",
      "speaker_id": "CHR_004",
      "panel_id": "p04_mika_walk",
      "start_s": 6.77,
      "end_s": 10.46,
      "text": "El Planeta Rojo recibió a Mika con ¡una tormenta de arena!"
    },
    {
      "line_id": "CH01_P04_L003",
      "speaker_id": "CHR_001",
      "panel_id": "p04_reception",
      "start_s": 10.95,
      "end_s": 13.33,
      "text": "Disculpe… ¿Puedo ver a la IA?"
    },
    {
      "line_id": "CH01_P04_L004",
      "speaker_id": "CHR_012",
      "panel_id": "p04_reception",
      "start_s": 13.81,
      "end_s": 16.86,
      "text": "¡Claro! Pero antes… unos formularios."
    },
    {
      "line_id": "CH01_P04_L005",
      "speaker_id": "CHR_004",
      "panel_id": "p04_elevator",
      "start_s": 17.16,
      "end_s": 23.07,
      "text": "¡Ni en el futuro se libran del papeleo! Tras llenar los formularios, Mika bajó en ascensor."
    },
    {
      "line_id": "CH01_P04_L006",
      "speaker_id": "CHR_004",
      "panel_id": "p04_ai_core",
      "start_s": 23.64,
      "end_s": 29.45,
      "text": "En el corazón de Marte se abrió una sala inmensa. Un puente llevaba a una esfera…"
    },
    {
      "line_id": "CH01_P04_L007",
      "speaker_id": "CHR_013",
      "panel_id": "p04_mika_orb_close",
      "start_s": 30.06,
      "end_s": 30.72,
      "text": "Mika…"
    },
    {
      "line_id": "CH01_P04_L008",
      "speaker_id": "CHR_001",
      "panel_id": "p04_mika_orb_close",
      "start_s": 31.25,
      "end_s": 32.91,
      "text": "¿Tú… sabes mi nombre?!"
    }
  ]
