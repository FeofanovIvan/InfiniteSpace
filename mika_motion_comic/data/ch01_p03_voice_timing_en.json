  "lines": [
    {
      "line_id": "CH01_P03_L001",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "start_s": 0.0,
      "end_s": 5.52,
      "text": "Hello! Could you please tell me… Where am I?"
    },
    {
      "line_id": "CH01_P03_L002",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_011",
      "kind": "dialogue",
      "start_s": 5.52,
      "end_s": 11.23,
      "text": "Hello there! You’re at Earth’s spaceport. What happened to you?"
    },
    {
      "line_id": "CH01_P03_L003",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "start_s": 11.23,
      "end_s": 18.92,
      "text": "A storm carried me here… And now I have no idea how to get back home."
    },
    {
      "line_id": "CH01_P03_L004",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_011",
      "kind": "dialogue",
      "start_s": 18.92,
      "end_s": 28.4,
      "text": "Oh wow! What a story! We’ll fix up your ship and refuel it. Then head to Mars — to the Central Data Center. The AI there can help you get home!"
    },
    {
      "line_id": "CH01_P03_L005",
      "frame_id": "CH01_P03_F02",
      "panel_id": "p03_mika_upset",
      "speaker_id": "CHR_001",
      "kind": "thought_sigh",
      "start_s": 28.4,
      "end_s": 30.66,
      "text": "Oh… What if I never find my way home?"
    },
    {
      "line_id": "CH01_P03_L006",
      "frame_id": "CH01_P03_F03",
      "panel_id": "p03_ship_refuel",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "start_s": 30.66,
      "end_s": 38.5,
      "text": "The Earth crew sprang into action: they repaired the storm damage, checked every system, and filled the tanks to the brim!"
    },
    {
      "line_id": "CH01_P03_L007",
      "frame_id": "CH01_P03_F04",
      "panel_id": "p03_earth_departure",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "start_s": 38.5,
      "end_s": 43.14,
      "text": "Before long, the ship was ready! Mika thanked the Earth crew, fired up the engines… and took off!"
    },
    {
      "line_id": "CH01_P03_L008",
      "frame_id": "CH01_P03_F05",
      "panel_id": "p03_mars_destination",
      "speaker_id": "CHR_008",
      "kind": "ship_system_hud",
      "start_s": 43.14,
      "end_s": 46.416,
      "text": "Course plotted. Destination: Mars!"
    }
  ]
}
