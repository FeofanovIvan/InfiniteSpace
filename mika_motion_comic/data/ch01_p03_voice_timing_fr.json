  "lines": [
    {
      "line_id": "CH01_P03_L001",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "start_s": 0.0,
      "end_s": 5.83,
      "text": "Bonjour ! Excusez-moi… Pourriez-vous me dire où je suis ?"
    },
    {
      "line_id": "CH01_P03_L002",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_011",
      "kind": "dialogue",
      "start_s": 5.83,
      "end_s": 12.53,
      "text": "Bonjour ! Bienvenue ! Vous êtes au spatioport de la Terre. Un souci ?"
    },
    {
      "line_id": "CH01_P03_L003",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "start_s": 12.53,
      "end_s": 19.6,
      "text": "Une tempête m’a emporté ici… Je ne sais même pas comment rentrer chez moi."
    },
    {
      "line_id": "CH01_P03_L004",
      "frame_id": "CH01_P03_F01",
      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_011",
      "kind": "dialogue",
      "start_s": 19.6,
      "end_s": 28.65,
      "text": "Oh là là ! Quelle aventure ! On va réparer votre vaisseau et faire le plein. Ensuite, filez sur Mars, au Centre de données. L’IA qui s’y trouve saura vous guider !"
    },
    {
      "line_id": "CH01_P03_L005",
      "frame_id": "CH01_P03_F02",
      "panel_id": "p03_mika_upset",
      "speaker_id": "CHR_001",
      "kind": "thought_sigh",
      "start_s": 28.65,
      "end_s": 30.56,
      "text": "Oh… Et si je ne rentrais jamais chez moi ?"
    },
    {
      "line_id": "CH01_P03_L006",
      "frame_id": "CH01_P03_F03",
      "panel_id": "p03_ship_refuel",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "start_s": 30.56,
      "end_s": 38.92,
      "text": "Les Terriens se sont mis au travail : ils ont réparé les dégâts de la tempête, vérifié tous les systèmes et rempli les réservoirs à ras bord !"
    },
    {
      "line_id": "CH01_P03_L007",
      "frame_id": "CH01_P03_F04",
      "panel_id": "p03_earth_departure",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "start_s": 38.92,
      "end_s": 43.05,
      "text": "Enfin, le vaisseau était prêt ! Mika remercia les Terriens, alluma les moteurs… et décolla !"
    },
    {
      "line_id": "CH01_P03_L008",
      "frame_id": "CH01_P03_F05",
      "panel_id": "p03_mars_destination",
      "speaker_id": "CHR_008",
      "kind": "ship_system_hud",
      "start_s": 43.05,
      "end_s": 46.416,
      "text": "Trajet calculé. Direction : Mars !"
    }
  ]
