      "frame_id": 1,
      "speaker_id": "CHR_038",
      "kind": "offscreen_neuron_speech",
      "spoken_text": "Um zu verstehen, wie sie funktionierten, mussten wir die Natur des Universums noch tiefer erforschen.",
      "audio_path": "res://mika_motion_comic/ch06_clips/de/CH06_P03_L002_de.mp3",
