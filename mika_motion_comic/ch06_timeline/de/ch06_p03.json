      "frame_id": 3,
      "speaker_id": "CHR_038",
      "kind": "offscreen_neuron_speech",
      "spoken_text": "Und noch weiter, in den Tiefen des Alls, entdeckten wir ein erstaunliches Artefakt.",
      "audio_path": "res://mika_motion_comic/ch06_clips/de/CH06_P03_L004_de.mp3",
