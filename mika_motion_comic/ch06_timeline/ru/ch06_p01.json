      "transition_style": "pan",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "0319d1ac1171c2c078b4513f4aeadfb3392b570e515efce606129a7088969670"
    },
    {
      "line_id": "CH06_P01_L006",
      "frame_id": "CH06_P01_F05",
      "panel_id": "p61_meeting",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Старые знакомые встретились спустя много лет. Мика не понимал, о чём они говорили, но было ясно: они рады друг другу.",
