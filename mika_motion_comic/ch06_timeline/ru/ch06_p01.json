      "line_id": "CH06_P01_L003",
      "frame_id": "CH06_P01_F02",
      "panel_id": "p61_tunnel",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Корабль Мики влетел в пространственный туннель.",
