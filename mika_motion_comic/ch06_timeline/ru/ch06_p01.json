      "frame_id": "CH06_P01_F03",
      "panel_id": "p61_planet",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "За туннелем их ждала огромная розовая планета.",
      "audio_path": "res://mika_motion_comic/ch06_clips/ru/CH06_P01_L004_ru.mp3",
      "audio_duration_s": 3.970612,
      "camera_target": [
