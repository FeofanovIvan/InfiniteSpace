      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "4ff07b3650b647c8df676f33fe2bbb457e885cfbb82f66773eda973801bc719f"
    },
    {
