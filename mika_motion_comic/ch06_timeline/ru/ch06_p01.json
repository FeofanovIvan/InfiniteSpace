      "panel_id": "p61_cabin",
      "speaker_id": "CHR_035",
      "kind": "dialogue",
      "spoken_text": "Нам туда!",
      "audio_path": "res://mika_motion_comic/ch06_clips/ru/CH06_P01_L002_ru.mp3",
