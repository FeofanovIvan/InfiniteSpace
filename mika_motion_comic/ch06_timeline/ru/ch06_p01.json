      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "audio_kind": "voice",
      "sha256": "a21ef846d5cac2be507a779f0b74a00d84295d312ca2acc718fdbf9669b6c4df"
    },
    {
      "line_id": "CH06_P01_L005",
      "frame_id": "CH06_P01_F04",
      "panel_id": "p61_city",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Мир нейронных существ сильно отличался от всего, что они видели раньше.",
      "audio_path": "res://mika_motion_comic/ch06_clips/ru/CH06_P01_L005_ru.mp3",
      "audio_duration_s": 4.989388,
      "camera_target": [
        0.501302,
