      "frame_id": 1,
      "speaker_id": "CHR_038",
      "kind": "offscreen_neuron_speech",
      "spoken_text": "Pour comprendre comment elles fonctionnaient, nous avons dû étudier la nature de l’Univers encore plus profondément.",
