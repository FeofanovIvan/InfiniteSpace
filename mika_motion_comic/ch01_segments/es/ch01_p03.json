      "panel_id": "p03_puzzle_reveal",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Una tormenta me trajo hasta aquí… Y ahora no tengo ni idea de cómo volver a casa.",
