  "lines": [
    {
      "line_id": "CH01_P07_L001",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "En el astillero de Calisto, Mika dejó su nave en manos de expertos.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L001_es.mp3",
      "audio_duration_s": 4.32,
      "camera_target": [
        0.29,
        0.117,
        0.185
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Общий план ангара: корабль, инженеры и Мика"
    },
    {
      "line_id": "CH01_P07_L002",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_016",
      "kind": "speech_engineer",
      "spoken_text": "El casco está bien… Pero este motor de ondas no soporta ese salto.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L002_es.mp3",
      "audio_duration_s": 4.88,
      "camera_target": [
        0.209,
        0.131,
        0.123
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Инженер слева, двигатель и корпус"
    },
    {
      "line_id": "CH01_P07_L003",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_017",
      "kind": "speech_engineer",
      "spoken_text": "¿Cómo sobrevivió a esa tormenta cósmica?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L003_es.mp3",
      "audio_duration_s": 3.04,
      "camera_target": [
        0.385,
        0.153,
        0.115
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Инженер справа и корабль"
    },
    {
      "line_id": "CH01_P07_L004",
      "frame_id": "CH01_P07_F02",
      "panel_id": "p07_mika_staff",
      "speaker_id": "CHR_001",
      "kind": "speech_pleading",
      "spoken_text": "¿Por qué no puedo seguir? ¡Necesito llegar a otra galaxia!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L004_es.mp3",
      "audio_duration_s": 4.0,
      "camera_target": [
        0.66,
        0.119,
        0.112
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика обращается к сотруднице"
    },
    {
      "line_id": "CH01_P07_L005",
      "frame_id": "CH01_P07_F02",
      "panel_id": "p07_mika_staff",
      "speaker_id": "CHR_018",
      "kind": "speech_service",
      "spoken_text": "Lo siento, Mika. Tu nave no resistiría ese salto. Lo revisamos todo… aquí no podemos ayudarte.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L005_es.mp3",
      "audio_duration_s": 8.16,
      "camera_target": [
        0.827,
        0.08,
        0.115
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Сотрудница отвечает; лицо важнее нижней подписи"
    },
    {
      "line_id": "CH01_P07_L006",
      "frame_id": "CH01_P07_F03",
      "panel_id": "p07_mika_worried",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika se desanimó. ¿De verdad el camino a casa terminaría allí?..",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L006_es.mp3",
      "audio_duration_s": 4.88,
      "camera_target": [
        0.358,
        0.333,
        0.164
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Расстроенный Мика за столом"
    },
    {
      "line_id": "CH01_P07_L007",
      "frame_id": "CH01_P07_F03",
      "panel_id": "p07_mika_worried",
      "speaker_id": "CHR_015",
      "kind": "speech_offscreen",
      "spoken_text": "¡Eh, joven viajero! Creo que sé cómo ayudarte!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L007_es.mp3",
      "audio_duration_s": 3.68,
      "camera_target": [
        0.358,
        0.333,
        0.164
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Профессор за кадром; остаёмся на реакции Мики"
    },
    {
      "line_id": "CH01_P07_L008",
      "frame_id": "CH01_P07_F04",
      "panel_id": "p07_professor_arrives",
      "speaker_id": "CHR_004",
      "kind": "narration_intro",
      "spoken_text": "El profesor: un genio incomprendido de Calisto.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L008_es.mp3",
      "audio_duration_s": 4.0,
      "camera_target": [
        0.834,
        0.27,
        0.113
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо профессора; реплики окружающих остаются на рисунке"
    },
    {
      "line_id": "CH01_P07_L012",
      "frame_id": "CH01_P07_F05",
      "panel_id": "p07_professor_talks",
      "speaker_id": "CHR_015",
      "kind": "speech_inventor",
      "spoken_text": "Pondremos un desfasador cuántico en el núcleo de ondas. Doblará el espacio… ¡y daremos un salto hasta otra galaxia!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L012_es.mp3",
      "audio_duration_s": 7.36,
      "camera_target": [
        0.386,
        0.48,
        0.132
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Профессор объясняет; лицо и жест"
    },
    {
      "line_id": "CH01_P07_L013",
      "frame_id": "CH01_P07_F05",
      "panel_id": "p07_professor_talks",
      "speaker_id": "CHR_001",
      "kind": "speech_bewildered",
      "spoken_text": "Eh… ¿qué?",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L013_es.mp3",
      "audio_duration_s": 1.6,
      "camera_target": [
        0.177,
        0.516,
        0.109
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Реакция Мики"
    },
    {
      "line_id": "CH01_P07_L014",
      "frame_id": "CH01_P07_F06",
      "panel_id": "p07_ship_repair",
      "speaker_id": "CHR_001",
      "kind": "thought",
      "spoken_text": "Ojalá de verdad sepa lo que está haciendo… ¡Cruzo los dedos!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L014_es.mp3",
      "audio_duration_s": 4.4,
      "camera_target": [
        0.771,
        0.536,
        0.148
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мысль Мики; тот же кадр ремонта, затем искры"
    },
    {
      "line_id": "SFX_CH01_P07_F06_SPARKS",
      "frame_id": "CH01_P07_F06",
      "panel_id": "p07_ship_repair",
      "speaker_id": "CHR_015",
      "kind": "nonverbal_sfx",
      "spoken_text": "",
      "audio_path": "res://mika_motion_comic/ch01_clips/sfx/SFX_CH01_P07_F06_SPARKS.mp3",
      "audio_duration_s": 0.65,
      "camera_target": [
        0.771,
        0.536,
        0.148
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика, профессор и ремонт корабля; неречевые искры"
    },
    {
      "line_id": "CH01_P07_L015",
      "frame_id": "CH01_P07_F07",
      "panel_id": "p07_lmc_window",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Tras pruebas, dudas y un montón de chispas, ¡por fin modernizaron la nave!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L015_es.mp3",
      "audio_duration_s": 5.52,
      "camera_target": [
        0.5,
        0.788,
        0.31
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Общий план экипажа после модернизации"
    },
    {
      "line_id": "CH01_P07_L016",
      "frame_id": "CH01_P07_F07",
      "panel_id": "p07_lmc_window",
      "speaker_id": "CHR_004",
      "kind": "narration_supplies",
      "spoken_text": "Antes de partir, nuestros amigos repusieron sus provisiones y salieron. ¡Les esperaba un largo viaje!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P07_L016_es.mp3",
      "audio_duration_s": 6.56,
      "camera_target": [
        0.5,
