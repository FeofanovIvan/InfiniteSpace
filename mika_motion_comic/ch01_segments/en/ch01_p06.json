  "lines": [
    {
      "line_id": "CH01_P06_L001",
      "frame_id": "CH01_P06_F01",
      "panel_id": "p06_pink_vortex",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "It looks like the storm came from gravitational, magnetic, and spatial anomalies.",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P06_L001_en.mp3",
      "audio_duration_s": 6.0343,
      "camera_target": [
        0.219,
        0.089,
        0.15
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Вихрь и планета"
    },
    {
      "line_id": "CH01_P06_L002",
      "frame_id": "CH01_P06_F02",
      "panel_id": "p06_mika_thinks",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "It may have spread beyond your world— perhaps across the entire galaxy. We can’t tell how far.",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P06_L002_en.mp3",
      "audio_duration_s": 6.9224,
      "camera_target": [
        0.66,
        0.124,
        0.165
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо Мики и сфера ИИ"
    },
    {
      "line_id": "CH01_P06_L003",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "But in the part of the universe I can observe, there isn’t even an echo of that storm…",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P06_L003_en.mp3",
      "audio_duration_s": 5.9559,
      "camera_target": [
        0.26,
        0.299,
        0.158
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик слева"
    },
    {
      "line_id": "CH01_P06_L004",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Try reaching the Large Magellanic Cloud. Ask the people there what they know. Who knows? The answers to tomorrow may hide in yesterday…",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P06_L004_en.mp3",
      "audio_duration_s": 9.4041,
      "camera_target": [
        0.385,
        0.3,
        0.158
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик справа"
    },
    {
      "line_id": "CH01_P06_L005",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "And I have a gift for you!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P06_L005_en.mp3",
      "audio_duration_s": 2.0376,
      "camera_target": [
        0.805,
        0.284,
        0.155
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика слушает ИИ"
    },
    {
      "line_id": "CH01_P06_L006",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "dialogue_delighted_question",
      "spoken_text": "Really?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P06_L006_en.mp3",
      "audio_duration_s": 1.071,
      "camera_target": [
