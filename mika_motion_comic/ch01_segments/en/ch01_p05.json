    {
      "line_id": "CH01_P05_L005",
      "frame_id": "CH01_P05_F02",
      "panel_id": "p05_mika_happy",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika closed his eyes. His home came alive again before him…",
