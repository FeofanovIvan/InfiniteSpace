    {
      "line_id": "CH01_P05_L003",
      "frame_id": "CH01_P05_F01",
      "panel_id": "p05_mika_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Tell me about your home. What was it like?",
