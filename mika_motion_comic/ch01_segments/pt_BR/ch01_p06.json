  "lines": [
    {
      "line_id": "CH01_P06_L001",
      "frame_id": "CH01_P06_F01",
      "panel_id": "p06_pink_vortex",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Pelo visto, o temporal veio de anomalias gravitacionais, magnéticas e espaciais.",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P06_L001_pt_BR.mp3",
      "audio_duration_s": 6.7657,
      "camera_target": [
        0.219,
        0.089,
        0.15
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Вихрь и планета"
    },
    {
      "line_id": "CH01_P06_L002",
      "frame_id": "CH01_P06_F02",
      "panel_id": "p06_mika_thinks",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Ele pode ter atingido muito mais que seu lar: talvez a galáxia inteira. Ainda não sabemos até onde chegou.",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P06_L002_pt_BR.mp3",
      "audio_duration_s": 7.0792,
      "camera_target": [
        0.66,
        0.124,
        0.165
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо Мики и сфера ИИ"
    },
    {
      "line_id": "CH01_P06_L003",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Mas, na parte do universo que consigo observar, não encontro nem um eco dessa tempestade…",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P06_L003_pt_BR.mp3",
      "audio_duration_s": 6.9224,
      "camera_target": [
        0.26,
        0.299,
        0.158
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик слева"
    },
    {
      "line_id": "CH01_P06_L004",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Vá até a Grande Nuvem de Magalhães. Converse com quem mora por lá. Vai saber… Talvez as respostas do futuro estejam no passado.",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P06_L004_pt_BR.mp3",
      "audio_duration_s": 8.5159,
      "camera_target": [
        0.385,
        0.3,
        0.158
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик справа"
    },
    {
      "line_id": "CH01_P06_L005",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Ah, e tenho um presente pra você!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P06_L005_pt_BR.mp3",
      "audio_duration_s": 2.6906,
      "camera_target": [
