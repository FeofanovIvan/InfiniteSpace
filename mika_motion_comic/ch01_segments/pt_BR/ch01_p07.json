  "lines": [
    {
      "line_id": "CH01_P07_L001",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "No estaleiro de Calisto, Mika deixou sua nave nas mãos dos técnicos.",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L001_pt_BR.mp3",
      "audio_duration_s": 4.88,
      "camera_target": [
        0.29,
        0.117,
        0.185
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Общий план ангара: корабль, инженеры и Мика"
    },
    {
      "line_id": "CH01_P07_L002",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_016",
      "kind": "speech_engineer",
      "spoken_text": "O casco está ótimo… Mas o motor de ondas não aguenta esse salto!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L002_pt_BR.mp3",
      "audio_duration_s": 4.96,
      "camera_target": [
        0.209,
        0.131,
        0.123
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Инженер слева, двигатель и корпус"
    },
    {
      "line_id": "CH01_P07_L003",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_017",
      "kind": "speech_engineer",
      "spoken_text": "Como ela sobreviveu àquela tempestade?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L003_pt_BR.mp3",
      "audio_duration_s": 2.88,
      "camera_target": [
        0.385,
        0.153,
        0.115
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Инженер справа и корабль"
    },
    {
      "line_id": "CH01_P07_L004",
      "frame_id": "CH01_P07_F02",
      "panel_id": "p07_mika_staff",
      "speaker_id": "CHR_001",
      "kind": "speech_pleading",
      "spoken_text": "Por que não posso seguir? Eu preciso chegar a outra galáxia!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L004_pt_BR.mp3",
      "audio_duration_s": 3.76,
      "camera_target": [
        0.66,
        0.119,
        0.112
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика обращается к сотруднице"
    },
    {
      "line_id": "CH01_P07_L005",
      "frame_id": "CH01_P07_F02",
      "panel_id": "p07_mika_staff",
      "speaker_id": "CHR_018",
      "kind": "speech_service",
      "spoken_text": "Sinto muito, Mika. Sua nave não aguentaria esse salto. Testamos de tudo… mas não dá pra ajudar.",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L005_pt_BR.mp3",
      "audio_duration_s": 7.84,
      "camera_target": [
        0.827,
        0.08,
        0.115
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Сотрудница отвечает; лицо важнее нижней подписи"
    },
    {
      "line_id": "CH01_P07_L006",
      "frame_id": "CH01_P07_F03",
      "panel_id": "p07_mika_worried",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika ficou arrasado. Será que o caminho de volta terminava ali mesmo?..",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L006_pt_BR.mp3",
      "audio_duration_s": 4.96,
      "camera_target": [
        0.358,
        0.333,
        0.164
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Расстроенный Мика за столом"
    },
    {
      "line_id": "CH01_P07_L007",
      "frame_id": "CH01_P07_F03",
      "panel_id": "p07_mika_worried",
      "speaker_id": "CHR_015",
      "kind": "speech_offscreen",
      "spoken_text": "Ei, jovem viajante! Acho que eu sei como te ajudar!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L007_pt_BR.mp3",
      "audio_duration_s": 3.76,
      "camera_target": [
        0.358,
        0.333,
        0.164
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Профессор за кадром; остаёмся на реакции Мики"
    },
    {
      "line_id": "CH01_P07_L008",
      "frame_id": "CH01_P07_F04",
      "panel_id": "p07_professor_arrives",
      "speaker_id": "CHR_004",
      "kind": "narration_intro",
      "spoken_text": "Era o professor: um gênio incompreendido de Calisto.",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L008_pt_BR.mp3",
      "audio_duration_s": 4.56,
      "camera_target": [
        0.834,
        0.27,
        0.113
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо профессора; реплики окружающих остаются на рисунке"
    },
    {
      "line_id": "CH01_P07_L012",
      "frame_id": "CH01_P07_F05",
      "panel_id": "p07_professor_talks",
      "speaker_id": "CHR_015",
      "kind": "speech_inventor",
      "spoken_text": "Vamos acoplar um deslocador quântico de fase ao núcleo de ondas. Dobramos o espaço… e pulamos de galáxia!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L012_pt_BR.mp3",
      "audio_duration_s": 7.12,
      "camera_target": [
        0.386,
        0.48,
        0.132
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Профессор объясняет; лицо и жест"
    },
    {
      "line_id": "CH01_P07_L013",
      "frame_id": "CH01_P07_F05",
      "panel_id": "p07_professor_talks",
      "speaker_id": "CHR_001",
      "kind": "speech_bewildered",
      "spoken_text": "Hã… como é?",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L013_pt_BR.mp3",
      "audio_duration_s": 1.76,
      "camera_target": [
        0.177,
        0.516,
        0.109
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Реакция Мики"
    },
    {
      "line_id": "CH01_P07_L014",
      "frame_id": "CH01_P07_F06",
      "panel_id": "p07_ship_repair",
      "speaker_id": "CHR_001",
      "kind": "thought",
      "spoken_text": "Tomara que ele saiba mesmo o que faz… Vai dar tudo certo?",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L014_pt_BR.mp3",
      "audio_duration_s": 4.72,
      "camera_target": [
        0.771,
        0.536,
        0.148
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мысль Мики; тот же кадр ремонта, затем искры"
    },
    {
      "line_id": "SFX_CH01_P07_F06_SPARKS",
      "frame_id": "CH01_P07_F06",
      "panel_id": "p07_ship_repair",
      "speaker_id": "CHR_015",
      "kind": "nonverbal_sfx",
      "spoken_text": "",
      "audio_path": "res://mika_motion_comic/ch01_clips/sfx/SFX_CH01_P07_F06_SPARKS.mp3",
      "audio_duration_s": 0.65,
      "camera_target": [
        0.771,
        0.536,
        0.148
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика, профессор и ремонт корабля; неречевые искры"
    },
    {
      "line_id": "CH01_P07_L015",
      "frame_id": "CH01_P07_F07",
      "panel_id": "p07_lmc_window",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Depois de testes, dúvidas e muitas faíscas, a nave enfim ficou pronta para o salto!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L015_pt_BR.mp3",
      "audio_duration_s": 6.24,
      "camera_target": [
        0.5,
        0.788,
        0.31
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Общий план экипажа после модернизации"
    },
    {
      "line_id": "CH01_P07_L016",
      "frame_id": "CH01_P07_F07",
      "panel_id": "p07_lmc_window",
      "speaker_id": "CHR_004",
      "kind": "narration_supplies",
      "spoken_text": "Antes de partir, os amigos reabasteceram a nave e seguiram viagem. Uma longa jornada os esperava!",
      "audio_path": "res://mika_motion_comic/ch01_clips/pt_BR/CH01_P07_L016_pt_BR.mp3",
      "audio_duration_s": 7.04,
      "camera_target": [
