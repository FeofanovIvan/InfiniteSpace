      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Шторм и разрушение города"
    },
    {
      "line_id": "CH01_P05_L008",
      "frame_id": "CH01_P05_F05",
      "panel_id": "p05_mika_worried",
      "speaker_id": "CHR_001",
      "kind": "speech_recollection",
      "spoken_text": "Alles veränderte sich. Städte verloren ihre Form. Alle mussten fliehen!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L008_de.mp3",
