      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Испуганный Мика"
    },
    {
      "line_id": "CH01_P05_L007",
      "frame_id": "CH01_P05_F04",
      "panel_id": "p05_red_city",
      "speaker_id": "CHR_001",
      "kind": "speech_recollection",
      "spoken_text": "PLÖTZLICH… EIN STURM BRACH LOS!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L007_de.mp3",
