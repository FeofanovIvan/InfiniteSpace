      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика на фоне эвакуации"
    },
    {
      "line_id": "CH01_P05_L009",
      "frame_id": "CH01_P05_F06",
      "panel_id": "p05_mika_sad",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Ich konnte fliehen… Und jetzt bin ich hier.",
