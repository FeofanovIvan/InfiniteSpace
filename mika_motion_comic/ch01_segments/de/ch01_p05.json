        0.198
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Панорама родного города"
    },
    {
      "line_id": "CH01_P05_L006",
      "frame_id": "CH01_P05_F03",
      "panel_id": "p05_mika_shocked",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Aber dann…",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L006_de.mp3",
