      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "ИИ и Мика, начало диалога"
    },
    {
      "line_id": "CH01_P05_L002",
      "frame_id": "CH01_P05_F01",
      "panel_id": "p05_mika_orb",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Hilfst du mir herauszufinden, was mit meiner Heimat ist, und den Rückweg zu finden?",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L002_de.mp3",
      "audio_duration_s": 4.8327,
      "camera_target": [
        0.295,
        0.169,
        0.205
      ],
      "transition_before_s": 0.28,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и планшет"
    },
    {
      "line_id": "CH01_P05_L003",
      "frame_id": "CH01_P05_F01",
      "panel_id": "p05_mika_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Erzähl mir von zu Hause. Wie war es dort?",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L003_de.mp3",
      "audio_duration_s": 3.2392,
      "camera_target": [
        0.698,
        0.14,
        0.216
      ],
      "transition_before_s": 0.28,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Сфера ИИ и вопрос"
    },
    {
      "line_id": "CH01_P05_L005",
      "frame_id": "CH01_P05_F02",
      "panel_id": "p05_mika_happy",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika schloss die Augen. Seine Heimat erwachte vor ihm erneut…",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L005_de.mp3",
      "audio_duration_s": 4.5192,
      "camera_target": [
        0.231,
        0.383,
        0.17
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика с закрытыми глазами"
    },
    {
      "line_id": "CH01_P05_L004",
      "frame_id": "CH01_P05_F02",
      "panel_id": "p05_pink_city",
      "speaker_id": "CHR_001",
      "kind": "speech_recollection",
      "spoken_text": "Wir lebten auf einem riesigen rosa Gasplaneten. Unsere Städte schwebten über den Wolken!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P05_L004_de.mp3",
      "audio_duration_s": 6.191,
      "camera_target": [
        0.718,
