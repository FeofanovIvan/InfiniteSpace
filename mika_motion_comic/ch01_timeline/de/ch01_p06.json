      "frame_id": "CH01_P06_F07",
      "panel_id": "p06_mika_bubble_runs",
      "speaker_id": "CHR_004",
      "kind": "narration_comic_reveal",
      "spoken_text": "Doch die KI vergaß zu sagen: Bubble braucht Fürsorge… Und wie jedes Lebewesen hat er Schwächen!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L011_de.mp3",
