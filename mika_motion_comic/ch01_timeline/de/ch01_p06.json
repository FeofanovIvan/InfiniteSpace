      "panel_id": "p06_mika_bubble_runs",
      "speaker_id": "CHR_001",
      "kind": "speech_panic",
      "spoken_text": "Igitt, Bubble! Ich warte im Shuttle!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L010_de.mp3",
      "audio_duration_s": 3.5527,
