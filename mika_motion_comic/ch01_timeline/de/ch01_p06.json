      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика реагирует на сигнал"
    },
    {
      "line_id": "CH01_P06_L009",
      "frame_id": "CH01_P06_F06",
      "panel_id": "p06_bubble_elevator",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Bubble ist ein lebendiger KI-Helfer. Und er braucht jede Menge Energie!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L009_de.mp3",
