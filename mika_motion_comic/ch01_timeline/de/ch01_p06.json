  "lines": [
    {
      "line_id": "CH01_P06_L001",
      "frame_id": "CH01_P06_F01",
      "panel_id": "p06_pink_vortex",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Vermutlich lösten Gravitations-, Magnet- und Raumanomalien den Sturm aus.",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L001_de.mp3",
      "audio_duration_s": 5.329,
      "camera_target": [
        0.219,
        0.089,
        0.15
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Вихрь и планета"
    },
    {
      "line_id": "CH01_P06_L002",
      "frame_id": "CH01_P06_F02",
      "panel_id": "p06_mika_thinks",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Er könnte nicht nur deine Welt, sondern die ganze Galaxie erfasst haben. Wie weit genau, wissen wir nicht.",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L002_de.mp3",
      "audio_duration_s": 6.609,
      "camera_target": [
        0.66,
        0.124,
        0.165
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо Мики и сфера ИИ"
    },
    {
      "line_id": "CH01_P06_L003",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Doch in dem Teil des Universums, den ich untersuchen kann, finde ich nicht einmal ein Echo des Sturms…",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L003_de.mp3",
      "audio_duration_s": 6.8441,
      "camera_target": [
        0.26,
        0.299,
        0.158
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик слева"
    },
    {
      "line_id": "CH01_P06_L004",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Flieg zur Großen Magellanschen Wolke. Frag dort nach dem Sturm. Und wer weiß… Vielleicht liegt der Schlüssel zur Zukunft in der Vergangenheit.",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L004_de.mp3",
      "audio_duration_s": 9.169,
      "camera_target": [
        0.385,
        0.3,
        0.158
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик справа"
    },
    {
      "line_id": "CH01_P06_L005",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Und ich habe ein Geschenk für dich!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L005_de.mp3",
      "audio_duration_s": 2.1943,
      "camera_target": [
        0.805,
        0.284,
        0.155
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика слушает ИИ"
    },
    {
      "line_id": "CH01_P06_L006",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "dialogue_delighted_question",
      "spoken_text": "Wirklich?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L006_de.mp3",
      "audio_duration_s": 1.3061,
      "camera_target": [
        0.775,
        0.32,
        0.155
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Радостное лицо Мики"
    },
    {
      "line_id": "CH01_P06_L007",
      "frame_id": "CH01_P06_F05",
      "panel_id": "p06_orb_whole",
      "speaker_id": "CHR_014",
      "kind": "nonverbal_offscreen_sfx",
      "spoken_text": "PIEP-PIEP! PIIIEP!",
      "audio_path": "res://mika_motion_comic/ch01_clips/de/CH01_P06_L007_de.mp3",
      "audio_duration_s": 0.9404,
      "camera_target": [
        0.337,
