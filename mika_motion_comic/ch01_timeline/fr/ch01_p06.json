      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика реагирует на сигнал"
    },
    {
      "line_id": "CH01_P06_L009",
      "frame_id": "CH01_P06_F06",
      "panel_id": "p06_bubble_elevator",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Bubble est un être vivant, doté d’une IA. Et il a besoin de beaucoup d’énergie !",
