  "lines": [
    {
      "line_id": "CH01_P06_L001",
      "frame_id": "CH01_P06_F01",
      "panel_id": "p06_pink_vortex",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "On dirait que la tempête est née d’anomalies gravitationnelles, magnétiques et spatiales.",
      "audio_path": "res://mika_motion_comic/ch01_clips/fr/CH01_P06_L001_fr.mp3",
      "audio_duration_s": 5.4073,
      "camera_target": [
        0.219,
        0.089,
        0.15
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Вихрь и планета"
    },
    {
      "line_id": "CH01_P06_L002",
      "frame_id": "CH01_P06_F02",
      "panel_id": "p06_mika_thinks",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Elle a peut-être frappé bien au-delà de chez toi, voire toute la galaxie. Mais son étendue exacte reste inconnue.",
      "audio_path": "res://mika_motion_comic/ch01_clips/fr/CH01_P06_L002_fr.mp3",
      "audio_duration_s": 6.8441,
      "camera_target": [
        0.66,
        0.124,
        0.165
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо Мики и сфера ИИ"
    },
    {
      "line_id": "CH01_P06_L003",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Mais dans la partie de l’Univers que je peux observer, pas le moindre écho de cette tempête…",
      "audio_path": "res://mika_motion_comic/ch01_clips/fr/CH01_P06_L003_fr.mp3",
      "audio_duration_s": 5.4857,
      "camera_target": [
        0.26,
        0.299,
        0.158
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик слева"
    },
    {
      "line_id": "CH01_P06_L004",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Va dans le Grand Nuage de Magellan. Interroge ceux qui y vivent. Qui sait… Les réponses pour l’avenir se cachent peut-être dans le passé.",
      "audio_path": "res://mika_motion_comic/ch01_clips/fr/CH01_P06_L004_fr.mp3",
      "audio_duration_s": 8.8294,
      "camera_target": [
        0.385,
        0.3,
        0.158
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик справа"
    },
    {
      "line_id": "CH01_P06_L005",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Et j’ai un cadeau pour toi !",
      "audio_path": "res://mika_motion_comic/ch01_clips/fr/CH01_P06_L005_fr.mp3",
      "audio_duration_s": 1.8808,
      "camera_target": [
        0.805,
        0.284,
        0.155
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика слушает ИИ"
    },
    {
      "line_id": "CH01_P06_L006",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "dialogue_delighted_question",
      "spoken_text": "Vraiment ?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/fr/CH01_P06_L006_fr.mp3",
      "audio_duration_s": 1.071,
      "camera_target": [
        0.775,
