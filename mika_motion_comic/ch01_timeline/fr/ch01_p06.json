      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и Баббл, подпись вторична"
    },
    {
      "line_id": "CH01_P06_L012",
      "frame_id": "CH01_P06_F08",
      "panel_id": "p06_ship_departure",
      "speaker_id": "CHR_004",
