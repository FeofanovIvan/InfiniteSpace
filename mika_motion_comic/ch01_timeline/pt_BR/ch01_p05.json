      "frame_id": "CH01_P05_F02",
      "panel_id": "p05_mika_happy",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika fechou os olhos. Seu mundo voltou a ganhar vida diante dele…",
