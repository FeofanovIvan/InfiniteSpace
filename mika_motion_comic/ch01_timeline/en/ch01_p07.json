  "lines": [
    {
      "line_id": "CH01_P07_L001",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "At Callisto Shipyard, Mika trusted the experts with his little ship.",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L001_en.mp3",
      "audio_duration_s": 4.48,
      "camera_target": [
        0.29,
        0.117,
        0.185
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Общий план ангара: корабль, инженеры и Мика"
    },
    {
      "line_id": "CH01_P07_L002",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_016",
      "kind": "speech_engineer",
      "spoken_text": "The hull is sound… But this wave engine is too weak for that jump!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L002_en.mp3",
      "audio_duration_s": 4.56,
      "camera_target": [
        0.209,
        0.131,
        0.123
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Инженер слева, двигатель и корпус"
    },
    {
      "line_id": "CH01_P07_L003",
      "frame_id": "CH01_P07_F01",
      "panel_id": "p07_station_hangar",
      "speaker_id": "CHR_017",
      "kind": "speech_engineer",
      "spoken_text": "How did it even survive that cosmic storm?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L003_en.mp3",
      "audio_duration_s": 3.28,
      "camera_target": [
        0.385,
        0.153,
        0.115
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Инженер справа и корабль"
    },
    {
      "line_id": "CH01_P07_L004",
      "frame_id": "CH01_P07_F02",
      "panel_id": "p07_mika_staff",
      "speaker_id": "CHR_001",
      "kind": "speech_pleading",
      "spoken_text": "Why can’t I go on? I need to reach another galaxy!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L004_en.mp3",
      "audio_duration_s": 4.08,
      "camera_target": [
        0.66,
        0.119,
        0.112
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика обращается к сотруднице"
    },
    {
      "line_id": "CH01_P07_L005",
      "frame_id": "CH01_P07_F02",
      "panel_id": "p07_mika_staff",
      "speaker_id": "CHR_018",
      "kind": "speech_service",
      "spoken_text": "I’m sorry, Mika. Your ship wouldn’t survive that jump. We checked everything… but we can’t fix it here.",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L005_en.mp3",
      "audio_duration_s": 7.76,
      "camera_target": [
        0.827,
        0.08,
        0.115
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Сотрудница отвечает; лицо важнее нижней подписи"
    },
    {
      "line_id": "CH01_P07_L006",
      "frame_id": "CH01_P07_F03",
      "panel_id": "p07_mika_worried",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika’s heart sank. Could his journey home really end right here?..",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L006_en.mp3",
      "audio_duration_s": 5.2,
      "camera_target": [
        0.358,
        0.333,
        0.164
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Расстроенный Мика за столом"
    },
    {
      "line_id": "CH01_P07_L007",
      "frame_id": "CH01_P07_F03",
      "panel_id": "p07_mika_worried",
      "speaker_id": "CHR_015",
      "kind": "speech_offscreen",
      "spoken_text": "Hey, young traveler! I think I know how to help you!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L007_en.mp3",
      "audio_duration_s": 3.68,
      "camera_target": [
        0.358,
        0.333,
        0.164
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Профессор за кадром; остаёмся на реакции Мики"
    },
    {
      "line_id": "CH01_P07_L008",
      "frame_id": "CH01_P07_F04",
      "panel_id": "p07_professor_arrives",
      "speaker_id": "CHR_004",
      "kind": "narration_intro",
      "spoken_text": "The professor: Callisto’s brilliant but unsung genius.",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L008_en.mp3",
      "audio_duration_s": 4.72,
      "camera_target": [
        0.834,
        0.27,
        0.113
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо профессора; реплики окружающих остаются на рисунке"
    },
    {
      "line_id": "CH01_P07_L012",
      "frame_id": "CH01_P07_F05",
      "panel_id": "p07_professor_talks",
      "speaker_id": "CHR_015",
      "kind": "speech_inventor",
      "spoken_text": "Add a quantum phase shifter to the wave core. It’ll bend space itself— and we’ll hop straight into another galaxy!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L012_en.mp3",
      "audio_duration_s": 7.04,
      "camera_target": [
        0.386,
        0.48,
        0.132
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Профессор объясняет; лицо и жест"
    },
    {
      "line_id": "CH01_P07_L013",
      "frame_id": "CH01_P07_F05",
      "panel_id": "p07_professor_talks",
      "speaker_id": "CHR_001",
      "kind": "speech_bewildered",
      "spoken_text": "Uh… what?",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L013_en.mp3",
      "audio_duration_s": 1.84,
      "camera_target": [
        0.177,
        0.516,
        0.109
      ],
      "transition_before_s": 0.3,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Реакция Мики"
    },
    {
      "line_id": "CH01_P07_L014",
      "frame_id": "CH01_P07_F06",
      "panel_id": "p07_ship_repair",
      "speaker_id": "CHR_001",
      "kind": "thought",
      "spoken_text": "I hope he really knows what he’s doing… Fingers crossed!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L014_en.mp3",
      "audio_duration_s": 4.56,
      "camera_target": [
        0.771,
        0.536,
        0.148
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
