      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика, профессор и ремонт корабля; неречевые искры"
    },
    {
      "line_id": "CH01_P07_L015",
      "frame_id": "CH01_P07_F07",
      "panel_id": "p07_lmc_window",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "After days of trials, doubts and flying sparks, they finally upgraded Mika’s ship!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L015_en.mp3",
      "audio_duration_s": 6.32,
      "camera_target": [
