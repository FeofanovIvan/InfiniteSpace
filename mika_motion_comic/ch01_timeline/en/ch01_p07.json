      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Общий план экипажа после модернизации"
    },
    {
      "line_id": "CH01_P07_L016",
      "frame_id": "CH01_P07_F07",
      "panel_id": "p07_lmc_window",
      "speaker_id": "CHR_004",
      "kind": "narration_supplies",
      "spoken_text": "Before takeoff, our friends restocked and set off. A long journey was waiting for them!",
      "audio_path": "res://mika_motion_comic/ch01_clips/en/CH01_P07_L016_en.mp3",
