      "frame_id": "CH01_P05_F01",
      "panel_id": "p05_mika_orb",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "¿Me ayudas a descubrir qué pasó con mi hogar y cómo regresar?",
