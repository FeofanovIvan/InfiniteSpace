      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Сфера ИИ и вопрос"
    },
    {
      "line_id": "CH01_P05_L005",
      "frame_id": "CH01_P05_F02",
      "panel_id": "p05_mika_happy",
      "speaker_id": "CHR_004",
      "kind": "narration",
      "spoken_text": "Mika cerró los ojos. Su mundo volvió a cobrar vida ante él…",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P05_L005_es.mp3",
      "audio_duration_s": 4.911,
