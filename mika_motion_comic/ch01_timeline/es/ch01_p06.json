  "lines": [
    {
      "line_id": "CH01_P06_L001",
      "frame_id": "CH01_P06_F01",
      "panel_id": "p06_pink_vortex",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Parece que la tormenta nació de anomalías gravitacionales, magnéticas y espaciales.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L001_es.mp3",
      "audio_duration_s": 5.8776,
      "camera_target": [
        0.219,
        0.089,
        0.15
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Вихрь и планета"
    },
    {
      "line_id": "CH01_P06_L002",
      "frame_id": "CH01_P06_F02",
      "panel_id": "p06_mika_thinks",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Tal vez alcanzó mucho más que tu mundo: ¡quizá toda la galaxia! Aún no sabemos qué tan lejos llegó.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L002_es.mp3",
      "audio_duration_s": 7.471,
      "camera_target": [
        0.66,
        0.124,
        0.165
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо Мики и сфера ИИ"
    },
    {
      "line_id": "CH01_P06_L003",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Pero en la parte del universo que puedo observar, no hay ni un eco de esa tormenta…",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L003_es.mp3",
      "audio_duration_s": 5.9559,
      "camera_target": [
        0.26,
        0.299,
        0.158
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик слева"
    },
    {
      "line_id": "CH01_P06_L004",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Ve a la Gran Nube de Magallanes. Pregunta a quienes viven allí. Quizá… las respuestas sobre el futuro estén en el pasado.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L004_es.mp3",
      "audio_duration_s": 8.751,
      "camera_target": [
        0.385,
        0.3,
        0.158
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик справа"
    },
    {
      "line_id": "CH01_P06_L005",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Y tengo un regalo para ti.",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L005_es.mp3",
      "audio_duration_s": 2.2727,
      "camera_target": [
        0.805,
        0.284,
        0.155
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика слушает ИИ"
    },
    {
      "line_id": "CH01_P06_L006",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "dialogue_delighted_question",
      "spoken_text": "¿En serio?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L006_es.mp3",
      "audio_duration_s": 1.2278,
      "camera_target": [
        0.775,
        0.32,
        0.155
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Радостное лицо Мики"
    },
    {
      "line_id": "CH01_P06_L007",
      "frame_id": "CH01_P06_F05",
      "panel_id": "p06_orb_whole",
      "speaker_id": "CHR_014",
      "kind": "nonverbal_offscreen_sfx",
      "spoken_text": "¡BIP-BIP! ¡BIIIIP!",
      "audio_path": "res://mika_motion_comic/ch01_clips/es/CH01_P06_L007_es.mp3",
      "audio_duration_s": 0.9404,
      "camera_target": [
        0.337,
