        0.186
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Сфера и источник сигнала"
    },
    {
      "line_id": "CH01_P06_L008",
      "frame_id": "CH01_P06_F05",
      "panel_id": "p06_orb_whole",
      "speaker_id": "CHR_001",
      "kind": "speech_question_surprise",
      "spoken_text": "А?! Что это?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L008_ru.mp3",
      "audio_duration_s": 1.8808,
      "camera_target": [
        0.315,
