  "lines": [
    {
      "line_id": "CH01_P06_L001",
      "frame_id": "CH01_P06_F01",
      "panel_id": "p06_pink_vortex",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Похоже, шторм вызвали гравитационные, магнитные и пространственные аномалии.",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L001_ru.mp3",
      "audio_duration_s": 6.0343,
      "camera_target": [
        0.219,
        0.089,
        0.15
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Вихрь и планета"
    },
    {
      "line_id": "CH01_P06_L002",
      "frame_id": "CH01_P06_F02",
      "panel_id": "p06_mika_thinks",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Буря могла охватить не только твой мир, но и всю галактику. Её точный масштаб нам пока неизвестен.",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L002_ru.mp3",
      "audio_duration_s": 7.0008,
      "camera_target": [
        0.66,
        0.124,
        0.165
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Лицо Мики и сфера ИИ"
    },
    {
      "line_id": "CH01_P06_L003",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Но в той части Вселенной, которую я могу изучить, нет даже отголоска этой бури…",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L003_ru.mp3",
      "audio_duration_s": 5.9559,
      "camera_target": [
        0.26,
        0.299,
        0.158
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик слева"
    },
    {
      "line_id": "CH01_P06_L004",
      "frame_id": "CH01_P06_F03",
      "panel_id": "p06_galaxies_in_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Попробуй добраться до Большого Магелланова Облака. Расспроси его жителей. А вдруг ответы о будущем спрятаны в прошлом?..",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L004_ru.mp3",
      "audio_duration_s": 8.0457,
      "camera_target": [
        0.385,
        0.3,
        0.158
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и карта галактик справа"
    },
    {
      "line_id": "CH01_P06_L005",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "А у меня для тебя есть подарок!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L005_ru.mp3",
      "audio_duration_s": 2.351,
      "camera_target": [
        0.805,
        0.284,
        0.155
      ],
      "transition_before_s": 0.0,
      "transition_style": "cut",
      "voice_start_rule": "after_camera_presented_and_sfx_finished",
      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика слушает ИИ"
    },
    {
      "line_id": "CH01_P06_L006",
      "frame_id": "CH01_P06_F04",
      "panel_id": "p06_mika_smiles",
      "speaker_id": "CHR_001",
      "kind": "dialogue_delighted_question",
      "spoken_text": "Правда?!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L006_ru.mp3",
      "audio_duration_s": 1.1494,
      "camera_target": [
        0.775,
        0.32,
        0.155
      ],
      "transition_before_s": 0.26,
      "transition_style": "pan",
