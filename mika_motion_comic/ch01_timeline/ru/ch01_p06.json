      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика и Баббл, подпись вторична"
    },
    {
      "line_id": "CH01_P06_L012",
      "frame_id": "CH01_P06_F08",
      "panel_id": "p06_ship_departure",
      "speaker_id": "CHR_004",
      "kind": "narration_adventure",
      "spoken_text": "И вот наши друзья отправились в путь!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L012_ru.mp3",
