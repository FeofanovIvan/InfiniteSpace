    {
      "line_id": "CH01_P06_L010",
      "frame_id": "CH01_P06_F07",
      "panel_id": "p06_mika_bubble_runs",
      "speaker_id": "CHR_001",
      "kind": "speech_panic",
      "spoken_text": "Фу-у, Баббл! Я подожду тебя в шаттле!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P06_L010_ru.mp3",
