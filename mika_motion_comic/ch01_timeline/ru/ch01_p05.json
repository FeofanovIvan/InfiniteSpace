      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "Мика с закрытыми глазами"
    },
    {
      "line_id": "CH01_P05_L004",
      "frame_id": "CH01_P05_F02",
      "panel_id": "p05_pink_city",
      "speaker_id": "CHR_001",
      "kind": "speech_recollection",
      "spoken_text": "Мы жили на огромном розовом газовом гиганте. А наши города парили над облаками!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P05_L004_ru.mp3",
      "audio_duration_s": 6.5306,
      "camera_target": [
