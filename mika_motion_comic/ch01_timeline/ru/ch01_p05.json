      "camera_visible_lead_s": 0.12,
      "transition_sfx_path": "",
      "transition_sfx_volume_db": -6.0,
      "direction_note": "ИИ и Мика, начало диалога"
    },
    {
      "line_id": "CH01_P05_L002",
      "frame_id": "CH01_P05_F01",
      "panel_id": "p05_mika_orb",
      "speaker_id": "CHR_001",
      "kind": "dialogue",
      "spoken_text": "Поможешь мне понять, что стало с моим домом, и найти дорогу назад?",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P05_L002_ru.mp3",
      "audio_duration_s": 4.5976,
      "camera_target": [
        0.295,
