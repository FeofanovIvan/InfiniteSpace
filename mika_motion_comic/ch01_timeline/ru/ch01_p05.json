      "panel_id": "p05_mika_orb",
      "speaker_id": "CHR_013",
      "kind": "ai_core_voice",
      "spoken_text": "Конечно! Ты же сам указал своё имя в анкете!",
      "audio_path": "res://mika_motion_comic/ch01_clips/ru/CH01_P05_L001_ru.mp3",
