      "line_id": "CH01_P05_L008",
      "frame_id": "CH01_P05_F05",
      "panel_id": "p05_mika_worried",
      "speaker_id": "CHR_001",
      "kind": "speech_recollection",
      "spoken_text": "Мир менялся. Города теряли форму. Началась срочная эвакуация!",
