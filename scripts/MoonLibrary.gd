static func make_moon(moon_id: String, diameter: float) -> Node2D:
	var packed: PackedScene = MOON_SCENES.get(moon_id, null) as PackedScene
	var texture: Texture2D = MOON_TEXTURES.get(moon_id, null) as Texture2D
	if texture == null:
		push_error("Missing individual moon surface: " + moon_id)
		return null
	if packed == null:
		push_error("Missing individual moon scene: " + moon_id)
		return null
	var instance: Node2D = packed.instantiate() as Node2D
	if instance == null:
		push_error("Moon is not Node2D: " + moon_id)
		return null
	instance.name = "Moon_" + moon_id
	instance.set("diameter_pixels", diameter)
	return instance
