#!/usr/bin/env python3
"""Godot-independent V24 validation: uncut originals and Sun flyby geometry."""
from pathlib import Path
import hashlib, math, re, struct
P = Path(__file__).resolve().parents[1]
main = (P/'scripts/Main.gd').read_text()
comic = (P/'scripts/ComicPrologue.gd').read_text()
solar = (P/'scripts/SolarSystem.gd').read_text()
assert 'STORY_SUN_ORBIT_SWEEP: float = 4.363323129985824' in main
assert 'STORY_SUN_ELLIPSE_RADIUS: Vector2 = Vector2(430.0, 310.0)' in main
assert '_story_move_to(target_world, _story_focus_on_sun(_intro_time))' in main
assert '_story_hermite(' in main and 'STORY_WAYPOINT_TIMES' not in main
assert 'solar_system.earth_world_position()' in main
assert 'npc_traffic.z_index = 10' in main and 'ship.z_index = 15' in main
assert 'ship.rotation = _ship_heading' in main
assert 'get_viewport_rect().size * 0.5 - _camera_offset + shake' in main
assert 'ship.scale = Vector2.ONE * maxf(0.018' in main
assert 'func set_progress' in (P/'scripts/StoryLandingSmoke.gd').read_text()
assert 'TextureRect.STRETCH_SCALE' in comic and 'minf(_view_size.x / image_size.x, _view_size.y / image_size.y)' in comic
assert 'KEY_ESCAPE' in comic and 'skipped.emit()' in comic
originals=sorted((P/'assets/prologue_original').glob('*.png'))
assert len(originals)==7, originals
for i,item in enumerate(originals):
    raw=item.read_bytes()
    assert raw[:8]==b'\x89PNG\r\n\x1a\n' and raw[12:16]==b'IHDR'
    width,height=struct.unpack('>II',raw[16:24]);assert width>=700 and height>=700
    assert f'"res://assets/prologue_original/{item.name}"' in comic
    assert (P/'assets/prologue_original/backdrops'/f'{item.stem}.jpg').is_file()
assert not list((P/'assets/prologue').glob('*.png'))
# Model mirrors the GDScript path numerically: positive speed, true orbit,
# Sun never hit, and passes across every quadrant around it.
T1,T2,T3=5.4,13.2,16.4
start=math.radians(35); sweep=math.radians(250)
def ellipse(t):
    angle=start+sweep*min(1,max(0,(t-T1)/(T2-T1)))
    return (430*math.cos(angle),310*math.sin(angle))
def v_ellipse(t):
    angle=start+sweep*min(1,max(0,(t-T1)/(T2-T1)))
    omega=sweep/(T2-T1)
    return (-430*math.sin(angle)*omega,310*math.cos(angle)*omega)
def herm(a,b,va,vb,t0,t1,t):
    u=min(1,max(0,(t-t0)/(t1-t0)))
    h00=2*u**3-3*u**2+1;h10=u**3-2*u*u+u
    h01=-2*u**3+3*u*u;h11=u**3-u*u
    return tuple(h00*a[i]+h10*(t1-t0)*va[i]+h01*b[i]+h11*(t1-t0)*vb[i] for i in (0,1))
def location(t):
    if t<=T1: return herm((6260,-2840),ellipse(T1),(-1260,660),v_ellipse(T1),0,T1,t)
    if t<=T2: return ellipse(t)
    earth=(565*math.cos(math.tau*t/180),565*math.sin(math.tau*t/180))
    exit=ellipse(T2);target=(earth[0]-12,earth[1]-25)
    delta=(target[0]-exit[0],target[1]-exit[1]);dl=math.hypot(*delta)
    final=(delta[0]/dl*440-earth[1]*math.tau/180,delta[1]/dl*440+earth[0]*math.tau/180)
    return herm(exit,target,v_ellipse(T2),final,T2,T3,t)
points=[location(i*T3/1600) for i in range(1601)]
min_speed=min(math.dist(a,b)/(T3/1600) for a,b in zip(points,points[1:]))
min_sun=min(math.hypot(*p) for p in points)
assert min_speed>110,(min_speed,min_sun)
assert min_sun>300,min_sun
angles=[start+sweep*i/100 for i in range(101)]
assert (max(angles)-min(angles))>math.pi and len({(math.cos(x)>0,math.sin(x)>0) for x in angles})==4
# Cheap resource integrity / mixed indentation regression
for f in (P/'scripts').glob('*.gd'):
    data=f.read_text()
    kinds={('tab' if ln.startswith('\t') else 'space') for ln in data.splitlines() if ln and ln[0] in '\t '}
    assert len(kinds)<=1,(f,kinds)
    for path in re.findall(r'preload\("res://([^"\n]+)"\)',data):
        assert (P/path).is_file(),(f,path)
print('PASS V24: seven complete uncut pictures; no PDF cuts; 250-degree ellipse entirely around the Sun; continuous positive velocity (min %.1f px/s); clear solar radius (min %.1f); camera focus; Earth impact; correct drawing order; static GDScript resources' % (min_speed,min_sun))
