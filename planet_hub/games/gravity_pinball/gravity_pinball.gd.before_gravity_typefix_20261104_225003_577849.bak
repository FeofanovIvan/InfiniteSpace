		"score": "Punkte",
		"best": "Bestwert",
		"status_ready": "Bereit zum Start",
		"status_flying": "Asteroid im Flug",
		"status_lost": "Verloren. RESET drücken",
		"reset": "RESET",
		"lang": "Sprache",
		"notes": "Technischer Prototyp: Hintergrund, Planeten und Asteroiden durch echte InfiniteSpace-Assets ersetzen."
	},
	"fr": {
		"title": "PINBALL GRAVITATIONNEL",
		"subtitle": "Lance l'astéroïde et garde-le dans le champ planétaire",
		"launch": "Glisse depuis l'anneau → direction et puissance",
		"score": "Score",
		"best": "Meilleur",
		"status_ready": "Prêt à lancer",
		"status_flying": "Astéroïde en vol",
		"status_lost": "Perdu. Appuie sur RESET",
		"reset": "RESET",
		"lang": "Langue",
		"notes": "Maquette technique : remplacer le fond, les planètes et l'astéroïde par les assets réels d'InfiniteSpace."
	}
}

var current_lang := "ru"
var score := 0.0
var best_score := 0.0
var flying := false
var lost := false

var launch_anchor := Vector2(180, 585)
var asteroid_pos := Vector2.ZERO
var asteroid_vel := Vector2.ZERO
var asteroid_radius := 11.0
var asteroid_glow := 0.0
var max_power := 420.0
var dragging := false
var drag_current := Vector2.ZERO
var selected_lang_buttons := {}

var planets := [
	{"name":"A","pos":Vector2(510, 215), "radius":36.0, "mass":1800.0, "color":Color("4bc0ff")},
	{"name":"B","pos":Vector2(760, 345), "radius":48.0, "mass":2600.0, "color":Color("8b7dff")},
	{"name":"C","pos":Vector2(1020, 210), "radius":30.0, "mass":1500.0, "color":Color("f7a24a")},
	{"name":"D","pos":Vector2(920, 520), "radius":40.0, "mass":2100.0, "color":Color("65d7b5")}
]
var checkpoints := [
	{"pos":Vector2(640,160), "taken":false},
	{"pos":Vector2(850,140), "taken":false},
	{"pos":Vector2(1080,360), "taken":false},
	{"pos":Vector2(700,560), "taken":false}
]

var title_label: Label
var subtitle_label: Label
var score_label: Label
var best_label: Label
var status_label: Label
var launch_label: Label
var notes_label: RichTextLabel
var lang_box: HBoxContainer
var reset_button: Button

func _ready() -> void:
	asteroid_pos = launch_anchor
	drag_current = launch_anchor
	_build_ui()
	_apply_language()
	set_process(true)

func _build_ui() -> void:
	title_label = _make_label(28, Color("eff8ff"))
	title_label.position = Vector2(28, 18)
	add_child(title_label)
	
	subtitle_label = _make_label(16, Color("9dc4df"))
	subtitle_label.position = Vector2(30, 52)
	add_child(subtitle_label)
	
	score_label = _make_label(20, Color("9ce6ff"))
	score_label.position = Vector2(1020, 24)
	add_child(score_label)
	best_label = _make_label(18, Color("a7d5ef"))
	best_label.position = Vector2(1020, 52)
	add_child(best_label)
	status_label = _make_label(18, Color("ffe58e"))
	status_label.position = Vector2(30, 88)
	add_child(status_label)
	launch_label = _make_label(16, Color("d6efff"))
	launch_label.position = Vector2(30, 114)
	add_child(launch_label)
	
	reset_button = Button.new()
	reset_button.position = Vector2(1090, 88)
	reset_button.size = Vector2(140, 40)
	reset_button.focus_mode = Control.FOCUS_NONE
	reset_button.pressed.connect(_reset_round)
	reset_button.add_theme_font_size_override("font_size", 16)
	reset_button.add_theme_color_override("font_color", Color.WHITE)
	reset_button.add_theme_stylebox_override("normal", _style_box(Color("1a3a5d"), Color("64c8ff"), 16))
	reset_button.add_theme_stylebox_override("hover", _style_box(Color("204770"), Color("9de7ff"), 16))
	add_child(reset_button)
	
	var lang_title := _make_label(14, Color("9dc4df"))
	lang_title.position = Vector2(28, 658)
	lang_title.name = "LangTitle"
	add_child(lang_title)
	
	lang_box = HBoxContainer.new()
	lang_box.position = Vector2(90, 648)
	lang_box.add_theme_constant_override("separation", 6)
	add_child(lang_box)
	for code in ["ru","en","pt","es","de","fr"]:
		var b := Button.new()
		b.text = code.to_upper()
		b.custom_minimum_size = Vector2(52, 30)
		b.focus_mode = Control.FOCUS_NONE
		b.pressed.connect(func(): current_lang = code; _apply_language())
		lang_box.add_child(b)
		selected_lang_buttons[code] = b
	
	notes_label = RichTextLabel.new()
	notes_label.position = Vector2(390, 628)
	notes_label.size = Vector2(850, 70)
	notes_label.scroll_active = false
	notes_label.bbcode_enabled = true
	notes_label.fit_content = true
	notes_label.add_theme_font_size_override("normal_font_size", 13)
	add_child(notes_label)

func _make_label(size_pt: int, color: Color) -> Label:
	var l := Label.new()
	l.add_theme_font_size_override("font_size", size_pt)
	l.add_theme_color_override("font_color", color)
	return l

func _style_box(fill: Color, border: Color, radius: int) -> StyleBoxFlat:
	var sb := StyleBoxFlat.new()
	sb.bg_color = fill
	sb.border_color = border
	sb.set_border_width_all(2)
	sb.set_corner_radius_all(radius)
	return sb

func _apply_language() -> void:
	var t = LANGS[current_lang]
	title_label.text = t.title
	subtitle_label.text = t.subtitle
	launch_label.text = t.launch
	reset_button.text = t.reset
	$LangTitle.text = t.lang + ":"
	notes_label.text = "[color=#9ec0da]" + t.notes + "[/color]"
	for code in selected_lang_buttons.keys():
		var b: Button = selected_lang_buttons[code]
		var active := code == current_lang
		b.add_theme_stylebox_override("normal", _style_box(Color("17314a") if not active else Color("245b80"), Color("4ea5ff") if not active else Color("b6f0ff"), 14))
	_update_labels()

func _update_labels() -> void:
	var t = LANGS[current_lang]
	score_label.text = "%s: %d" % [t.score, int(score)]
	best_label.text = "%s: %d" % [t.best, int(best_score)]
	if lost:
		status_label.text = t.status_lost
	elif flying:
		status_label.text = t.status_flying
	else:
		status_label.text = t.status_ready

func _reset_round() -> void:
	flying = false
	lost = false
	score = 0
	asteroid_pos = launch_anchor
	asteroid_vel = Vector2.ZERO
	asteroid_glow = 0.0
	for c in checkpoints:
		c.taken = false
	_update_labels()
	queue_redraw()

func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed and not flying:
			var d = event.position.distance_to(launch_anchor)
			if d < 58:
				dragging = true
				drag_current = event.position
		elif not event.pressed and dragging:
			dragging = false
			_launch_from_drag()
	elif event is InputEventMouseMotion and dragging:
		drag_current = event.position
		queue_redraw()

func _launch_from_drag() -> void:
	var delta := launch_anchor - drag_current
	var power := clamp(delta.length(), 0.0, max_power)
	if power < 16.0:
		return
		
	var dir := delta.normalized()
	asteroid_vel = dir * (power * 1.55)
	asteroid_pos = launch_anchor
	flying = true
	lost = false
	score = 0
	for c in checkpoints:
		c.taken = false
	_update_labels()
	queue_redraw()

func _process(delta: float) -> void:
	if flying:
		var acc := Vector2.ZERO
		for p in planets:
			var offset: Vector2 = p.pos - asteroid_pos
			var r2 := max(offset.length_squared(), 3600.0)
			acc += offset.normalized() * (p.mass / r2) * 180.0
		asteroid_vel += acc * delta
		asteroid_pos += asteroid_vel * delta
		asteroid_glow = min(1.0, asteroid_glow + delta * 2.0)
		score += delta * 12.0
		for c in checkpoints:
			if not c.taken and asteroid_pos.distance_to(c.pos) < 26:
				c.taken = true
				score += 35.0
		# bounce on bounds
		var bounced := false
		if asteroid_pos.x < 12 or asteroid_pos.x > size.x - 12:
			asteroid_vel.x *= -0.96
			bounced = true
		if asteroid_pos.y < 132 or asteroid_pos.y > size.y - 26:
			asteroid_vel.y *= -0.96
			bounced = true
		if bounced:
			score += 4.0
		# collision with planets
		for p in planets:
			var rr = p.radius + asteroid_radius
			if asteroid_pos.distance_to(p.pos) < rr:
				var n = (asteroid_pos - p.pos).normalized()
				asteroid_pos = p.pos + n * rr
				asteroid_vel = asteroid_vel.bounce(n) * 0.96
				score += 8.0
		# lose conditions
		if asteroid_vel.length() < 18.0 or asteroid_pos.y > size.y + 80 or asteroid_pos.x < -80 or asteroid_pos.x > size.x + 80:
			flying = false
			lost = true
			best_score = max(best_score, score)
	_update_labels()
	queue_redraw()

func _draw() -> void:
	var r = Rect2(Vector2.ZERO, size)
	draw_rect(r, Color("07111e"), true)
	# placeholder cosmos backdrop
	for i in range(120):
		var p = Vector2(float((i * 97) % 1280), float((i * 53) % 720))
		draw_circle(p, 1.2 + float(i % 3) * 0.5, Color(0.9,0.95,1.0,0.35))
	draw_circle(Vector2(210, 210), 190, Color("132c53", 0.22))
	draw_circle(Vector2(1020, 240), 220, Color("1b2748", 0.18))
	# playfield panel
	_draw_round(Rect2(18, 146, size.x - 36, 470), 28, Color("0c1c31"), true)
	_draw_round(Rect2(18, 146, size.x - 36, 470), 28, Color("30577d"), false, 2)
	# minimap placeholder
	_draw_minimap(Rect2(1040, 156, 190, 122))
	# launch device
	_draw_launch_ring()
	# checkpoints
	for c in checkpoints:
		var col = Color("80ffe8") if not c.taken else Color("ffe97c")
		draw_arc(c.pos, 18, 0, TAU, 36, col, 3.0)
		draw_circle(c.pos, 4, col)
	# planets
	for p in planets:
		_draw_planet(p)
	# asteroid
	_draw_asteroid()
	# trajectory + power while dragging
	if dragging and not flying:
		var vec = launch_anchor - drag_current
		var power = clamp(vec.length(), 0.0, max_power)
		var dir = vec.normalized()
		var endpoint = launch_anchor + dir * min(140.0, power * 0.45)
		draw_line(launch_anchor, endpoint, Color("ffe58e"), 4.0)
		draw_circle(endpoint, 7, Color("ffd46b"))
		_draw_power_meter(power / max_power)

func _draw_round(rect: Rect2, rad: int, color: Color, filled: bool, width := 1) -> void:
	var sb := StyleBoxFlat.new()
	sb.set_corner_radius_all(rad)
	if filled:
		sb.bg_color = color
	else:
		sb.bg_color = Color(0,0,0,0)
		sb.border_color = color
		sb.set_border_width_all(width)
	draw_style_box(sb, rect)

func _draw_planet(p: Dictionary) -> void:
	draw_circle(p.pos, p.radius + 14, Color(p.color.r, p.color.g, p.color.b, 0.10))
	draw_circle(p.pos, p.radius, p.color)
	draw_arc(p.pos, p.radius + 8, 0, TAU, 52, Color(1,1,1,0.16), 2.0)
	draw_string(ThemeDB.fallback_font, p.pos + Vector2(-6, 6), str(p.name), HORIZONTAL_ALIGNMENT_LEFT, -1, 18, Color("eff8ff"))

func _draw_launch_ring() -> void:
	draw_circle(launch_anchor, 46, Color("123451"))
	draw_arc(launch_anchor, 46, 0, TAU, 60, Color("68ccff"), 3.0)
	draw_circle(launch_anchor, 20, Color("9aeaff"))
	# sling arms
	draw_line(launch_anchor + Vector2(-32, -20), launch_anchor + Vector2(-52, 24), Color("85d6ff"), 4)
	draw_line(launch_anchor + Vector2(32, -20), launch_anchor + Vector2(52, 24), Color("85d6ff"), 4)
	draw_line(launch_anchor + Vector2(-52, 24), launch_anchor + Vector2(52, 24), Color("4da8da"), 3)

func _draw_asteroid() -> void:
	var col = Color("d8c6ad")
	draw_circle(asteroid_pos, asteroid_radius + asteroid_glow * 4.0, Color(1.0, 0.8, 0.45, 0.12))
	draw_circle(asteroid_pos, asteroid_radius, col)
	draw_circle(asteroid_pos + Vector2(-4,-3), 3.5, Color("ae9980"))
	draw_circle(asteroid_pos + Vector2(5,2), 2.2, Color("a68f74"))
	if flying:
		var tail = asteroid_pos - asteroid_vel.normalized() * min(34.0, asteroid_vel.length() * 0.06)
		draw_line(asteroid_pos, tail, Color("ffd483", 0.65), 3.0)

func _draw_power_meter(t: float) -> void:
	var outer = Rect2(28, 566, 240, 18)
	_draw_round(outer, 10, Color("17314a"), true)
	_draw_round(outer, 10, Color("4f99c8"), false, 2)
	var inner = Rect2(32, 570, (outer.size.x - 8) * t, 10)
	_draw_round(inner, 8, Color("ffd873"), true)

func _draw_minimap(rect: Rect2) -> void:
	_draw_round(rect, 18, Color("102238"), true)
	_draw_round(rect, 18, Color("4f7aa2"), false, 2)
	# placeholder note area + scaled bodies
	var sun_pos = rect.position + Vector2(32, 60)
	draw_circle(sun_pos, 14, Color("ffbe66"))
	draw_circle(sun_pos, 26, Color(1,0.75,0.36,0.10))
	for p in planets:
		var scale = Vector2((p.pos.x - 140) / 6.8, (p.pos.y - 120) / 6.0)
		var pp = rect.position + Vector2(22, 18) + scale
		draw_circle(pp, max(3.0, p.radius * 0.12), p.color)
	# asteroid dot
	var aa = rect.position + Vector2(22, 18) + Vector2((asteroid_pos.x - 140) / 6.8, (asteroid_pos.y - 120) / 6.0)
	draw_circle(aa, 3.2, Color("fff3c7"))
	draw_string(ThemeDB.fallback_font, rect.position + Vector2(16, 18), "MINI", HORIZONTAL_ALIGNMENT_LEFT, -1, 14, Color("dceeff"))
