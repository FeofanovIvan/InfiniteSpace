		"notes": "Protótipo técnico: substituir fundo, planetas e asteroides pelos assets reais do InfiniteSpace."
	},
	"es": {
		"title": "PINBALL GRAVITACIONAL",
		"subtitle": "Lanza el asteroide y mantenlo dentro del campo planetario",
		"launch": "Arrastra desde el anillo → dirección y fuerza",
		"score": "Puntos",
		"best": "Mejor",
		"status_ready": "Listo para lanzar",
		"status_flying": "Asteroide en vuelo",
		"status_lost": "Perdido. Pulsa RESET",
