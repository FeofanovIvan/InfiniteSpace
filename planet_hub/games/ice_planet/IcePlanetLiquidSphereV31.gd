extends Control
## Shader-free living ocean sphere. Every painted pixel is generated by Godot
## CanvasItem commands: no white ColorRect fallback, no fragment shader.
## Ambient currents rotate with yaw while vertical flow responds to pitch.

var ocean_yaw: float = 0.0
var ocean_pitch: float = 0.0
var hot_factor: float = 0.0
var ice_factor: float = 0.0
var flare_factor: float = 0.0
var elapsed: float = 0.0

func update_world(yaw: float, pitch: float, heat: float, freeze: float, flare: float, time_value: float) -> void:
    ocean_yaw = yaw
    ocean_pitch = pitch
    hot_factor = clampf(heat, 0.0, 1.0)
    ice_factor = clampf(freeze, 0.0, 1.0)
    flare_factor = clampf(flare, 0.0, 1.0)
    elapsed = time_value
    queue_redraw()

func _draw() -> void:
    if size.x < 4.0 or size.y < 4.0:
        return
    var center: Vector2 = size * 0.5
    var radius: float = minf(size.x, size.y) * 0.419
    # The main disc stays an unmistakable deep-blue sphere without materials.
    draw_circle(center, radius + 2.5, Color("87e3ff"))
    draw_circle(center, radius, Color("071c47"))
    draw_circle(center + Vector2(-radius * 0.055, -radius * 0.045), radius * 0.94, Color("123c78"))
    draw_circle(center + Vector2(-radius * 0.13, -radius * 0.11), radius * 0.82, Color("1379b1"))
    draw_circle(center + Vector2(-radius * 0.18, -radius * 0.17), radius * 0.63, Color("1b9fcb"))

    # Internal ocean streams, clipped analytically to the spherical silhouette.
    # Their different rhythms make the texture visibly turn in both axes.
    for band in range(13):
        var points: PackedVector2Array = PackedVector2Array()
        var offset: float = float(band) - 6.0
        for part in range(81):
            var x: float = (-0.92 + float(part) * 1.84 / 80.0) * radius
            var max_height: float = sqrt(maxf(radius * radius - x * x, 0.0)) - 4.0
            var yy: float = offset * radius * 0.135 + sin(x * 0.060 + ocean_yaw * 2.1 + float(band) * 0.71) * radius * 0.070
            yy += sin(x * 0.030 - elapsed * 0.75 + ocean_pitch * 2.4 + band) * radius * 0.030
            yy += sin(ocean_pitch + float(band) * 0.55) * radius * 0.055
            if absf(yy) <= max_height:
                points.append(center + Vector2(x, yy))
            elif points.size() > 1:
                _stream(points, band)
                points = PackedVector2Array()
        if points.size() > 1:
            _stream(points, band)

    # Orbiting pearl-like eddies make reversal/vertical steering visually obvious.
    for index in range(10):
        var phase: float = ocean_yaw + float(index) * 2.399 + elapsed * (0.09 + 0.015 * float(index % 3))
        var lat: float = ocean_pitch * 1.4 + float(index) * 1.83
        var position: Vector2 = center + Vector2(sin(phase) * radius * 0.66, sin(lat) * radius * 0.54)
        var spot_radius: float = radius * (0.028 + 0.009 * float(index % 3))
        if position.distance_to(center) < radius - spot_radius * 1.4:
            var alpha: float = 0.25 + 0.25 * (1.0 + cos(phase)) * 0.5
            draw_circle(position, spot_radius * 2.1, Color(0.46, 0.91, 1.0, alpha * 0.23))
            draw_circle(position, spot_radius, Color(0.48, 0.98, 1.0, alpha))

    # Opposing climate stresses remain constrained INSIDE the circular boundary.
    # Red comes from the sun-facing left, white-blue ice from the far right.
    for step in range(100):
        var x: float = -radius + (float(step) + 0.5) * radius * 2.0 / 100.0
        var max_height: float = sqrt(maxf(radius * radius - x * x, 0.0))
        var heat_strength: float = hot_factor * clampf((-x / radius + 0.45) / 1.12, 0.0, 1.0)
        var cold_strength: float = ice_factor * clampf((x / radius + 0.45) / 1.12, 0.0, 1.0)
        var melt: Color = Color(1.0, 0.25 + 0.15 * sin(x * 0.05 + elapsed), 0.07, heat_strength * 0.82)
        var frost: Color = Color(0.84, 0.96, 1.0, cold_strength * 0.91)
        if heat_strength > 0.005:
            draw_line(center + Vector2(x, -max_height), center + Vector2(x, max_height), melt, radius * 2.0 / 100.0 + 1.0)
        if cold_strength > 0.005:
            draw_line(center + Vector2(x, -max_height), center + Vector2(x, max_height), frost, radius * 2.0 / 100.0 + 1.0)

    # Rising bubbles belong to boiling water, with no square texture overlay.
    if hot_factor > 0.03:
        for k in range(21):
            var t: float = fposmod(float(k) * 0.173 + elapsed * (0.27 + float(k % 4) * 0.04), 1.0)
            var px: float = -radius * (0.15 + 0.72 * fposmod(float(k) * 0.413, 1.0))
            var py: float = radius * (0.8 - 1.6 * t)
            var pt: Vector2 = center + Vector2(px, py)
            var bubble_radius: float = radius * (0.022 + float(k % 3) * 0.008)
            if pt.distance_to(center) + bubble_radius < radius * 0.98:
                draw_arc(pt, bubble_radius, 0.0, TAU, 20, Color(1.0, 0.88, 0.66, hot_factor * (1.0-t) * 0.92), 1.5, true)

    # Irregular ice fractures and white crystallization on the cold hemisphere.
    if ice_factor > 0.03:
        for k in range(14):
            var px: float = radius * (0.10 + 0.70 * fposmod(float(k) * 0.293, 1.0))
            var py: float = radius * (-0.75 + 1.50 * fposmod(float(k) * 0.471, 1.0))
            var base: Vector2 = center + Vector2(px, py)
            if base.distance_to(center) < radius * 0.85:
                var reach: float = 5.0 + 8.0 * ice_factor
                draw_line(base - Vector2(0, reach), base + Vector2(0, reach), Color(0.98, 1.0, 1.0, 0.75 * ice_factor), 1.4, true)
                draw_line(base - Vector2(reach * 0.65, 0), base + Vector2(reach * 0.65, 0), Color(0.94, 1.0, 1.0, 0.64 * ice_factor), 1.4, true)

    # Globe shading and controlled atmospheric rim (never a rectangular quad).
    draw_arc(center, radius - 1.2, -PI * 0.53, PI * 0.49, 90, Color(0.01, 0.05, 0.19, 0.38), radius * 0.12, true)
    draw_arc(center, radius - 1.0, -PI * 0.88, PI * 0.12, 90, Color(0.78, 0.96, 1.0, 0.74), radius * 0.027, true)
    draw_arc(center, radius + 3.5, -PI * 0.72, PI * 0.72, 64, Color(0.19 + flare_factor * 0.30, 0.74, 1.0, 0.43), 2.4, true)

func _stream(points: PackedVector2Array, band: int) -> void:
    var tone: Color = Color("8eecff") if band % 3 == 0 else Color("2bc0e9") if band % 3 == 1 else Color("174d9b")
    tone.a = 0.30 if band % 3 == 0 else 0.45
    draw_polyline(points, tone, 2.6 if band % 3 == 0 else 3.3, true)
