extends Control
## Vector-only equation and progressive learning model; no PNG fonts or external art.

const WHITE := Color("#edf9ff")
const CYAN := Color("#82dfff")
const MINT := Color("#76edc9")
const GOLD := Color("#ffdc93")
const ROSE := Color("#f2a5da")
const DULL := Color("#496c8c")
const INK := Color("#0b1930")

var exercise: Dictionary = {}
var hint_step := 0
var clock := 0.0
var solved := false

func set_exercise(value: Dictionary, step: int = 0, done: bool = false) -> void:
	exercise = value
	hint_step = step
	solved = done
	queue_redraw()

func _process(delta: float) -> void:
	clock += delta
	queue_redraw()

func _draw() -> void:
	if exercise.is_empty():
		return
	var w := size.x
	var h := size.y
	# Gentle neural web and three holographic anchor points
	for i in range(4):
		var start := Vector2(20, 48 + i * 63)
		var finish := Vector2(w - 20, 48 + (3 - i) * 63)
		draw_line(start, finish, Color(0.22, 0.55, 0.72, 0.07), 2)
		for j in range(3):
			var p := start.lerp(finish, (float(j) + 1.0) / 4.0)
			draw_circle(p, 3.0 + 1.5 * sin(clock * 1.5 + i + j), Color(0.55, 0.94, 1, 0.15))
	_draw_equation()
	if solved:
		_draw_success()
	elif hint_step >= 2:
		if int(exercise["level"]) == 2:
			_draw_fraction_visual()
		elif int(exercise["level"]) == 1:
			_draw_group_visual()
		else:
			_draw_number_visual()
	else:
		_draw_neural_placeholder()

func _center_text(text: String, center: Vector2, font_size: int, color: Color = WHITE) -> void:
	var font := ThemeDB.fallback_font
	var width := font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
	draw_string(font, center - Vector2(width * 0.5, -font_size * 0.34), text, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size, color)

func _panel(rect: Rect2, background: Color, radius: int = 14, border: Color = DULL) -> void:
	var sb := StyleBoxFlat.new()
	sb.bg_color = background
	sb.set_corner_radius_all(radius)
	sb.border_color = border
	sb.set_border_width_all(2)
	draw_style_box(sb, rect)

func _draw_equation() -> void:
	var w := size.x
	var centers := [w * 0.16, w * 0.49, w * 0.83]
	var q_level := int(exercise["level"])
	var sign := str(exercise["op"])
	for idx in range(3):
		var cx: float = centers[idx]
		var is_question := int(exercise["missing"]) == idx
		var box_col := Color("#122e49") if not is_question else Color("#1a395a")
		_panel(Rect2(cx - 85, 58, 170, 142), box_col, 20, Color("#42708f") if not is_question else GOLD)
		var value = exercise[["a", "b", "c"][idx]]
		var marker: String = "?" if is_question else str(value)
		if q_level < 2:
			_center_text(marker, Vector2(cx, 123), 74, GOLD if is_question else WHITE)
		else:
			_center_text(marker, Vector2(cx, 96), 45, GOLD if is_question else WHITE)
			draw_line(Vector2(cx - 45, 132), Vector2(cx + 45, 132), CYAN if not is_question else GOLD, 4.0, true)
			_center_text(str(exercise["den"]), Vector2(cx, 160), 43, WHITE)
		if is_question:
			var pulse := 0.65 + 0.35 * sin(clock * 2.2)
			draw_arc(Vector2(cx, 123), 78.0, 0, TAU, 64, Color(1, 0.81, 0.50, pulse * 0.32), 2)
	_center_text(sign, Vector2((centers[0] + centers[1]) * 0.5, 124), 44, MINT)
	_center_text("=", Vector2((centers[1] + centers[2]) * 0.5, 124), 44, MINT)

func _draw_neural_placeholder() -> void:
	var center := Vector2(size.x * .5, 264)
	for i in range(6):
		var angle := TAU * float(i) / 6.0 + clock * .08
		var p := center + Vector2.from_angle(angle) * 77
		draw_line(center, p, Color(0.55, 0.81, 1.0, 0.20), 2)
		draw_circle(p, 7.0, Color(0.46, 0.79, 1.0, 0.55))
		draw_circle(p, 3.0, WHITE)
	draw_circle(center, 31, Color(0.22,0.56,0.80,0.18))
	_center_text("?", center + Vector2(0, 1), 41, GOLD)

func _draw_dots(count: int, center: Vector2, color: Color, outlined: bool = false, col_count: int = 10) -> void:
	var n: int = clampi(count, 0, 25)
	if n == 0:
		return
	var cols: int = mini(n, col_count)
	var gap := 24.0
	var start := center.x - (cols - 1) * gap * 0.5
	for i in range(n):
		var pos := Vector2(start + (i % col_count) * gap, center.y + float(i / col_count) * 25.0)
		if outlined:
			draw_arc(pos, 8.5, 0, TAU, 24, color, 2.3)
		else:
			draw_circle(pos, 10.0, Color(color.r,color.g,color.b,.14))
			draw_circle(pos, 6.3, color)

func _draw_number_visual() -> void:
	var op := str(exercise["op"])
	var a = exercise["a"]
	var b = exercise["b"]
	var c = exercise["c"]
	var missing := int(exercise["missing"])
	var answer := int(exercise["answer"])
	_panel(Rect2(94, 226, size.x - 188, 92), Color("#0c273b"), 17, Color("#276b7d"))
	if op == "+":
		var left := int(a) if a != null else answer
		var right := int(b) if b != null else answer
		if missing == 0 or missing == 1:
			var known := right if missing == 0 else left
			_center_text(str(known), Vector2(160, 246), 20, CYAN)
			_draw_dots(known, Vector2(240, 276), CYAN, false, 10)
			_center_text("+", Vector2(size.x * 0.5, 266), 34, WHITE)
			_draw_dots(answer, Vector2(600, 276), GOLD, hint_step < 3, 10)
		else:
			_draw_dots(left, Vector2(265, 267), CYAN)
			_center_text("+", Vector2(size.x * .5, 266), 31, WHITE)
			_draw_dots(right, Vector2(580, 267), MINT)
	else:
		var start_count := int(a) if a != null else answer
		var remaining := int(c) if c != null else answer
		var taken := int(b) if b != null else answer
		_center_text("−", Vector2(size.x * .5, 269), 28, GOLD)
		_draw_dots(start_count if start_count > 0 else remaining + taken, Vector2(266, 266), CYAN, false, 10)
		_draw_dots(remaining, Vector2(578, 266), MINT, false, 10)
		if hint_step >= 3:
			_draw_dots(taken, Vector2(578, 299), GOLD, true, 10)

func _draw_group_visual() -> void:
	var op := str(exercise["op"])
	var answer := int(exercise["answer"])
	var missing := int(exercise["missing"])
	var a := int(exercise["a"]) if exercise["a"] != null else answer
	var b := int(exercise["b"]) if exercise["b"] != null else answer
	var c := int(exercise["c"]) if exercise["c"] != null else answer
	var group_count := a if op == "×" else (c if missing == 1 else b)
	var in_group := b if op == "×" else (b if missing == 1 else c)
	group_count = clampi(group_count,1,6)
	in_group = clampi(in_group,1,6)
	# Groups remain graphic clues rather than prefilled results.
	var cell_w: float = minf(112.0, 620.0 / float(group_count))
	var left := (size.x - cell_w * float(group_count)) * 0.5
	for gi in range(group_count):
		var rect := Rect2(left + float(gi) * cell_w + 4, 229, cell_w - 8, 80)
		_panel(rect, Color("#102b43"), 14, Color("#347f8f"))
		var n: int = in_group if hint_step >= 3 or missing != 2 else mini(in_group, 3)
		for k in range(n):
			var cols: int = mini(3, n)
			var dx := float(k % cols) * 18 - float(cols - 1) * 9
			var dy := float(k / cols) * 16 - 6
			draw_circle(rect.get_center() + Vector2(dx,dy), 5.4, MINT if gi % 2 == 0 else CYAN)

func _draw_fraction_visual() -> void:
	var denom := int(exercise["den"])
	var missing := int(exercise["missing"])
	var a := int(exercise["a"]) if exercise["a"] != null else int(exercise["answer"])
	var b := int(exercise["b"]) if exercise["b"] != null else int(exercise["answer"])
	var c := int(exercise["c"]) if exercise["c"] != null else int(exercise["answer"])
	var vals := [a,b,c]
	var positions := [size.x * .16, size.x * .49, size.x * .83]
	for i in range(3):
		var x: float = positions[i]
		var w := 150.0
		var segment := w / float(denom)
		for k in range(denom):
			var rect := Rect2(x - w * .5 + k * segment + 2, 243, segment - 4, 55)
			var filled := k < int(vals[i])
			var color := (GOLD if i == missing else MINT) if filled else Color("#19354b")
			if i == missing and hint_step < 3:
				color = Color("#19354b")
			_panel(rect, color, 6, Color("#3f7890"))
			if i == missing and hint_step == 2 and k < int(vals[i]):
				draw_line(rect.position + Vector2(3,3), rect.end - Vector2(3,3), Color(1, .85, .54, .28), 1.5)
	_center_text(str(denom), Vector2(x, 315), 17, Color("#83b8d6"))

func _draw_success() -> void:
	var p := Vector2(size.x * .5, 264)
	for i in range(10):
		var angle := float(i) / 10 * TAU + clock * .34
		var offset := Vector2.from_angle(angle) * (35 + 7 * sin(clock * 2.2))
		draw_circle(p + offset, 5.5, MINT if i % 2 == 0 else GOLD)
	draw_line(p + Vector2(-18, 0), p + Vector2(-4, 15), MINT, 8, true)
	draw_line(p + Vector2(-4, 15), p + Vector2(23, -18), MINT, 8, true)
