extends Node2D
class_name MikoPlanet2D
## Reusable 2D globe for Earth and other equirectangular planet textures.
## Put planet2d/ in res://planet2d/ and instantiate planet_2d.tscn.

const PLANET_SHADER: Shader = preload("res://planet2d/shaders/planet_globe.gdshader")
const QUAD_SIZE := 512.0
const DISC_FRACTION := 0.84 # shader globe diameter as fraction of quad width

@export_range(24.0, 900.0, 1.0, "suffix:px") var diameter_pixels := 380.0
@export_range(1.0, 600.0, 0.5, "suffix:s") var rotation_period_seconds := 42.0
@export_range(-180.0, 180.0, 0.1) var axial_tilt_degrees := 23.4
@export_range(-180.0, 180.0, 1.0) var start_longitude_degrees := 0.0
@export var light_direction := Vector3(-0.65, 0.22, 0.73)
@export var surface_texture: Texture2D = preload("res://planet2d/textures/earth_surface.jpg")
@export var clouds_texture: Texture2D = preload("res://planet2d/textures/earth_clouds_procedural.png")
@export var night_texture: Texture2D = preload("res://planet2d/textures/earth_night_lights_procedural.png")
@export var clouds_enabled := true
@export var night_lights_enabled := true
@export_range(0.0, 2.0, 0.05) var cloud_opacity := 0.95
@export_range(0.0, 2.0, 0.05) var atmosphere_strength := 0.80
@export_range(0.0, 1.0, 0.01) var ambient_strength := 0.09
@export_range(0.0, 6.0, 0.1) var night_lights_strength := 3.0
@export_range(0.0, 3.0, 0.01) var clouds_rotation_multiplier := 1.05
@export var paused := false

@onready var _globe: Sprite2D = $Globe
var _material: ShaderMaterial
var _surface_phase := 0.0
var _cloud_phase := 0.0

func _ready() -> void:
    # Each instance owns its own ShaderMaterial; several planets can rotate independently.
    _material = ShaderMaterial.new()
    _material.shader = PLANET_SHADER
    _globe.material = _material
    _surface_phase = deg_to_rad(start_longitude_degrees)
    _cloud_phase = _surface_phase
    _sync_all_parameters()
    _sync_size()
    set_process(true)

func _process(delta: float) -> void:
    if paused:
        return
    var increment := TAU * delta / max(rotation_period_seconds, 0.001)
    _surface_phase = wrapf(_surface_phase + increment, 0.0, TAU)
    _cloud_phase = wrapf(_cloud_phase + increment * clouds_rotation_multiplier, 0.0, TAU)
    _material.set_shader_parameter("surface_phase", _surface_phase)
    _material.set_shader_parameter("clouds_phase", _cloud_phase)

func _sync_size() -> void:
    if is_instance_valid(_globe):
        _globe.scale = Vector2.ONE * diameter_pixels / (QUAD_SIZE * DISC_FRACTION)

func _sync_all_parameters() -> void:
    _material.set_shader_parameter("surface_map", surface_texture)
    _material.set_shader_parameter("clouds_map", clouds_texture)
    _material.set_shader_parameter("night_map", night_texture)
    _material.set_shader_parameter("surface_phase", _surface_phase)
    _material.set_shader_parameter("clouds_phase", _cloud_phase)
    _material.set_shader_parameter("axial_tilt", deg_to_rad(axial_tilt_degrees))
    _material.set_shader_parameter("light_direction", light_direction.normalized())
    _material.set_shader_parameter("show_clouds", clouds_enabled)
    _material.set_shader_parameter("show_night_lights", night_lights_enabled)
    _material.set_shader_parameter("cloud_opacity", cloud_opacity)
    _material.set_shader_parameter("atmosphere_strength", atmosphere_strength)
    _material.set_shader_parameter("ambient_strength", ambient_strength)
    _material.set_shader_parameter("night_lights_strength", night_lights_strength)

## Useful runtime controls for an eventual Godot game integration.
func set_planet_diameter(value: float) -> void:
    diameter_pixels = max(1.0, value)
    _sync_size()

func set_rotation_period(value: float) -> void:
    rotation_period_seconds = max(0.01, value)

func set_rotation_phase(degrees: float) -> void:
    _surface_phase = deg_to_rad(degrees)
    _cloud_phase = _surface_phase
    if _material != null:
        _material.set_shader_parameter("surface_phase", _surface_phase)
        _material.set_shader_parameter("clouds_phase", _cloud_phase)

func set_sun_direction(direction: Vector3) -> void:
    light_direction = direction.normalized() if direction.length_squared() > 0.0 else Vector3(0, 0, 1)
    if _material != null:
        _material.set_shader_parameter("light_direction", light_direction)

func set_clouds_enabled(enabled: bool) -> void:
    clouds_enabled = enabled
    if _material != null:
        _material.set_shader_parameter("show_clouds", enabled)

func set_night_lights_enabled(enabled: bool) -> void:
    night_lights_enabled = enabled
    if _material != null:
        _material.set_shader_parameter("show_night_lights", enabled)

func set_atmosphere(value: float) -> void:
    atmosphere_strength = maxf(value, 0.0)
    if _material != null:
        _material.set_shader_parameter("atmosphere_strength", atmosphere_strength)

func set_surface_map(tex: Texture2D) -> void:
    surface_texture = tex
    if _material != null:
        _material.set_shader_parameter("surface_map", tex)

func set_cloud_map(tex: Texture2D) -> void:
    clouds_texture = tex
    if _material != null:
        _material.set_shader_parameter("clouds_map", tex)

func set_night_map(tex: Texture2D) -> void:
    night_texture = tex
    if _material != null:
        _material.set_shader_parameter("night_map", tex)
