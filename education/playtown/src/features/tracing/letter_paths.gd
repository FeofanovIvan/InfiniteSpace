			strokes.append([Vector2(0.38, 0.12), Vector2(0.62, 0.01)])
		elif grave.has(letter):
			strokes.append([Vector2(0.38, 0.01), Vector2(0.62, 0.12)])
		elif circumflex.has(letter):
			strokes.append([Vector2(0.27, 0.12), Vector2(0.50, 0.01), Vector2(0.73, 0.12)])
		elif tilde.has(letter):
			strokes.append([
				Vector2(0.22, 0.09), Vector2(0.34, 0.03),
				Vector2(0.48, 0.08), Vector2(0.63, 0.03), Vector2(0.78, 0.08),
			])
		elif diaeresis.has(letter):
			strokes.append([Vector2(0.29, 0.055), Vector2(0.37, 0.055)])
			strokes.append([Vector2(0.63, 0.055), Vector2(0.71, 0.055)])
		return strokes
	match letter:
		"Æ":
			return [
				[Vector2(0.04, 0.98), Vector2(0.28, 0.02), Vector2(0.52, 0.98)],
				[Vector2(0.13, 0.58), Vector2(0.53, 0.58)],
