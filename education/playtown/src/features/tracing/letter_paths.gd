static func _transform_strokes(source: Array, y_offset: float, y_scale: float) -> Array:
	var transformed: Array = []
	for source_stroke in source:
		var stroke: Array = []
		for point in source_stroke:
			stroke.append(Vector2(point.x, y_offset + point.y * y_scale))
		transformed.append(stroke)
	return transformed


